BDOS:	EQU	0005H
	ORG	100H
	LXI H,TEXT
	CALL PMSG
	HLT
	JMP 0

; OUTPUT ONE CHARACTER VIA BDOS CALL
OUTPUT:	MOV E,A
	MVI C,02H
	JMP BDOS

; PRINT MESSAGE ENDED BY 00H
; HL CONTAINS ADDRESS OF THE MESSAGE
PMSG:	MOV A,M
	ORA A
	RZ
	INX H
	PUSH H
	CALL OUTPUT
	POP H
	JMP PMSG
TEXT:	DB 	'SYSTEM HALTED',0DH,0AH,0
	END
