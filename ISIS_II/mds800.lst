		; combined Boot and Monitor ROM code for MDS-800
		
		; ASCII characters
0000          	NIL	equ	0
0003          	CTRL$C	equ	3
000D          	CR	equ	13
000A          	LF	equ	10
		
00C7          	RST0	equ	0c7h	; RST 0 instruction for breakpoints
		
0000          	pgexit	equ	0000h
0003          	iobyte	equ	0003h	; current iobyte
0004          	ramtop	equ	0004h	; low byte = PROM data XOR mask, high byte = top RAM page
0006          	iobyte2	equ	0006h	; iobyte as probed by BOOT ROM
3000          	bootbuf	equ	3000h	; assume at least 16K
		
		; I/O ports
0078          	dstat	equ	078h	; read - bit0: device present, bit2: ready
0079          	diopbl	equ	079h	; write - iopb low
007A          	diopch	equ	07ah	; write - iopb high
0079          	drtype	equ	079h	; read - result type
007B          	drbyte	equ	07bh	; read - result byte
007F          	dreset	equ	07fh	; write - reset controller
		
0004          	dcread	equ	4	; disk ctrl READ command
0006          	dcwrit	equ	6	; WRITE command
0003          	dchome	equ	3	; seek track 0
		
0001          	dcredy	equ	0001b	; dstat floppy ready
0004          	dcfini	equ	0100b	; dstat I/O finished
		
00F0          	promda	equ	0f0h	; write starts programming, read either uses /WAIT
					; or sets "start read" and polls promst for !uppbsy.
					; Monitor depends on /WAIT.
00F1          	promah	equ	0f1h	; write (ah+ctrl bits) direct to programmer
00F1          	promst	equ	0f1h	; read - direct from programmer
00F2          	promal	equ	0f2h	; write - direct to programmer
00F3          	intctl	equ	0f3h	; write - bit 7 enables TTY/CRT/PTP/PTR/LPT intrs
					;	  6:0 reset intr sources, see intsts
		; promst
0080          	uppori	equ	10000000b	; orientation error
0040          	uppbrd	equ	01000000b	; board sense error
0020          	upphwe	equ	00100000b	; hardware error
0010          	uppadr	equ	00010000b	; address error
0008          	upppgm	equ	00001000b	; programming error
0004          	uppftp	equ	00000100b	; failed to program
0002          	uppok	equ	00000010b	; operation complete verified
0001          	uppbsy	equ	00000001b	; busy
		; promah - CRSNAAAA
		;	C = Control #1 (0)
		;	R = start Read
		;	S = Socket select (1=#1, 0=#2)
		;	N = Nibble select (1=high)
		;	A = Addr 11:8
		; promal - AAAAAAAA
		;	A = Addr 7:0
		
		; values for promah:
0FFF          	promam	equ	0fffh	; PROM address mask - 4K max
00FF          	promsX	equ	00ffh	; socket X (low byte unused?) C=0, R=0, S=0, N=0 (8-bit?)
30F0          	promsY	equ	30f0h	; socket Y (low byte unused?) C=0, R=0, S=1, N=1
200F          	promsZ	equ	200fh	; socket Z (low byte unused?) C=0, R=0, S=1, N=0
		; intctl:
0080          	chrie	equ	10000000b	; enable all char I/O interrupts
		
00F4          	ttydat	equ	0f4h	; TTY: data
00F5          	ttysts	equ	0f5h	; read
00F5          	ttyctl	equ	0f5h	; write
00F6          	crtdat	equ	0f6h	; CRT: data
00F7          	crtsts	equ	0f7h	; read
00F7          	crtctl	equ	0f7h	; write
		
00F8          	ptdat	equ	0f8h	; read PTR, write PTP
00F9          	ptsts	equ	0f9h	; read - PTR/P status
00F9          	ptctl	equ	0f9h	; write - PTR/P control
00FA          	intsts	equ	0fah	; read - TTY/CRT/PTP/PTR/LPT intr status
00FA          	lptdat	equ	0fah	; write - LPT data out - inverted
00FB          	lptsts	equ	0fbh	; read - LPT status
00FB          	lptctl	equ	0fbh	; write - LPT control
		; ptsts:
0001          	ptrrdy	equ	00000001b	; PTR data ready
0002          	ptrsys	equ	00000010b	; PTR system ready
0004          	ptprdy	equ	00000100b	; PTP ready for data
0008          	ptpsys	equ	00001000b	; PTP system ready
0010          	ptpchd	equ	00010000b	; PTP chad error
0020          	ptplow	equ	00100000b	; PTP tape low
		; ptctl:
0002          	ttyadv	equ	00000010b	; TTY strobe reader one char
0004          	ptrdir	equ	00000100b	; PTR direction?
0008          	ptrdrv	equ	00001000b	; PTR strobe reader one char
0010          	ptpfor	equ	00010000b	; PTP forward? (direction?)
0020          	ptpadv	equ	00100000b	; PTP punch one char
		; lptsts:
0001          	lptbsy	equ	00000001b	; LPT busy (data) - active low
0002          	lptstt	equ	00000010b	; LPT stat? error/ready?
		
		;intsts and intctl:
0001          	ttyoi	equ	00000001b
0002          	ttyii	equ	00000010b
0004          	ptpoi	equ	00000100b
0008          	ptrii	equ	00001000b
0010          	crtoi	equ	00010000b
0020          	crtii	equ	00100000b
0040          	lptoi	equ	01000000b
		
00FC          	imask	equ	0fch	; i8259 intr masks
00FD          	rstint	equ	0fdh	; i8259 control/command
		
0001          	im0	equ	00000001b
0002          	im1	equ	00000010b
0004          	im2	equ	00000100b
0008          	im3	equ	00001000b
0010          	im4	equ	00010000b
0020          	im5	equ	00100000b
0040          	im6	equ	01000000b
0080          	im7	equ	10000000b
00FE          	im1$7	equ	im1+im2+im3+im4+im5+im6+im7
		
00FF          	fpsw	equ	0ffh	; read - front panel switches and state
0001          	fp1ms	equ	0001b	; 1mS clock?
0002          	bsw	equ	0010b	; BOOT switch
		
		; Appears to have a sophisticated priority interrupt controller,
		; (i3214) and interrupt stack (i3101A 16x4 RAM and 74191 stack ptr).
		
		;     |      BOOT switch      |
		;     |    OFF    |    ON     |
		; ----+-----------+-----------+
		; 0000|           | Bootstrap |
		;     |           |    ROM    |
		; ----+           +-----------+
		; 0100|                       |
		;     |          RAM          |
		;     ~       (ex: 16K)       ~
		;     |                       |
		; 3EFF|   (end of user RAM)   | (default user stack)
		; ----+ - - - - - - - - - - - +
		; 3F00|       Monitor         |
		;     |       Reserved        |
		; 3FFF|         Page          | (max phys RAM addr)
		; ----+-----------------------+
		;     :\ \ \ \ \ \ \ \ \ \ \ \:
		;     : \ \ \ \(empty)\ \ \ \ :
		;     :\ \ \ \ \ \ \ \ \ \ \ \:
		; ----+-----------------------+
		; F800|                       |
		;     |        Monitor        |
		;     |          ROM          |
		; FFFF|                       |
		; ----+-----------------------+
		;
		; Page 0 (always writeable):
		; 0000: JMP breakpoint	; exit from user program
		; 0003: DB iobyte	; device assignments
		; 0004: DW RAMend	; last byte of user memory
		; 0008: RST 1 ...
		; 0040: free...
		
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		; Bootstrap ROM
		; 256 byte i1702 EPROM at A36 on F.P. Ctrl PCB.
		; Overrides RAM reads (only) when BOOT switch is ON.
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		
0000          		org	0000h
0000  C30600  		jmp	L0006		;; 0000: c3 06 00    ...
		
		; overlays iobyte for reads
0003  00      	L0003:	db	00000000b	; default iobyte
		
0004  0915    		db	9,21		; datestamp, MM,DD
		
0006  F3      	L0006:	di			;; 0006: f3          .
0007  3E12    		mvi	a,012h	; ICW1: init i8259, SINGLE, vectors in xx00H
0009  D3FD    		out	rstint		;; 0009: d3 fd       ..
000B  AF      		xra	a		;; 000b: af          .
000C  AF      		xra	a	; ICW2: vectors in 00xxH
000D  D3FC    		out	imask		;; 000d: d3 fc       ..
000F  3EFE    		mvi	a,im1$7	; OCW1: intr masks
0011  D3FC    		out	imask		;; 0011: d3 fc       ..
0013  3E00    		mvi	a,0		;; 0013: 3e 00       >.
0015  D3F3    		out	intctl	; /INT3 off
		; look for end of RAM, starting with 0100h
0017  210000  		lxi	h,0000h		;; 0017: 21 00 00    ...
		; As we have 64KB of ram and monitor and bootloader are loaded we have to skip
		; memory chaeck and specify ramtop as 0f7ff directly here. If original RAM test
		; is needed remove the following instruction and uncomment the code below.
		;	lxi	h,0f800h	;; Start address of monitor
001A  24      	L001a:	inr	h		;; 001a: 24          $
001B  7E      		mov	a,m		;; 001b: 7e          ~
001C  2F      		cma			;; 001c: 2f          /
001D  77      		mov	m,a		;; 001d: 77          w
001E  BE      		cmp	m		;; 001e: be          .
001F  2F      		cma			;; 001f: 2f          /
0020  77      		mov	m,a		;; 0020: 77          w
0021  CA1A00  		jz	L001a		;; 0021: ca 1a 00    ...
0024  2B      		dcx	h		;; 0024: 2b          +
0025  220400  		shld	ramtop		;; 0025: 22 04 00    "..
		; copy savDE-L00ff to high memory page (xxC8H)
0028  01C800  		lxi	b,savDE		;; 0028: 01 c8 00    ...
002B  69      		mov	l,c		;; 002b: 69          i
002C  F9      		sphl			;; 002c: f9          .
002D  0A      	L002d:	ldax	b		;; 002d: 0a          .
002E  77      		mov	m,a		;; 002e: 77          w
002F  0C      		inr	c		;; 002f: 0c          .
0030  2C      		inr	l		;; 0030: 2c          ,
0031  C22D00  		jnz	L002d		;; 0031: c2 2d 00    .-.
		; HL = top page of RAM
0034  2ED1    		mvi	l,LOW savSP+1	;; 0034: 2e d1       ..
0036  74      		mov	m,h		;; 0036: 74          t
0037  35      		dcr	m	; save very top page for monitor
0038  3EC3    		mvi	a,JMP		;; 0038: 3e c3       >.
		; during BOOT, RAM is written while ROM is read
003A  320000  		sta	pgexit		;; 003a: 32 00 00    2..
003D  2111FF  		lxi	h,pgmxit	;; 003d: 21 0f ff    ...
0040  220100  		shld	pgexit+1	;; 0040: 22 01 00    "..
0043  3E4F    		mvi	a,04fh	; 1 stop, np, 8 data, 64x
0045  D3F7    		out	crtctl		;; 0045: d3 f7       ..
0047  3ECE    		mvi	a,0ceh	; 2 stop, np, 8 data, 16x
0049  D3F5    		out	ttyctl		;; 0049: d3 f5       ..
004B  3E27    		mvi	a,027h	; RTS, RxEn, DTR, TxEn
004D  D3F7    		out	crtctl		;; 004d: d3 f7       ..
004F  D3F5    		out	ttyctl		;; 004f: d3 f5       ..
0051  AF      		xra	a		;; 0051: af          .
0052  D3F9    		out	ptctl		;; 0052: d3 f9       ..
			; check floppy inserted?
0054  DB78    		in	dstat		;; 0054: db 78       .x
0056  0F      		rrc		; CY = dcredy
0057  D26800  		jnc	L0068		;; 0057: d2 68 00    .h.
			; floppy is inserted - boot it
005A  3EAA    		mvi	a,LOW iopb
005C  D379    		out	diopbl		;; 005c: d3 79       .y
005E  AF      		xra	a	; HIGH iopb
005F  D37A    		out	diopch		;; 005f: d3 7a       .z
			; wait for disk command finished
0061  DB78    	L0061:	in	dstat		;; 0061: db 78       .x
0063  E604    		ani	dcfini
0065  CA6100  		jz	L0061		;; 0065: ca 61 00    .a.
		
		; alternately poll CRT and TTY for input.
		; must see the blank-space character.
0068  210300  	L0068:	lxi	h,iobyte	; reads access L0003
006B  56      		mov	d,m		;; 006b: 56          V
006C  DBF5    		in	ttysts		;; 006c: db f5       ..
006E  E602    		ani	002h		;; 006e: e6 02       ..
0070  CA7800  		jz	L0078		;; 0070: ca 78 00    .x.
0073  DBF4    		in	ttydat		;; 0073: db f4       ..
0075  C38200  		jmp	L0082		;; 0075: c3 82 00    ...
		
0078  14      	L0078:	inr	d		;; 0078: 14          .
0079  DBF7    		in	crtsts		;; 0079: db f7       ..
007B  E602    		ani	002h		;; 007b: e6 02       ..
007D  CA6800  		jz	L0068		;; 007d: ca 68 00    .h.
0080  DBF6    		in	crtdat		;; 0080: db f6       ..
0082  E67F    	L0082:	ani	07fh		;; 0082: e6 7f       ..
0084  FE20    		cpi	' '		;; 0084: fe 20       .
0086  C26800  		jnz	L0068		;; 0086: c2 68 00    .h.
			; found console, D is iobyte
0089  72      		mov	m,d	; save iobyte in RAM
008A  2E06    		mvi	l,LOW iobyte2	;; 008a: 2e 06       ..
008C  72      		mov	m,d	; also save in L0006???
			; alternate monitor? based on port 78 bit 0...
008D  DB78    		in	dstat		;; 008d: db 78       .x
008F  0F      		rrc	; CY = dcredy
0090  DA0030  		jc	bootbuf		;; 0090: da 00 30    ..0
		
		; print 'MDS MONITOR, V2.0' to CON:
0093  2EB1    		mvi	l,LOW L00b1
0095  0615    		mvi	b,Z00b1		;; 0095: 06 15       ..
0097  4E      	L0097:	mov	c,m		;; 0097: 4e          N
0098  7A      		mov	a,d		;; 0098: 7a          z
0099  0F      		rrc			;; 0099: 0f          .
009A  D427FD  		cnc	ttyout
009D  7A      		mov	a,d		;; 009d: 7a          z
009E  0F      		rrc			;; 009e: 0f          .
009F  DC3EFD  		cc	crtout
00A2  23      		inx	h		;; 00a2: 23          #
00A3  05      		dcr	b		;; 00a3: 05          .
00A4  C29700  		jnz	L0097		;; 00a4: c2 97 00    ...
00A7  C300F8  		jmp	coldsf
		
		; floppy boot iopb
00AA  80      	iopb:	db	80h	; iocw: no update
00AB  04      		db	dcread	; floppy READ command
00AC  1A      		db	26	; number of sectors to read (?)
00AD  00      		db	0	; track 0
00AE  01      		db	1	; sector 1 (first)
00AF  0030    		dw	bootbuf	; DMA addr
		
00B1  0D0A4D44	L00b1:	db	CR,LF,'MDS MONITOR, V2.0'
      53204D4F
      4E49544F
      522C2056
      322E30
00C4  0D0A    		db	CR,LF
0015          	Z00b1	equ	$-L00b1
		
00C6  4F3E    	L00c6:	db	4fh,3eh	; 'O>' or L3e4f or 79,62 or DS 2
		
		;------------------------------------------------------
		; Template for monitor area of RAM.
		; copied into high RAM page - xxC8H - also top of stack
		;
		monstk:	ds	0	; stop of stack for monitor
00C0          	usrtop	equ	monstk-8	; monstk - 264
		
00C8  EEDD    	savDE:	dw	0ddeeh	; saved DE
00CA  CCBB    	savBC:	dw	0bbcch	; saved BC
00CC  00FE    	savIM:	dw	0fe00h	; saved port FC
00CE  FFAA    	savPSW:	dw	0aaffh	; saved PSW
00D0  C000    	savSP:	dw	usrtop	; saved SP (modified for RAM size)
000A          	savlen	equ	$-savDE
		
		; routine to resume user code
00D2  F3      	resume:	di			;; 00d2: f3          .
00D3  D1      		pop	d		;; 00d3: d1          .
00D4  C1      		pop	b		;; 00d4: c1          .
00D5  F1      		pop	psw		;; 00d5: f1          .
00D6  D3FC    		out	imask		;; 00d6: d3 fc       ..
00D8  F1      		pop	psw		;; 00d8: f1          .
00D9  E1      		pop	h		;; 00d9: e1          .
00DA  F9      		sphl			;; 00da: f9          .
00DB  213412  	lxiHL:	lxi	h,01234h	; filled with saved HL
00DE  FB      		ei			;; 00de: fb          .
00DF  C38967  	jmpPC:	jmp	06789h		; filled with resume/GO addr (PC)
		
00E2  0000    	brkpts:	dw	0	; breakpoint addr #1
00E4  00      		db	0	; saved byte for bp#1
00E5  0000    		dw	0	; breakpoint addr #2
00E7  00      		db	0	; saved byte for bp#2
		
		; user-defined device driver hooks
00E8  C30000  	uc1in:	jmp	pgexit		;; 00e8: c3 00 00    ...
00EB  C30000  	uc1out:	jmp	pgexit		;; 00eb: c3 00 00    ...
00EE  C30000  	ur1in:	jmp	pgexit		;; 00ee: c3 00 00    ...
00F1  C30000  	ur2in:	jmp	pgexit		;; 00f1: c3 00 00    ...
00F4  C30000  	up1out:	jmp	pgexit		;; 00f4: c3 00 00    ...
00F7  C30000  	up2out:	jmp	pgexit		;; 00f7: c3 00 00    ...
00FA  C30000  	ul1out:	jmp	pgexit		;; 00fa: c3 00 00    ...
00FD  C30000  	uc1sts:	jmp	pgexit		;; 00fd: c3 00 00    ...
		
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
		; Monitor ROM
		; 2K byte 8316 MROM at A7 on Monitor PCB.
		;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
F800          		org	0f800h
		
F800  C330F8  	coldsf:	jmp	colds		;; f800: c3 30 f8    .0.
F803  C387FC  		jmp	conin		;; f803: conin
F806  C3BAFC  		jmp	rdrin		;; f806: rdrin
F809  C31FFD  		jmp	conout		;; f809: conout
F80C  C354FD  		jmp	punout		;; f80c: punout
F80F  C386FD  		jmp	lstout		;; f80f: lstout
F812  C3A6FD  		jmp	consts		;; f812: consts
F815  C3CDFD  		jmp	Lfdcb		;; f815: chkcfg - get iobyte
F818  C3D1FD  		jmp	Lfdcf		;; f818: setcfg - set iobyte
F81B  C3D6FD  		jmp	Lfdd4		;; f81b: ramsiz - 16K: B=3EH, A=0C0H
F81E  C3DEFD  		jmp	Lfddc		;; f81e: iodef - define usr i/o - C=fnc vec, DE=rtn
F821  C3C8FF  		jmp	Lffc6		;; f821: nop - imm return
		
F824  0915    		db	9,21	; date code, MM,DD
		
F826  2A0400  	abort:	lhld	ramtop		;; f826: 2a 04 00    *..
F829  2EC8    		mvi	l,LOW monstk	;; f829: 2e c8       ..
F82B  F9      		sphl			;; f82b: f9          .
F82C  CD49FD  		call	conimm		;; f82c: cd 47 fd    .G.
F82F  23      		db	'#'
		; cold start (RESET)
F830  DBFF    	colds:	in	fpsw		;; f830: db ff       ..
F832  E602    		ani	bsw		;; f832: e6 02       ..
F834  E600    		ani	0		;; don't wait on boot switch
F836  C230F8  		jnz	colds	; wait for BOOT switch to be turned OFF
F839  FB      		ei			;; f837: fb          .
F83A  CD1AFE  		call	coneol		;; f838: cd 18 fe    ...
F83D  CD49FD  		call	conimm		;; f83b: cd 47 fd    .G.
F840  2E      		db	'.'
F841  CDC9FF  		call	echin		;; f83f: cd c7 ff    ...
F844  D641    		sui	'A'		;; f842: d6 41       .A
F846  FA30F8  		jm	colds		;; f844: fa 30 f8    .0.
F849  0E02    		mvi	c,2	; default to 2 params?
F84B  1130F8  		lxi	d,colds		;; f849: 11 30 f8    .0.
F84E  D5      		push	d		;; f84c: d5          .
F84F  2161F8  		lxi	h,cmdtab	;; f84d: 21 5f f8    ._.
F852  FE18    		cpi	'X'-'A'+1	;; f850: fe 18       ..
F854  F226F8  		jp	abort		;; f852: f2 26 f8    .&.
F857  5F      		mov	e,a		;; f855: 5f          _
F858  1600    		mvi	d,0		;; f856: 16 00       ..
F85A  19      		dad	d		;; f858: 19          .
F85B  19      		dad	d		;; f859: 19          .
F85C  7E      		mov	a,m		;; f85a: 7e          ~
F85D  23      		inx	h		;; f85b: 23          #
F85E  66      		mov	h,m		;; f85c: 66          f
F85F  6F      		mov	l,a		;; f85d: 6f          o
F860  E9      		pchl			;; f85e: e9          .
		
F861  91F8    	cmdtab:	dw	Acmd	; A (Assign) <ldev>=<pdev> [see ldevtb]
F863  0EF9    		dw	Bcmd	; B (BNPF punch) <low-adr>,<high-adr>
F865  47F9    		dw	Ccmd	; C (Compare PROM) <T/F><socket><low-adr>,<high-adr>
F867  92F9    		dw	Dcmd	; D (Display mem) <low-adr>,<high-adr>
F869  BEF9    		dw	Ecmd	; E (HEX EOF to PUN:) <entry-adr> [after W command(s)]
F86B  DCF9    		dw	Fcmd	; F (Fill mem) <low-adr>,<high-adr>,<byte>
F86D  EBF9    		dw	Gcmd	; G (Go/exec) <addr>,<bp-1>,<bp-2>
F86F  34FA    		dw	Hcmd	; H (Hex math) <num-1>,<num-2>
F871  26F8    		dw	abort	; I (invalid)
F873  26F8    		dw	abort	; J (invalid)
F875  26F8    		dw	abort	; K (invalid)
F877  4FFA    		dw	Lcmd	; L (Load BNPF) <low-adr>,<high-adr>
