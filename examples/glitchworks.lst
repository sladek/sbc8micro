                          378 | ;Monitor Strings
                          379 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
11C4: 0D 0A 0A 47 57...   380 | LOGMSG@: db 13, 10, 10, 'GWMON-80 0.1.4 for 8080/8085/Z80 and Compatible', 13, 10
11F8: 43 6F 70 79 72...   381 |          db 'Copyright (c) 2019 The Glitch Works', 0
121C: 0D 0A 0A 3E 00      382 | PROMPT@: db 13, 10, 10, '>', 0
1221: 43 48 45 43 4B...   383 | CSERR@:  db 'CHECKSUM '
122A: 45 52 52 4F 52 00   384 | ERR@:    db 'ERROR', 0
1230: 0D 0A 00            385 | CRLF@:   db 13, 10, 0
                          386 | ;Glitch Works Monitor I/O Module for Intel 8251 UART
                          387 | 
                          388 | ;Adjust CTLPRT and DATPRT for your specific hardware.
                          389 | ;Stack Pointer initialized at 0xFFFF, adjust as needed.
                          390 | ;
                          391 | ;After including this module, you still need to
                          392 | ;set the ORG in the main monitor source.


Assembly Listing                                                                                                 Page: 8
------------------------------------------------------------------------------------------------------------------------

                          393 | 
                          394 | CTLPRT  equ 41H
                          395 | DATPRT  equ 40H
                          396 | 
                          397 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          398 | ;SETUP -- Prepare the system for running the
                          399 | ;   monitor
                          400 | ;
                          401 | ;pre: none
                          402 | ;post: stack and console are initialized
                          403 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1233: 31 FF FF            404 | SETUP:  LXI SP, 0FFFFH
1236: 21 64 12            405 |         LXI H, INIUART@
1239: 06 06               406 |         MVI B, 06H              ; length of ini string
123B: 7E                  407 | INURT:  MOV A, M
123C: D3 41               408 |         OUT CTLPRT
123E: 23                  409 |         INX H
123F: 05                  410 |         DCR B
1240: C2 3B 12            411 |         JNZ INURT
1243: C3 03 10            412 |         JMP SE1
                          413 | 
                          414 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          415 | ;CINNE -- Get a char from the console, no echo
                          416 | ;
                          417 | ;pre: console device is initialized
                          418 | ;post: received char is in A register
                          419 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1246: DB 41               420 | CINNE:  IN CTLPRT
1248: E6 02               421 |         ANI 02H
124A: CA 46 12            422 |         JZ CINNE
124D: DB 40               423 |         IN DATPRT
124F: C9                  424 |         RET
                          425 | 
                          426 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          427 | ;CIN -- Get a char from the console and echo
                          428 | ;
                          429 | ;pre: console device is initialized
                          430 | ;post: received char is in A register
                          431 | ;post: received char is echoed
                          432 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1250: CD 46 12            433 | CIN:    CALL CINNE
1253: D3 40               434 |         OUT DATPRT
1255: C9                  435 |         RET
                          436 | 
                          437 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          438 | ;COUT -- Output a character to the console
                          439 | ;
                          440 | ;pre: A register contains char to be printed
                          441 | ;post: character is printed to the console
                          442 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1256: C5                  443 | COUT:   PUSH B
1257: 47                  444 |         MOV B, A
1258: DB 41               445 | COUT1:  IN CTLPRT
125A: E6 01               446 |         ANI 01H
125C: CA 58 12            447 |         JZ COUT1
125F: 78                  448 |         MOV A, B


Assembly Listing                                                                                                 Page: 9
------------------------------------------------------------------------------------------------------------------------

1260: D3 40               449 |         OUT DATPRT
1262: C1                  450 |         POP B
1263: C9                  451 |         RET
                          452 | 
                          453 | ;Init string for the 8251, x16 clock, 8N1
1264: 00 00 00 40 4E 37   454 | INIUART@:  db 00H, 00H, 00H, 40H, 4EH, 37H
                          455 | 
                          456 | ;I/O Module description string
126A: 0D 0A 42 75 69...   457 | MSG@:     db 13, 10, 'Built with Intel 8251 I/O module', 0
                          458 | 
                          459 |         END

