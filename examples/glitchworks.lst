10C2: C9                  113 |         RET                 ; Done if they are
                          114 | 
                          115 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          116 | ;DMP16 -- Dump 16 consecutive memory locations
                          117 | ;
                          118 | ;pre: HL pair contains starting memory address
                          119 | ;post: memory from HL to HL + 16 printed
                          120 | ;post: HL incremented to HL + 16
                          121 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
10C3: CD 01 11            122 | DMP16:  CALL ADROUT
10C6: CD 54 11            123 |         CALL SPCOUT
10C9: 3E 3A               124 |         MVI A, ':'
10CB: CD 56 12            125 |         CALL COUT
10CE: 0E 10               126 |         MVI C, 10h
10D0: CD 54 11            127 | DM1:    CALL SPCOUT
10D3: CD DC 10            128 |         CALL DMPLOC
10D6: 23                  129 |         INX H
10D7: 0D                  130 |         DCR C
10D8: C8                  131 |         RZ
10D9: C3 D0 10            132 |         JMP DM1
                          133 | 
                          134 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          135 | ;DMPLOC -- Print a byte at HL to console
                          136 | ;
                          137 | ;pre: HL pair contains address of byte
                          138 | ;post: byte at HL printed to console
                          139 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
10DC: 7E                  140 | DMPLOC: MOV A, M
10DD: CD E1 10            141 |         CALL HEXOUT
10E0: C9                  142 |         RET
                          143 | 
                          144 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          145 | ;HEXOUT -- Output byte to console as hex
                          146 | ;
                          147 | ;pre: A register contains byte to be output
                          148 | ;post: byte is output to console as hex
                          149 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
10E1: C5                  150 | HEXOUT: PUSH B
10E2: 47                  151 |         MOV B, A
10E3: 0F                  152 |         RRC
10E4: 0F                  153 |         RRC
10E5: 0F                  154 |         RRC
10E6: 0F                  155 |         RRC
10E7: E6 0F               156 |         ANI 0Fh
10E9: CD FA 10            157 |         CALL HEXASC
10EC: CD 56 12            158 |         CALL COUT
10EF: 78                  159 |         MOV A, B
10F0: E6 0F               160 |         ANI 0Fh
10F2: CD FA 10            161 |         CALL HEXASC
10F5: CD 56 12            162 |         CALL COUT
10F8: C1                  163 |         POP B
10F9: C9                  164 |         RET
                          165 | 
                          166 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          167 | ;HEXASC -- Convert nybble to ASCII char
                          168 | ;


