                           12 | 
                           13 |         ORG 100H               ;See README for more info
                           14 | 
                           15 | ;Initialization and sign-on message
0100: C3 33 03             16 | LOG:    JMP SETUP           ;See README for more info
0103: 21 C4 02             17 | SE1:    LXI H, LOGMSG@
0106: CD 5A 02             18 |         CALL STROUT
0109: 21 6A 03             19 |         LXI H, MSG@
010C: CD 5A 02             20 |         CALL STROUT
                           21 | 
                           22 | ;Main command loop
010F: 21 1C 03             23 | CMDLP:  LXI H, PROMPT@
0112: CD 5A 02             24 |         CALL STROUT
0115: 21 0F 01             25 |         LXI H, CMDLP        ; Get CMDLP address in HL
0118: E5                   26 |         PUSH H              ; Push HL, prime stack for RET to CMDLP
0119: CD 50 03             27 |         CALL CIN
011C: E6 5F                28 |         ANI 5Fh
011E: FE 44                29 |         CPI 'D'
0120: CA 9C 01             30 |         JZ MEMDMP
0123: FE 45                31 |         CPI 'E'
0125: CA 65 01             32 |         JZ EDMEM
0128: FE 47                33 |         CPI 'G'
012A: CA 93 01             34 |         JZ GO
012D: FE 4F                35 |         CPI 'O'
012F: CA 42 01             36 |         JZ OUTPUT
0132: FE 49                37 |         CPI 'I'
0134: CA 53 01             38 |         JZ INPUT
0137: FE 4C                39 |         CPI 'L'
0139: CA 75 02             40 |         JZ LOAD
013C: 21 2A 03             41 |         LXI H, ERR@
013F: C3 65 02             42 |         JMP ERROUT
                           43 | 
                           44 | ;Get a port address, write byte out
0142: CD 54 02             45 | OUTPUT: CALL SPCOUT
0145: CD 13 02             46 |         CALL GETHEX
0148: 47                   47 |         MOV B, A
0149: CD 54 02             48 |         CALL SPCOUT
014C: CD 13 02             49 |         CALL GETHEX
014F: CD 3B 02             50 |         CALL JMPOUT
0152: C9                   51 |         RET
                           52 | 
                           53 | ;Input from port, print contents
0153: CD 54 02             54 | INPUT:  CALL SPCOUT
0156: CD 13 02             55 |         CALL GETHEX
0159: 47                   56 |         MOV B, A


