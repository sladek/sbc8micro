105A: CD 54 11             57 |         CALL SPCOUT
105D: 78                   58 |         MOV A, B
105E: CD 41 11             59 |         CALL JMPIN
1061: CD E1 10             60 |         CALL HEXOUT
1064: C9                   61 |         RET
                           62 | 
                           63 | ;Edit memory from a starting address until X is
                           64 | ;pressed. Display mem loc, contents, and results
                           65 | ;of write.
1065: CD 54 11             66 | EDMEM:  CALL SPCOUT
1068: CD 0A 11             67 |         CALL ADRIN
106B: 62                   68 |         MOV H, D
106C: 6B                   69 |         MOV L, E
106D: CD 6C 11             70 | ED1:    CALL CRLF
1070: CD 01 11             71 |         CALL ADROUT
1073: CD 54 11             72 |         CALL SPCOUT
1076: 3E 3A                73 |         MVI A, ':'
1078: CD 56 12             74 |         CALL COUT
107B: CD 54 11             75 |         CALL SPCOUT
107E: CD DC 10             76 |         CALL DMPLOC
1081: CD 54 11             77 |         CALL SPCOUT
1084: CD 13 11             78 |         CALL GETHEX
1087: D8                   79 |         RC
1088: 77                   80 |         MOV M, A
1089: CD 54 11             81 |         CALL SPCOUT
108C: CD DC 10             82 |         CALL DMPLOC
108F: 23                   83 |         INX H
1090: C3 6D 10             84 |         JMP ED1
                           85 | 
                           86 | ;Get an address and jump to it
1093: CD 54 11             87 | GO:     CALL SPCOUT
1096: CD 0A 11             88 |         CALL ADRIN
1099: 62                   89 |         MOV H, D
109A: 6B                   90 |         MOV L, E
109B: E9                   91 |         PCHL
                           92 | 
                           93 | ;Dump memory between two address locations
109C: CD 54 11             94 | MEMDMP: CALL SPCOUT
109F: CD 0A 11             95 |         CALL ADRIN
10A2: 62                   96 |         MOV H, D            ; Start in HL
10A3: 6B                   97 |         MOV L, E
10A4: 0E 10                98 |         MVI C, 10h
10A6: CD 54 11             99 |         CALL SPCOUT
10A9: CD 0A 11            100 |         CALL ADRIN          ; End in DE
10AC: CD 6C 11            101 | MD1:    CALL CRLF
10AF: CD C3 10            102 |         CALL DMP16
10B2: 7A                  103 |         MOV A, D            ; High byte of end address
10B3: BC                  104 |         CMP H               ; Compare current high address
10B4: F8                  105 |         RM                  ; Done if current high > end high
10B5: 7B                  106 |         MOV A, E            ; Low byte of end address
10B6: BD                  107 |         CMP L               ; Compare current low address
10B7: DA BD 10            108 |         JC MD2              ; Current low > end low, check for rollover
10BA: C3 AC 10            109 |         JMP MD1             ; Continue dumping memory
10BD: 7A                  110 | MD2:    MOV A, D            ; High byte of end address
10BE: BC                  111 |         CMP H               ; Are high bytes the same?
10BF: C2 AC 10            112 |         JNZ MD1             ; Keep going if upper bytes aren't the same


Assembly Listing                                                                                                 Page: 3
