                           12 | 
                           13 |         ORG 1000H               ;See README for more info
                           14 | 
                           15 | ;Initialization and sign-on message
1000: C3 33 12             16 | LOG:    JMP SETUP           ;See README for more info
1003: 21 C4 11             17 | SE1:    LXI H, LOGMSG@
1006: CD 5A 11             18 |         CALL STROUT
1009: 21 6A 12             19 |         LXI H, MSG@
100C: CD 5A 11             20 |         CALL STROUT
                           21 | 
                           22 | ;Main command loop
100F: 21 1C 12             23 | CMDLP:  LXI H, PROMPT@
1012: CD 5A 11             24 |         CALL STROUT
1015: 21 0F 10             25 |         LXI H, CMDLP        ; Get CMDLP address in HL
1018: E5                   26 |         PUSH H              ; Push HL, prime stack for RET to CMDLP
1019: CD 50 12             27 |         CALL CIN
101C: E6 5F                28 |         ANI 5Fh
101E: FE 44                29 |         CPI 'D'
1020: CA 9C 10             30 |         JZ MEMDMP
1023: FE 45                31 |         CPI 'E'
1025: CA 65 10             32 |         JZ EDMEM
1028: FE 47                33 |         CPI 'G'
102A: CA 93 10             34 |         JZ GO
102D: FE 4F                35 |         CPI 'O'
102F: CA 42 10             36 |         JZ OUTPUT
1032: FE 49                37 |         CPI 'I'
1034: CA 53 10             38 |         JZ INPUT
1037: FE 4C                39 |         CPI 'L'
1039: CA 75 11             40 |         JZ LOAD
103C: 21 2A 12             41 |         LXI H, ERR@
103F: C3 65 11             42 |         JMP ERROUT
                           43 | 
                           44 | ;Get a port address, write byte out
1042: CD 54 11             45 | OUTPUT: CALL SPCOUT
1045: CD 13 11             46 |         CALL GETHEX
1048: 47                   47 |         MOV B, A
1049: CD 54 11             48 |         CALL SPCOUT
104C: CD 13 11             49 |         CALL GETHEX
104F: CD 3B 11             50 |         CALL JMPOUT
1052: C9                   51 |         RET
                           52 | 
                           53 | ;Input from port, print contents
1053: CD 54 11             54 | INPUT:  CALL SPCOUT
1056: CD 13 11             55 |         CALL GETHEX
1059: 47                   56 |         MOV B, A


