                          169 | ;pre: A register contains nybble
                          170 | ;post: A register contains ASCII char
                          171 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
10FA: C6 90               172 | HEXASC: ADI 90h
10FC: 27                  173 |         DAA
10FD: CE 40               174 |         ACI 40h
10FF: 27                  175 |         DAA
1100: C9                  176 |         RET
                          177 | 
                          178 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          179 | ;ADROUT -- Print an address to the console
                          180 | ;
                          181 | ;pre: HL pair contains address to print
                          182 | ;post: HL printed to console as hex
                          183 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1101: 7C                  184 | ADROUT: MOV A, H
1102: CD E1 10            185 |         CALL HEXOUT
1105: 7D                  186 |         MOV A, L
1106: CD E1 10            187 |         CALL HEXOUT
1109: C9                  188 |         RET
                          189 | 
                          190 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          191 | ;ADRIN -- Get an address word from console
                          192 | ;
                          193 | ;pre: none
                          194 | ;post: DE contains address from console
                          195 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
110A: CD 13 11            196 | ADRIN:  CALL GETHEX
110D: 57                  197 |         MOV D, A
110E: CD 13 11            198 |         CALL GETHEX
1111: 5F                  199 |         MOV E, A
1112: C9                  200 |         RET
                          201 | 
                          202 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          203 | ;GETHEX -- Get byte from console as hex
                          204 | ;
                          205 | ;pre: none
                          206 | ;post: A register contains byte from hex input
                          207 | ;post: Carry flag set if X was received
                          208 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1113: D5                  209 | GETHEX: PUSH D
1114: CD 50 12            210 |         CALL CIN
1117: FE 58               211 |         CPI 'X'
1119: CA 2D 11            212 |         JZ GE2
111C: CD 31 11            213 |         CALL ASCHEX
111F: 07                  214 |         RLC
1120: 07                  215 |         RLC
1121: 07                  216 |         RLC
1122: 07                  217 |         RLC
1123: 57                  218 |         MOV D, A
1124: CD 50 12            219 |         CALL CIN
1127: CD 31 11            220 |         CALL ASCHEX
112A: B2                  221 |         ORA D
112B: D1                  222 | GE1:    POP D
112C: C9                  223 |         RET
112D: 37                  224 | GE2:    STC


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

112E: C3 2B 11            225 |         JMP GE1
                          226 | 
                          227 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          228 | ;ASCHEX -- Convert ASCII coded hex to nybble
                          229 | ;
                          230 | ;pre: A register contains ASCII coded nybble
                          231 | ;post: A register contains nybble
                          232 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1131: D6 30               233 | ASCHEX: SUI 30h
1133: FE 0A               234 |         CPI 0Ah
1135: F8                  235 |         RM
1136: E6 5F               236 |         ANI 5Fh
1138: D6 07               237 |         SUI 07h
113A: C9                  238 |         RET
                          239 | 
                          240 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          241 | ;JMPOUT -- Output to a dynamic port
                          242 | ;
                          243 | ;pre: B register contains the port to output to
                          244 | ;pre: A register contains the byte to output
                          245 | ;post: byte is output
                          246 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
113B: 0E D3               247 | JMPOUT: MVI C, 0D3h
113D: CD 48 11            248 |         CALL GOBYT
1140: C9                  249 |         RET
                          250 | 
                          251 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          252 | ;JMPIN -- Input from a dynamic port
                          253 | ;
                          254 | ;pre: A register contains the port to input from
                          255 | ;post: A register contains port value
                          256 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1141: 0E DB               257 | JMPIN:  MVI C, 0DBh
1143: 47                  258 |         MOV B, A
1144: CD 48 11            259 |         CALL GOBYT
1147: C9                  260 |         RET
                          261 | 
                          262 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          263 | ;GOBYT -- Push a two-byte instruction and RET
                          264 | ;         and jump to it
                          265 | ;
                          266 | ;pre: B register contains operand
                          267 | ;pre: C register contains opcode
                          268 | ;post: code executed, returns to caller
                          269 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1148: 21 00 00            270 | GOBYT:  LXI H, 0000
114B: 39                  271 |         DAD SP
114C: 2B                  272 |         DCX H
114D: 36 C9               273 |         MVI M, 0C9h
114F: 2B                  274 |         DCX H
1150: 70                  275 |         MOV M, B
1151: 2B                  276 |         DCX H
1152: 71                  277 |         MOV M, C
1153: E9                  278 |         PCHL
                          279 | 
                          280 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


