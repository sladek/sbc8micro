                          281 | ;SPCOUT -- Print a space to the console
                          282 | ;
                          283 | ;pre: none
                          284 | ;post: 0x20 printed to console
                          285 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1154: 3E 20               286 | SPCOUT: MVI A, ' '
1156: CD 56 12            287 |         CALL COUT
1159: C9                  288 |         RET
                          289 | 
                          290 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          291 | ;STROUT -- Print a null-terminated string
                          292 | ;
                          293 | ;pre: HL contains pointer to start of a null-
                          294 | ;     terminated string
                          295 | ;post: string at HL printed to console
                          296 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
115A: 7E                  297 | STROUT: MOV A, M
115B: FE 00               298 |         CPI 00
115D: C8                  299 |         RZ
115E: CD 56 12            300 |         CALL COUT
1161: 23                  301 |         INX H
1162: C3 5A 11            302 |         JMP STROUT
                          303 | 
                          304 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          305 | ;ERROUT -- Print a null-terminated error string
                          306 | ;
                          307 | ;pre: HL contains pointer to start of a null-
                          308 | ;     terminated string
                          309 | ;post: string at HL printed to console
                          310 | ;post: program execution returned to command loop
                          311 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1165: CD 6C 11            312 | ERROUT: CALL CRLF
1168: CD 5A 11            313 |         CALL STROUT
116B: C9                  314 |         RET
                          315 | 
                          316 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          317 | ;CRLF -- Print a CR, LF
                          318 | ;
                          319 | ;Preserves HL
                          320 | ;
                          321 | ;pre: none
                          322 | ;post: CR, LF printed to console
                          323 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
116C: E5                  324 | CRLF:   PUSH H
116D: 21 30 12            325 |         LXI H, CRLF@
1170: CD 5A 11            326 |         CALL STROUT
1173: E1                  327 |         POP H
1174: C9                  328 |         RET
                          329 | 
                          330 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                          331 | ;LOAD -- Load an Intel HEX file from console
                          332 | ;
                          333 | ;post: Intel HEX file loaded, or error printed
                          334 | ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
1175: CD 6C 11            335 | LOAD:   CALL CRLF       ; Newline
1178: CD 46 12            336 | LOAD1:  CALL CINNE


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

117B: FE 3A               337 |         CPI ':'
117D: C2 78 11            338 |         JNZ LOAD1       ; Wait for start colon
1180: CD 56 12            339 |         CALL COUT
1183: CD 13 11            340 |         CALL GETHEX     ; Get record length
1186: 47                  341 |         MOV B, A        ; Record length in B
1187: 4F                  342 |         MOV C, A        ; Start checksumming in C
1188: CD 13 11            343 |         CALL GETHEX     ; Start address high byte
118B: 67                  344 |         MOV H, A        ; Store in H
118C: 81                  345 |         ADD C
118D: 4F                  346 |         MOV C, A        ; Checksum
118E: CD 13 11            347 |         CALL GETHEX     ; Start address low byte
1191: 6F                  348 |         MOV L, A        ; Store in L
1192: 81                  349 |         ADD C
1193: 4F                  350 |         MOV C, A        ; Checksum
1194: CD 13 11            351 |         CALL GETHEX     ; Get record type
1197: 57                  352 |         MOV D, A        ; Store record type in D
1198: 81                  353 |         ADD C
1199: 4F                  354 |         MOV C, A        ; Checksum record type
119A: 78                  355 |         MOV A, B        ; Check record length
119B: A7                  356 |         ANA A
119C: CA B5 11            357 |         JZ LOAD4        ; Length == 0, done getting data
119F: CD 13 11            358 | LOAD2:  CALL GETHEX     ; This is the main record processing loop
11A2: 77                  359 |         MOV M, A        ; Store char at HL
11A3: 81                  360 |         ADD C
11A4: 4F                  361 |         MOV C, A        ; Checksum
11A5: 23                  362 |         INX H           ; Move memory pointer up
11A6: 05                  363 |         DCR B
11A7: C2 9F 11            364 |         JNZ LOAD2       ; Not done with the line
11AA: CD 13 11            365 | LOAD3:  CALL GETHEX     ; Get checksum byte
11AD: 81                  366 |         ADD C
11AE: C2 BE 11            367 |         JNZ CSUMER      ; Checksum bad, print error
11B1: B2                  368 |         ORA D
11B2: CA 75 11            369 |         JZ LOAD         ; Record Type 00, keep going
11B5: CD 46 12            370 | LOAD4:  CALL CINNE      ; Done getting data, silently eat chars
11B8: FE 0A               371 |         CPI 10          ; Check for LF
11BA: C2 B5 11            372 |         JNZ LOAD4
11BD: C9                  373 |         RET             ; Got LF, return to command loop
11BE: 21 21 12            374 | CSUMER: LXI H, CSERR@   ; Print checksum error to console
11C1: C3 65 11            375 |         JMP ERROUT      ; RET from ERROUT will return to command loop
                          376 | 
