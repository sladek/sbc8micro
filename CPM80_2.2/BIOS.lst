                            1 | ;   SKELETAL CBIOS FOR FIRST LEVEL OF CP/M 2.0 ALTERATION
                            2 | ;
                            3 | VERS    EQU 22  ;VERSION 2.2
                            4 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                            6 | 
                            7 | VER:    EQU 2   ;CP/M VERSION
                            8 | REL:    EQU 2   ;CP/M RELEASE
                            9 | REV:    EQU 0   ;REVISION
                           10 | SNH:    EQU 00  ;SERIAL NUMBER, HIGH. 2 DIGITS
                           11 | SNL:    EQU 0000    ;SERIAL  NUMBER, LOW. 4 DIGITS
                            5 | ;
                            6 | ;   "BIAS" IS ADDRESS OFFSET FROM 3400H FOR MEMORY SYSTEMS
                            7 | ;   THAN 16K (REFERRED TO AS "B" THROUGHOUT THE TEXT).
                            8 | ;
                            9 | CDISK   EQU 0004H   ;CURRENT DISK NUMBER 0=A,...,15=P
                           10 | IOBYTE  EQU 0003H   ;INTEL I/O BYTE
                           11 | ;
                           12 | TAPEIO  EQU 0F0H    ;IO ADDRESS OF TAPE READER
                           13 | OFFSET  EQU 2   ;NUMBER OF DISK TRACKS USED BY CP/M
                           14 | BUFF    EQU 0080H   ;DEFAULT BUFFER ADDRESS
                           15 | RETRY   EQU 10  ;MAX RETRIES ON DISK I/O BEFORE ERROR
                           16 | 
                           17 | ;   DISK PORTS AND COMMANDS
                           18 | BASE    EQU 78H ;BASE OF DISK COMMAND IO PORTS
                           19 | DSTAT   EQU BASE    ;DISK STATUS (INPUT)
                           20 | RTYPE   EQU BASE+1  ;RESULT TYPE (INPUT)
                           21 | RBYTE   EQU BASE+3  ;RESULT BYTE (INPUT)
                           22 | ;
                           23 | ILOW    EQU BASE+1  ;IOPB LOW ADDRESS (OUTPUT)
                           24 | IHIGH   EQU BASE+2  ;IOPB HIGH ADDRESS (OUTPUT)
                           25 | ;
                           26 | READF   EQU 4H  ;READ FUNCTION
                           27 | WRITF   EQU 6H  ;WRITE FUNCTION
                           28 | RECAL   EQU 3H  ;RECALIBRATE DRIVE
                           29 | IORDY   EQU 4H  ;I/O FINISHED MASK (MASK OF INTERRUPT PENDING FLAG)
                           30 | CR  EQU 0DH ;CARRIAGE RETURN
                           31 | LF  EQU 0AH ;LINE FEED
                           32 | ;
                           33 |     ORG BIOS    ;ORIGIN OF THIS PROGRAM
                           34 | NSECTS  EQU ($-CCP)/128 ;WARM START SECTOR COUNT (SIZE OF CCP + BDOS)
                           35 | ;
                           36 | ;   JUMP VECTOR FOR INDIVIDUAL SUBROUTINES
FA00: C3 B3 FA             37 |     JMP BOOT        ;COLD START
                           38 | WBOOTE: 
FA03: C3 C9 FA             39 |     JMP WBOOT       ;WARM START
FA06: C3 49 FB             40 |     JMP CONST       ;CONSOLE STATUS
FA09: C3 51 FB             41 |     JMP CONIN       ;CONSOLE CHARACTER IN
FA0C: C3 5D FB             42 |     JMP CONOUT      ;CONSOLE CHARACTER OUT
FA0F: C3 68 FB             43 |     JMP LIST        ;LIST CHARACTER OUT
FA12: C3 6C FB             44 |     JMP PUNCH       ;PUNCH CHARACTER OUT
FA15: C3 79 FB             45 |     JMP READER      ;READER CHARACTER OUT


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

FA18: C3 8B FB             46 |     JMP HOME        ;MOVE HEAD TO HOME POSITION
FA1B: C3 91 FB             47 |     JMP SELDSK      ;SELECT DISK
FA1E: C3 B8 FB             48 |     JMP SETTRK      ;SET TRACK NUMBER
FA21: C3 BD FB             49 |     JMP SETSEC      ;SET SECTOR NUMBER
FA24: C3 D6 FB             50 |     JMP SETDMA      ;SET DMA ADDRESS
FA27: C3 DC FB             51 |     JMP READ        ;READ DISK
FA2A: C3 E5 FB             52 |     JMP WRITE       ;WRITE DISK
FA2D: C3 6A FB             53 |     JMP LISTST      ;RETURN LIST STATUS
FA30: C3 C2 FB             54 |     JMP SECTRAN     ;SECTOR TRANSLATE
                           55 | ;
                           56 | ;   FIXED DATA TABLES FOR FOUR-DRIVE STANDARD
                           57 | ;   IBM-COMPATIBLE 8" DISKS
                           58 | ;   DISK PARAMETER HEADER FOR DISK 00
                           59 | DPBASE: 
                           60 | ;   DW  TRANS,0000H
FA33: 00 00 00 00          61 |     DW  0000H,0000H ; NO TRANSLATION SO XLT IS SET TO 0000H
FA37: 00 00 00 00          62 |     DW  0000H,0000H
FA3B: 3D FC 8D FA          63 |     DW  DIRBF,DPBLK
FA3F: 39 FD BD FC          64 |     DW  CHK00,ALL00
                           65 | ;   DISK PARAMETER HEADER FOR DISK 01
                           66 | ;   DW  TRANS,0000H
FA43: 00 00 00 00          67 |     DW  0000H,0000H
FA47: 00 00 00 00          68 |     DW  0000H,0000H
FA4B: 3D FC 8D FA          69 |     DW  DIRBF,DPBLK
FA4F: 49 FD DC FC          70 |     DW  CHK01,ALL01
                           71 | ;   DISK PARAMETER HEADER FOR DISK 02
                           72 | ;   DW  TRANS,0000H
FA53: 00 00 00 00          73 |     DW  0000H,0000H
FA57: 00 00 00 00          74 |     DW  0000H,0000H
FA5B: 3D FC 8D FA          75 |     DW  DIRBF,DPBLK
FA5F: 59 FD FB FC          76 |     DW  CHK02,ALL02
                           77 | ;   DISK PARAMETER HEADER FOR DISK 03
                           78 | ;   DW  TRANS,0000H
FA63: 00 00 00 00          79 |     DW  0000H,0000H
FA67: 00 00 00 00          80 |     DW  0000H,0000H
FA6B: 3D FC 8D FA          81 |     DW  DIRBF,DPBLK
FA6F: 69 FD 1A FD          82 |     DW  CHK03,ALL03
                           83 | ;
                           84 | ;   SECTOR TRANSLATE VECTOR
                           85 | TRANS:  
FA73: 01 07 0D 13          86 |     DB  1,7,13,19   ;SECTORS 1,2,3,4
FA77: 19 05 0B 11          87 |     DB  25,5,11,17  ;SECTORS 5,6,7,8
FA7B: 17 03 09 0F          88 |     DB  23,3,9,15   ;SECTORS 9,10,11,12
FA7F: 15 02 08 0E          89 |     DB  21,2,8,14   ;SECTORS 13,14,15,16
FA83: 14 1A 06 0C          90 |     DB  20,26,6,12  ;SECTORS 17,18,19,20
FA87: 12 18 04 0A          91 |     DB  18,24,4,10  ;SECTORS 21,22,23,24
FA8B: 10 16                92 |     DB  16,22       ;SECTORS 25,26
                           93 | ;
                           94 | DPBLK:  ;DISK PARAMETER BLOCK, COMMON TO ALL DISKS
FA8D: 1A 00                95 |     DW  26      ;SECTORS PER TRACK
FA8F: 03                   96 |     DB  3       ;BLOCK SHIFT FACTOR (3 = 1K BLOCKS)
FA90: 07                   97 |     DB  7       ;BLOCK MASK (7 = 1K BLOCK MASK)
FA91: 00                   98 |     DB  0       ;NULL MASK
FA92: F2 00                99 |     DW  242     ;DISK SIZE-1
FA94: 3F 00               100 |     DW  63      ;DIRECTORY MAX
FA96: C0                  101 |     DB  192     ;ALLOC 0


Assembly Listing                                                                                                 Page: 3
------------------------------------------------------------------------------------------------------------------------

FA97: 00                  102 |     DB  0       ;ALLOC 1
FA98: 10 00               103 |     DW  16      ;CHECK SIZE
FA9A: 02 00               104 |     DW  2       ;TRACK OFFSET
                          105 | ;
                          106 | ;   END OF FIXED TABLES
                          107 | ;
                          108 | SIGNON: ;SIGNON MESSAGE: XXK CP/M VERS Y.Y
FA9C: 0D 0A 0A            109 |     DB  CR,LF,LF
                          110 |     IF  TEST
                          111 :     DB  '32'    ;32K EXAMPLE BIOS
                          112 :     ENDIF
                          113 |     IF  !TEST
FA9F: 36 34               114 |     DB  MSIZE/10+'0',MSIZE MOD 10+'0'   ;MEMORY SIZE
                          115 |     ENDIF
FAA1: 4B 20 43 50 2F...   116 |     DB  'K CP/M VERS '
FAAD: 32 2E 32            117 |     DB  VERS/10+'0','.',VERS MOD 10+'0'
FAB0: 0D 0A 00            118 |     DB  CR,LF,0
                          119 | ;
                          120 | ;   INDIVIDUAL SUBROUTINES TO PERFORM EACH FUNCTION
                          121 | BOOT:   ;PRINT SIGNON MESSAGE AND GO TO CCP
                          122 | ;   (NOTE: MDS BOOT INITIALIZED IOBYTE AT 0003H)
FAB3: 31 00 01            123 |     LXI SP,BUFF+80H
FAB6: CD 34 FB            124 |     CALL    INIT_CONSOLE
FAB9: 21 9C FA            125 |     LXI H,SIGNON
FABC: CD EE FB            126 |     CALL    PRMSG   ;PRINT MESSAGE
FABF: AF                  127 |     XRA A   ;CLEAR ACCUMULATOR
FAC0: 32 03 00            128 |     STA IOBYTE  ;CLEAR THE IOBYTE
FAC3: 32 04 00            129 |     STA CDISK   ;SET INITIALLY TO DISK A
FAC6: C3 12 FB            130 |     JMP GOCPM   ;GO TO CP/M
                          131 | ;
                          132 | WBOOT:  ;SIMPLEST CASE IS TO READ THE DISK UNTIL ALL SECTORS LOADED
FAC9: 31 80 00            133 |     LXI SP,BUFF     ;USE SPACE BELOW BUFFER FOR STACK
FACC: 0E 00               134 |     MVI C,0     ;SELECT DISK 0
FACE: CD 91 FB            135 |     CALL    SELDSK
FAD1: CD 8B FB            136 |     CALL    HOME        ;GO TO TRACK 00
                          137 | ;
FAD4: 06 2C               138 |     MVI B,NSECTS    ;B COUNTS # OF SECTORS TO LOAD
FAD6: 0E 00               139 |     MVI C,0     ;C HAS THE CURRENT TRACK NUMBER
FAD8: 16 02               140 |     MVI D,2     ;D HAS THE NEXT SECTOR TO READ
                          141 | ;   NOTE THAT WE BEGIN BY READING TRACK 0, SECTOR 2 SINCE SECTOR 1
                          142 | ;   CONTAINS THE COLD START LOADER, WHICH IS SKIPPED IN A WARM START
FADA: 21 00 E4            143 |     LXI H,CCP       ;BASE OF CP/M (INITIAL LOAD POINT)
                          144 | LOAD1:  ;LOAD ONE MORE SECTOR
FADD: C5                  145 |     PUSH    B   ;SAVE SECTOR COUNT, CURRENT TRACK
FADE: D5                  146 |     PUSH    D   ;SAVE NEXT SECTOR TO READ
FADF: E5                  147 |     PUSH    H   ;SAVE DMA ADDRESS
FAE0: 4A                  148 |     MOV C,D ;GET SECTOR ADDRESS TO REGISTER C
FAE1: CD BD FB            149 |     CALL    SETSEC  ;SET SECTOR ADDRESS FROM REGISTER C
FAE4: C1                  150 |     POP B   ;RECALL DMA ADDRESS TO B,C
FAE5: C5                  151 |     PUSH    B   ;REPLACE ON STACK FOR LATER RECALL
FAE6: CD D6 FB            152 |     CALL    SETDMA  ;SET DMA ADDRESS FROM B,C
                          153 | ;
                          154 | ;   DRIVE SET TO 0, TRACK SET, SECTOR SET, DMA ADDRESS SET
FAE9: CD DC FB            155 |     CALL    READ
FAEC: FE 00               156 |     CPI 00H ;ANY ERRORS?
FAEE: C2 C9 FA            157 |     JNZ WBOOT   ;RETRY THE ENTIRE BOOT IF AN ERROR OCCURS


Assembly Listing                                                                                                 Page: 4
------------------------------------------------------------------------------------------------------------------------

                          158 | ;
                          159 | ;   NO ERROR, MOVE TO NEXT SECTOR
FAF1: E1                  160 |     POP H   ;RECALL DMA ADDRESS
FAF2: 11 80 00            161 |     LXI D,128   ;DMA=DMA+128
FAF5: 19                  162 |     DAD D   ;NEW DMA ADDRESS IS IN H,L
FAF6: D1                  163 |     POP D   ;RECALL SECTOR ADDRESS
FAF7: C1                  164 |     POP B   ;RECALL NUMBER OF SECTORS REMAINING, AND CURRENT TRK
FAF8: 05                  165 |     DCR B   ;SECTORS=SECTORS-1
FAF9: CA 12 FB            166 |     JZ  GOCPM   ;TRANSFER TO CP/M IF ALL HAVE BEEN LOADED
                          167 | ;
                          168 | ;   MORE SECTORS REMAIN TO LOAD, CHECK FOR TRACK CHANGE
FAFC: 14                  169 |     INR D
FAFD: 7A                  170 |     MOV A,D ;SECTOR=27?, IF SO, CHANGE TRACKS
FAFE: FE 1B               171 |     CPI 27
FB00: DA DD FA            172 |     JC  LOAD1   ;CARRY GENERATED IF SECTOR<27
                          173 | ;
                          174 | ;   END OF CURRENT TRACK, GO TO NEXT TRACK
FB03: 16 01               175 |     MVI D,1 ;BEGIN WITH FIRST SECTOR OF NEXT TRACK
FB05: 0C                  176 |     INR C   ;TRACK=TRACK+1
                          177 | ;
                          178 | ;   SAVE REGISTER STATE, AND CHANGE TRACKS
FB06: C5                  179 |     PUSH    B
FB07: D5                  180 |     PUSH    D
FB08: E5                  181 |     PUSH    H
FB09: CD B8 FB            182 |     CALL    SETTRK  ;TRACK ADDRESS SET FROM REGISTER C
FB0C: E1                  183 |     POP H
FB0D: D1                  184 |     POP D
FB0E: C1                  185 |     POP B
FB0F: C3 DD FA            186 |     JMP LOAD1   ;FOR ANOTHER SECTOR
                          187 | ;
                          188 | ;   END OF LOAD OPERATION, SET PARAMETERS AND GO TO CP/M
                          189 | GOCPM:
FB12: 3E C3               190 |     MVI A,0C3H  ;C3 IS A JMP INSTRUCTION
FB14: 32 00 00            191 |     STA 0   ;FOR JMP TO WBOOT
FB17: 21 03 FA            192 |     LXI H,WBOOTE    ;WBOOT ENTRY POINT
FB1A: 22 01 00            193 |     SHLD    1   ;SET ADDRESS FIELD FOR JMP AT 0
                          194 | ;
FB1D: 32 05 00            195 |     STA 5   ;FOR JMP TO BDOS
FB20: 21 06 EC            196 |     LXI H,BDOS  ;BDOS ENTRY POINT
FB23: 22 06 00            197 |     SHLD    6   ;ADDRESS FIELD OF JUMP AT 5 TO BDOS
                          198 | ;
FB26: 01 80 00            199 |     LXI B,80H   ;DEFAULT DMA ADDRESS IS 80H
FB29: CD D6 FB            200 |     CALL    SETDMA  ;SET IOD in IOPB
                          201 | ;
FB2C: FB                  202 |     EI      ;ENABLE THE INTERRUPT SYSTEM
FB2D: 3A 04 00            203 |     LDA CDISK   ;GET CURRENT DISK NUMBER
FB30: 4F                  204 |     MOV C,A ;SEND TO THE CCP
FB31: C3 00 E4            205 |     JMP CCP ;GO TO CP/M FOR FURTHER PROCESSING
                          206 | ;
                          207 | ;
                          208 | ;   SIMPLE I/O HANDLERS (MUST BE FILLED IN BY USER)
                          209 | ;   IN EACH CASE, THE ENTRY POINT IS PROVIDED, WITH SPACE RESERVED
                          210 | ;   TO INSERT YOUR OWN CODE
                          211 | ;
                          212 | 
                          213 |     .INCLUDE "I8251_INIT.LIB"


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

                            1 | ; ASSUMING 8251 DATA PORT = 0F4H, COMMAND/STATUS PORT = 0F5H
                            2 | ; CONSTANTS
                            3 | USART_DATA  EQU 0F4H    ; DATA PORT
                            4 | USART_CMD   EQU 0F5H    ; COMMAND/STATUS PORT
                            5 | 
                            6 | INIT_CONSOLE:
FB34: 3E 00                 7 |         MVI A, 00H          ; 1. SEND AT LEAST 3 NULLS TO ENSURE
FB36: D3 F5                 8 |         OUT USART_CMD       ;    THE 8251 IS IN COMMAND MODE.
FB38: D3 F5                 9 |         OUT USART_CMD
FB3A: D3 F5                10 |         OUT USART_CMD
FB3C: 3E 40                11 |         MVI A, 40H          ; 2. INTERNAL RESET COMMAND
FB3E: D3 F5                12 |         OUT USART_CMD
                           13 |     
                           14 |         ; 3. MODE INSTRUCTION:
                           15 |         ; BITS 0-1: 00 = SYNCHRONOUS, 01 = 1X, 10 = 16X, 11 = 64X
                           16 |         ; BITS 2-3: 00 = 5BIT, 01 = 6BIT, 10 = 7BIT, 11 = 8BIT
                           17 |         ; BITS 4-5: PARITY (00=NONE)
                           18 |         ; BITS 6-7: STOP BITS (01=1 STOP)
FB40: 3E 4F                19 |         MVI A, 4FH          ; 0100 1110 -> 1 STOP, NO PARITY, 8 DATA, 64X BAUD
FB42: D3 F5                20 |         OUT USART_CMD
                           21 |     
                           22 |         ; 4. COMMAND INSTRUCTION:
                           23 |         ; ENABLE TX, ENABLE RX, DTR, RTS
FB44: 3E 37                24 |         MVI A, 37H          ; 0011 0111 -> TXEN, RXE, DTR, RTS
FB46: D3 F5                25 |         OUT USART_CMD
FB48: C9                   26 |         RET
                          214 | 
                          215 | CONST:  ;CONSOLE STATUS, RETURN 0FFH IF CHARACTER READY, 00H IF NOT
FB49: DB F5               216 |     IN  USART_CMD
FB4B: E6 02               217 |     ANI 02H
FB4D: C8                  218 |     RZ      ; NO CHARACTER READY
FB4E: 3E FF               219 |     MVI A, 0FFH ; CHARACTER READY
FB50: C9                  220 |     RET
                          221 | ;
                          222 | CONIN:  ;CONSOLE CHARACTER INTO REGISTER A, NO ECHO
FB51: DB F5               223 |     IN  USART_CMD
FB53: E6 02               224 |     ANI 02H
FB55: CA 51 FB            225 |     JZ  CONIN
FB58: DB F4               226 |     IN  USART_DATA
FB5A: E6 7F               227 |     ANI 7FH ;STRIP PARITY BIT
FB5C: C9                  228 |     RET
                          229 | ;
                          230 | CONOUT: ;CONSOLE CHARACTER OUTPUT FROM REGISTER C
FB5D: DB F5               231 |     IN  USART_CMD
FB5F: E6 01               232 |     ANI 01H
FB61: CA 5D FB            233 |     JZ  CONOUT
FB64: 79                  234 |     MOV A, C
FB65: D3 F4               235 |     OUT USART_DATA
FB67: C9                  236 |     RET
                          237 | ;
                          238 | LIST:   ;LIST CHARACTER FROM REGISTER C
FB68: 79                  239 |     MOV A,C ;CHARACTER TO REGISTER A
FB69: C9                  240 |     RET     ;NULL SUBROUTINE
                          241 | ;
                          242 | LISTST: ;RETURN LIST STATUS (0 IF NOT READY, 1 IF READY)
FB6A: AF                  243 |     XRA A   ;0 IS ALWAYS OK TO RETURN


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

FB6B: C9                  244 |     RET
                          245 | ;
                          246 | PUNCH:  ;PUNCH CHARACTER FROM REGISTER C
FB6C: E5                  247 |     PUSH    H
FB6D: 21 03 00            248 |     LXI H,IOBYTE
FB70: 7E                  249 |     MOV     A,M
                          250 |     ;WE WILL TREAT RDR: UR1 OR UR2: 
                          251 |     ;AS THE SAME READER DEVICE
FB71: E6 30               252 |     ANI     30H ;CHECK IF IT IS RDR:, UR1: OR UR2:
FB73: 79                  253 |     MOV A,C ;CHARACTER TO REGISTER A
FB74: C8                  254 |     RZ      ;IT IS NEITHER RDR: NOR UR1: OR UR2:
FB75: D3 F0               255 |     OUT     TAPEIO
FB77: E1                  256 |     POP H
FB78: C9                  257 |     RET
                          258 | ;
                          259 | ;
                          260 | READER: ;READ CHARACTER INTO REGISTER A FROM READER DEVICE
FB79: E5                  261 |     PUSH    H
FB7A: 21 03 00            262 |     LXI H,IOBYTE
FB7D: 7E                  263 |     MOV A,M
FB7E: E6 0C               264 |     ANI 0CH ;CHECK IF IT IS PTP:, UP1: OR UP2:
FB80: 3E 1A               265 |     MVI A,1AH   ;PUT EOF: TO A 
FB82: CA 87 FB            266 |     JZ  READR1
FB85: DB F0               267 |     IN  TAPEIO
FB87: E6 7F               268 | READR1: ANI 7FH ;MASK PARITY BIT
FB89: E1                  269 |     POP H
FB8A: C9                  270 |     RET
                          271 | ;
                          272 | ;
                          273 | ;   I/O DRIVERS FOR THE DISK FOLLOW
                          274 | ;   FOR NOW, WE WILL SIMPLY STORE THE PARAMETERS AWAY FOR USE
                          275 | ;   IN THE READ AND WRITE SUBROUTINES
                          276 | ;
                          277 | HOME:   ;MOVE TO THE TRACK 00 POSITION OF CURRENT DRIVE
                          278 | ;   TRANSLATE THIS CALL INTO A SETTRK CALL WITH PARAMETER 00
FB8B: 0E 00               279 |     MVI C,0 ;SELECT TRACK 0
FB8D: CD B8 FB            280 |     CALL    SETTRK
FB90: C9                  281 |     RET     ;WE WILL MOVE TO 00 ON FIRST READ/WRITE
                          282 | ;
                          283 | SELDSK: ;SELECT DISK GIVEN BY REGISTER C
FB91: 21 00 00            284 |     LXI H,0000H ;ERROR RETURN CODE
FB94: 79                  285 |     MOV A,C
FB95: 32 3C FC            286 |     STA DISKNO
FB98: FE 04               287 |     CPI 4   ;MUST BE BETWEEN 0 AND 3
FB9A: D0                  288 |     RNC     ;NO CARRY IF 4,5,...
                          289 | ;   DISK NUMBER IS IN THE PROPER RANGE
FB9B: 79                  290 |     MOV A,C 
FB9C: 87                  291 |     ADD A   ;*2
FB9D: 87                  292 |     ADD A   ;*4
FB9E: 87                  293 |     ADD A   ;*8
FB9F: 87                  294 |     ADD A   ;*16
FBA0: 47                  295 |     MOV B,A ;NEW DISK NUMBER TO B
FBA1: 21 7A FD            296 |     LXI H,IOF   ;IO FUNCTION IN IOPB
FBA4: 7E                  297 |     MOV A,M
FBA5: E6 CF               298 |     ANI 11001111B   ;MASK OUT DISK NUMBER
FBA7: B0                  299 |     ORA B   ;MASK IN NEW DISK NUMBER


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

FBA8: 77                  300 |     MOV M,A ;SAVE IT IN IOPB
                          301 | ;   COMPUTE PROPER DISK PARAMETER HEADER ADDRESS
FBA9: 3A 3C FC            302 |     LDA DISKNO
FBAC: 6F                  303 |     MOV L,A ;L=DISK NUMBER 0,1,2,3
FBAD: 26 00               304 |     MVI H,0 ;HIGH ORDER ZERO
FBAF: 29                  305 |     DAD H   ;*2
FBB0: 29                  306 |     DAD H   ;*4
FBB1: 29                  307 |     DAD H   ;*8
FBB2: 29                  308 |     DAD H   ;*16 (SIZE OF EACH HEADER)
FBB3: 11 33 FA            309 |     LXI D,DPBASE
FBB6: 19                  310 |     DAD D   ;HL=.DPBASE(DISKNO*16)
FBB7: C9                  311 |     RET
                          312 | ;
                          313 | SETTRK: ;SET TRACK GIVEN BY REGISTER C
FBB8: 21 7C FD            314 |     LXI H,IOT
FBBB: 71                  315 |     MOV M,C
FBBC: C9                  316 |     RET
                          317 | ;
                          318 | SETSEC: ;SET SECTOR GIVEN BY REGISTER C
FBBD: 21 7D FD            319 |     LXI H,IOS
FBC0: 71                  320 |     MOV M,C
FBC1: C9                  321 |     RET
                          322 | ;
                          323 | SECTRAN:
                          324 |     ;TRANSLATE SECTOR BC USING TABLE AT DE
FBC2: 7A                  325 |     MOV A,D ;CHECK IF TRANSLATION NEEDED
FBC3: B3                  326 |     ORA E   ;IF NEEDED DE != 0
FBC4: C2 CC FB            327 |     JNZ SECTRAN1
FBC7: 79                  328 |     MOV A,C ;NO TRANSLATION SO JUST
FBC8: 3C                  329 |     INR A   ;+1 AS BC STARTS WITH 0 END SECNR WITH 1
FBC9: C3 D1 FB            330 |     JMP SECTRAN2;RETURN ORIGINAL SECTOR NUMBER
                          331 | SECTRAN1:
FBCC: 06 00               332 |     MVI B,0 ;DOUBLE PRECISION SECTOR NUMBER IN BC
FBCE: EB                  333 |     XCHG        ;TRANSLATE TABLE ADDRESS TO HL
FBCF: 09                  334 |     DAD B   ;TRANSLATE(SECTOR) ADDRESS
FBD0: 7E                  335 |     MOV A,M ;TRANSLATED SECTOR NUMBER TO A
                          336 | SECTRAN2:
FBD1: 32 7D FD            337 |     STA IOS
FBD4: 6F                  338 |     MOV L,A ;RETURN SECTOR NUMBER IN L
FBD5: C9                  339 |     RET
                          340 | ;
                          341 | SETDMA: ;SET DMA ADDRESS GIVEN BY REGISTERS B AND C
FBD6: 69                  342 |     MOV L,C ;LOW ORDER ADDRESS
FBD7: 60                  343 |     MOV H,B ;HIGH ORDER ADDRESS
FBD8: 22 7E FD            344 |     SHLD    IOD ;SAVE THE ADDRESS
FBDB: C9                  345 |     RET
                          346 | ;
                          347 | READ:   ;READ NEXT DISK RECORD (ASSUMING DISK/TRK/SEC/DMA SET)
FBDC: 0E 04               348 |     MVI C,READF ;SET TO READ FUNCTION
FBDE: CD FB FB            349 |     CALL    SETFUNC
FBE1: CD 04 FC            350 |     CALL    WAITIO  ;PERFORM READ FUNCTION
FBE4: C9                  351 |     RET     ;MAY HAVE ERROR SET IN REG-A
                          352 | ;
                          353 | ;
                          354 | WRITE:  ;DISK WRITE FUNCTION
FBE5: 0E 06               355 |     MVI C,WRITF


Assembly Listing                                                                                                 Page: 8
------------------------------------------------------------------------------------------------------------------------

FBE7: CD FB FB            356 |     CALL    SETFUNC ;SET TO WRITE FUNCTION
FBEA: CD 04 FC            357 |     CALL    WAITIO
FBED: C9                  358 |     RET     ;MAY HAVE ERROR SET
                          359 | ;
                          360 | ;   UTILITY SUBROUTINES
                          361 | PRMSG:  ;PRINT MESSAGE AT H,L TO 0
FBEE: 7E                  362 |     MOV A,M
FBEF: B7                  363 |     ORA A   ;ZERO?
FBF0: C8                  364 |     RZ
                          365 | ;   MORE TO PRINT
FBF1: E5                  366 |     PUSH    H
FBF2: 4F                  367 |     MOV C,A
FBF3: CD 5D FB            368 |     CALL    CONOUT
FBF6: E1                  369 |     POP H
FBF7: 23                  370 |     INX H
FBF8: C3 EE FB            371 |     JMP PRMSG
                          372 | ;
                          373 | SETFUNC:
                          374 | ;   SET FUNCTION FOR NEXT I/O (COMMAND IN REG-C)
FBFB: 21 7A FD            375 |     LXI H,IOF   ;IO FUNCTION ADDRESS
FBFE: 7E                  376 |     MOV A,M ;GET IT TO ACCUMULATOR FOR MASKING
FBFF: E6 F8               377 |     ANI 11111000B   ;REMOVE PREVIOUS COMMAND
FC01: B1                  378 |     ORA C   ;SET TO NEW COMMAND
FC02: 77                  379 |     MOV M,A ;REPLACED IN IOPB
                          380 | ;   THE MDS-800 CONTROLLER REQUIRES DISK BANK BIT IN SECTOR BYTE
                          381 | ;   MASK THE BIT FROM THE CURRENT I/O FUNCTION
                          382 | ;   ANI 00100000B   ;MASK THE DISK SELECT BIT
                          383 | ;   LXI H,IOS       ;ADDRESS THE SECTOR SELECT BYTE
                          384 | ;   ORA M       ;SELECT PROPER DISK BANK
                          385 | ;   MOV M,A     ;SET DISK SELECT BIT ON/OFF
                          386 | ;   FOR MDS-800 CONTROLLER UNCOMMENT ABOVE CODE FOR DISK MASKING
                          387 | ;   IF NECESSARY. MAKE SURE YOU UNDERSTAND WHAT YOU ARE DOING
FC03: C9                  388 |     RET
                          389 | 
                          390 | ;
                          391 | WAITIO:
FC04: 0E 0A               392 |     MVI C,RETRY ;MAX RETRIES BEFORE PERM ERROR
                          393 | REWAIT:
                          394 | ;   START THE I/O FUNCTION AND WAIT FOR COMPLETION
FC06: DB 79               395 |     IN  RTYPE   ;IN RTYPE
FC08: DB 7B               396 |     IN  RBYTE   ;CLEARS THE CONTROLLER
                          397 | ;
FC0A: 3E 79               398 |     MVI A,IOPB & 0FFH   ;LOW ADDRESS FOR IOPB
FC0C: 06 FD               399 |     MVI B,IOPB SHR 8    ;HIGH ADDRESS FOR IOPB
FC0E: D3 79               400 |     OUT ILOW        ;LOW ADDRESS TO CONTROLLER
FC10: 78                  401 |     MOV A,B
FC11: D3 7A               402 |     OUT IHIGH   ;HIGH ADDRESS
                          403 | ;
                          404 | WAIT0:  
FC13: DB 78               405 |     IN  DSTAT
                          406 |         ;WAIT FOR COMPLETION
FC15: E6 04               407 |     ANI IORDY       ;READY?
FC17: CA 13 FC            408 |     JZ  WAIT0
                          409 | ;
                          410 | ;   CHECK IO COMPLETION OK
FC1A: DB 79               411 |     IN  RTYPE       ;MUST BE IO COMPLETE (00) UNLINKED


Assembly Listing                                                                                                 Page: 9
------------------------------------------------------------------------------------------------------------------------

                          412 | ;   00 UNLINKED I/O COMPLETE,    01 LINKED I/O COMPLETE (NOT USED)
                          413 | ;   10 DISK STATUS CHANGED       11 (NOT USED)
FC1C: FE 02               414 |     CPI 10B     ;READY STATUS CHANGE?
FC1E: CA 32 FC            415 |     JZ  WREADY
                          416 | ;
                          417 | ;   MUST BE 00 IN THE ACCUMULATOR
FC21: B7                  418 |     ORA A
FC22: C2 37 FC            419 |     JNZ WERROR      ;SOME OTHER CONDITION, RETRY
                          420 | ;
                          421 | ;   CHECK I/O ERROR BITS
FC25: DB 7B               422 |     IN  RBYTE
FC27: 17                  423 |     RAL
FC28: DA 32 FC            424 |     JC  WREADY      ;UNIT NOT READY
FC2B: 1F                  425 |     RAR
FC2C: E6 FE               426 |     ANI 11111110B   ;ANY OTHER ERRORS?  (DELETED DATA OK)
FC2E: C2 37 FC            427 |     JNZ WERROR
                          428 | ;
                          429 | ;   READ OR WRITE IS OK, ACCUMULATOR CONTAINS ZERO
FC31: C9                  430 |     RET
                          431 | ;
                          432 | WREADY: ;NOT READY, TREAT AS ERROR FOR NOW
FC32: DB 7B               433 |     IN  RBYTE       ;CLEAR RESULT BYTE
FC34: C3 37 FC            434 |     JMP TRYCOUNT
                          435 | ;
                          436 | WERROR: ;RETURN HARDWARE MALFUNCTION (CRC, TRACK, SEEK, ETC.)
                          437 | ;   THE MDS CONTROLLER HAS RETURNED A BIT IN EACH POSITION
                          438 | ;   OF THE ACCUMULATOR, CORRESPONDING TO THE CONDITIONS:
                          439 | ;   0   - DELETED DATA (ACCEPTED AS OK ABOVE)
                          440 | ;   1   - CRC ERROR
                          441 | ;   2   - SEEK ERROR
                          442 | ;   3   - ADDRESS ERROR (HARDWARE MALFUNCTION)
                          443 | ;   4   - DATA OVER/UNDER FLOW (HARDWARE MALFUNCTION)
                          444 | ;   5   - WRITE PROTECT (TREATED AS NOT READY)
                          445 | ;   6   - WRITE ERROR (HARDWARE MALFUNCTION)
                          446 | ;   7   - NOT READY
                          447 | ;   (ACCUMULATOR BITS ARE NUMBERED 7 6 5 4 3 2 1 0)
                          448 | ;
                          449 | ;   IT MAY BE USEFUL TO FILTER OUT THE VARIOUS CONDITIONS,
                          450 | ;   BUT WE WILL GET A PERMANENT ERROR MESSAGE IF IT IS NOT
                          451 | ;   RECOVERABLE.  IN ANY CASE, THE NOT READY CONDITION IS
                          452 | ;   TREATED AS A SEPARATE CONDITION FOR LATER IMPROVEMENT
                          453 | TRYCOUNT:
                          454 | ;   REGISTER C CONTAINS RETRY COUNT, DECREMENT 'TIL ZERO
FC37: 0D                  455 |     DCR C
FC38: C2 06 FC            456 |     JNZ REWAIT  ;FOR ANOTHER TRY
                          457 | ;
                          458 | ;   CANNOT RECOVER FROM ERROR
                          459 | ;   MVI A,1 ;ERROR CODE ORIGINALLY SET JUST TO 1
                          460 | ;   BUT WE WANT TO DISTINGUISH ALSO OTHER ERRORS LIKE R/O 
                          461 | ;   ERROR CODE IS IN A REGISTER
FC3B: C9                  462 |     RET
                          463 | ;
FC3C:                     464 | DISKNO: DS  1   ;DISK NUMBER 0-15
                          465 | ;
                          466 | ;   SCRATCH RAM AREA FOR BDOS USE
                          467 | BEGDAT  EQU $   ;BEGINNING OF DATA AREA


