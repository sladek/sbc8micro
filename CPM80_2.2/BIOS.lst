------------------------------------------------------------------------------------------------------------------------

FA2A: C3 CE FB             52 |     JMP WRITE       ;WRITE DISK
FA2D: C3 75 FB             53 |     JMP LISTST      ;RETURN LIST STATUS
FA30: C3 B5 FB             54 |     JMP SECTRAN     ;SECTOR TRANSLATE
                           55 | ;
                           56 | ;   FIXED DATA TABLES FOR FOUR-DRIVE STANDARD
                           57 | ;   IBM-COMPATIBLE 8" DISKS
                           58 | ;   DISK PARAMETER HEADER FOR DISK 00
                           59 | DPBASE: 
FA33: 73 FA 00 00          60 |     DW  TRANS,0000H
FA37: 00 00 00 00          61 |     DW  0000H,0000H
FA3B: 2F FC 8D FA          62 |     DW  DIRBF,DPBLK
FA3F: 2B FD AF FC          63 |     DW  CHK00,ALL00
                           64 | ;   DISK PARAMETER HEADER FOR DISK 01
FA43: 73 FA 00 00          65 |     DW  TRANS,0000H
FA47: 00 00 00 00          66 |     DW  0000H,0000H
FA4B: 2F FC 8D FA          67 |     DW  DIRBF,DPBLK
FA4F: 3B FD CE FC          68 |     DW  CHK01,ALL01
                           69 | ;   DISK PARAMETER HEADER FOR DISK 02
FA53: 73 FA 00 00          70 |     DW  TRANS,0000H
FA57: 00 00 00 00          71 |     DW  0000H,0000H
FA5B: 2F FC 8D FA          72 |     DW  DIRBF,DPBLK
FA5F: 4B FD ED FC          73 |     DW  CHK02,ALL02
                           74 | ;   DISK PARAMETER HEADER FOR DISK 03
FA63: 73 FA 00 00          75 |     DW  TRANS,0000H
FA67: 00 00 00 00          76 |     DW  0000H,0000H
FA6B: 2F FC 8D FA          77 |     DW  DIRBF,DPBLK
FA6F: 5B FD 0C FD          78 |     DW  CHK03,ALL03
                           79 | ;
                           80 | ;   SECTOR TRANSLATE VECTOR
                           81 | TRANS:  
FA73: 01 07 0D 13          82 |     DB  1,7,13,19   ;SECTORS 1,2,3,4
FA77: 19 05 0B 11          83 |     DB  25,5,11,17  ;SECTORS 5,6,7,8
FA7B: 17 03 09 0F          84 |     DB  23,3,9,15   ;SECTORS 9,10,11,12
FA7F: 15 02 08 0E          85 |     DB  21,2,8,14   ;SECTORS 13,14,15,16
FA83: 14 1A 06 0C          86 |     DB  20,26,6,12  ;SECTORS 17,18,19,20
FA87: 12 18 04 0A          87 |     DB  18,24,4,10  ;SECTORS 21,22,23,24
FA8B: 10 16                88 |     DB  16,22       ;SECTORS 25,26
                           89 | ;
                           90 | DPBLK:  ;DISK PARAMETER BLOCK, COMMON TO ALL DISKS
FA8D: 1A 00                91 |     DW  26      ;SECTORS PER TRACK
FA8F: 03                   92 |     DB  3       ;BLOCK SHIFT FACTOR
FA90: 07                   93 |     DB  7       ;BLOCK MASK
FA91: 00                   94 |     DB  0       ;NULL MASK
FA92: F2 00                95 |     DW  242     ;DISK SIZE-1
FA94: 3F 00                96 |     DW  63      ;DIRECTORY MAX
FA96: C0                   97 |     DB  192     ;ALLOC 0
FA97: 00                   98 |     DB  0       ;ALLOC 1
FA98: 10 00                99 |     DW  16      ;CHECK SIZE
FA9A: 02 00               100 |     DW  2       ;TRACK OFFSET
                          101 | ;
                          102 | ;   END OF FIXED TABLES
                          103 | ;
                          104 | SIGNON: ;SIGNON MESSAGE: XXK CP/M VERS Y.Y
FA9C: 0D 0A 0A            105 |     DB  CR,LF,LF
                          106 |     IF  TEST
                          107 :     DB  '32'    ;32K EXAMPLE BIOS


