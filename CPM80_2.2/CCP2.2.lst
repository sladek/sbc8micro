                          622 | ;
                          623 | ;   ******************************
                          624 | ;   MAIN OPERATING ROUTINE FOR CCP
                          625 | ;   ******************************
                          626 | ;
                          627 | ;   Entry point number 1
                          628 | ;   Input buffer counter is zeroed out so no imbedded
                          629 | ;   command can be executed on initial boot up.
                          630 | ;
E758: AF                  631 | CCP0:   XRA A   ;
E759: 32 07 E4            632 |     STA INBLEN  ;
                          633 | ;
                          634 | ;
                          635 | ;   Entry point number 2
                          636 | ;   Entry a this point allows commands inbedded in
                          637 | ;   input buffer to be automatically executed
                          638 | ;   on initial boot up.
                          639 | ;
                          640 | ;   On entry (C) has user number in the high nibble
                          641 | ;   and the disk drive in the lower nibble
                          642 | ;
E75C: 31 AB EB            643 | CCP1:   LXI SP,STACK    ;Set up loacal stack
E75F: C5                  644 |     PUSH    B   ;Save entry parameter
E760: 79                  645 |     MOV A,C ;
E761: 1F                  646 |     RAR     ;Move upper 4 bits down
E762: 1F                  647 |     RAR     ;
E763: 1F                  648 |     RAR     ;
E764: 1F                  649 |     RAR     ;
E765: E6 0F               650 |     ANI 0FH ;Extract user number from input parameter
E767: 5F                  651 |     MOV E,A ;
E768: CD 15 E5            652 |     CALL    SETUSR  ;Put user number in its place
E76B: CD B8 E4            653 |     CALL    RESET   ;Reset disk system
E76E: 32 AB EB            654 |     STA SUBFL   ;SUBMIT FILE FLAG
E771: C1                  655 |     POP B   ;Get back entry parameter
E772: 79                  656 |     MOV A,C ;
E773: E6 0F               657 |     ANI 0FH ;Extract disk drive number from input parameter
E775: 32 EF EB            658 |     STA CURDSK  ;Set to correct disk drive
E778: CD BD E4            659 |     CALL    SELDSK  ;
E77B: 3A 07 E4            660 |     LDA INBLEN  ;
E77E: B7                  661 |     ORA A   ;Check to see if there is anything in the input buffer


