E985: AF                 1016 |     XRA A   ;
E986: 77                 1017 |     MOV M,A ;Zero (TYPCTR)
E987: 34                 1018 | TYPE2:  INR M   ;
E988: 21 80 00           1019 |     LXI H,DDMA  ;
E98B: CD 59 E6           1020 |     CALL    ADDAH   ;Point to character
E98E: 7E                 1021 |     MOV A,M ;Get the character
E98F: FE 1A              1022 |     CPI 1AH ;Check for end of file
E991: CA 86 EB           1023 |     JZ  COMEND  ;EXIT
E994: CD 8C E4           1024 |     CALL    OUTPUT  ;Not EOF, output the byte to the console
E997: CD C2 E5           1025 |     CALL    KSTAT   ;Check for keyboard break
E99A: C2 86 EB           1026 |     JNZ COMEND  ;EXIT ON ANY KEY
E99D: C3 74 E9           1027 |     JMP TYPE1   ;Back for the next letter
                         1028 | ;
                         1029 | ;   (A) = 1 :: End of file
                         1030 | ;   (A) = 2 :: Read error
                         1031 | ;
E9A0: 3D                 1032 | TYPE3:  DCR A   ;
E9A1: CA 86 EB           1033 |     JZ  COMEND  ;EXIT AT END OF FILE
