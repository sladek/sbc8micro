                          839 |     ;(NOTE: Change  this command to MOV  A,M and save 2 bytes)
E874: C3 BD E4            840 |     JMP SELDSK  ;  so go make change
                          841 | ;
                          842 | ;   START OF INTRINSIC COMMANDS
                          843 | ;
                          844 | ;   *******************************
                          845 | ;   DIR SEARCHES FILE DIRECTORY FOR
                          846 | ;   FILES BY FILE NAME OR FILE TYPE
                          847 | ;        ? MATCHES ANY LETTER
                          848 | ;   * MATCHES THE WHOLE FILENAME OR
                          849 | ;             FILETYPE
                          850 | ;   *******************************
                          851 | ;
                          852 | ;   NOTE ON SYSTEM FILES:
                          853 | ;   'System' type files are rendered invisible to the
                          854 | ;   DIR command because the MSB of the second byte of
                          855 | ;   the file ext is set. A minor change in the following
                          856 | ;   code could make these files listable in the Directory
                          857 | ;
E877: CD 5E E6            858 | DIR:    CALL    TRFCB   ; TRANSFER THE COMMAND LINE INTO 005CH.
E87A: CD 54 E8            859 |     CALL    SETTRD  ; SET TO TRANSIENT DISK
E87D: 21 CE EB            860 |     LXI H,FCB+1 ; POINT TO START OF FILE NAME
E880: 7E                  861 |     MOV A,M ; CHECK FOR A BLANK
E881: FE 20               862 |     CPI 20H ;' '
E883: C2 8F E8            863 |     JNZ DIR1    ; NOT BLANK, GO FIND WHAT IS WANTED.
                          864 | ;
E886: 06 0B               865 |     MVI B,11    ; BLANK ::= DISPLAY ENTIRE DIRECTORY
E888: 36 3F               866 | DIR0:   MVI M,3FH   ; FILL ENTIRE FILENAME/TYPE ARE WITH WILDCARD [?]'?'
E88A: 23                  867 |     INX H   ;
E88B: 05                  868 |     DCR B   ;
E88C: C2 88 E8            869 |     JNZ DIR0    ;
                          870 | ;
E88F: 1E 00               871 | DIR1:   MVI E,00H   ; SEARCH FOR FILE.
E891: D5                  872 |     PUSH    D   ;
E892: CD E9 E4            873 |     CALL    SRCHF1  ;
E895: CC EA E7            874 |     CZ  NFERR   ; <NOT FOUND> ERROR
E898: CA 1B E9            875 | DIR2:   JZ  DIR10   ;
E89B: 3A EE EB            876 |     LDA RETVAL  ;Get directory entry number
E89E: 0F                  877 |     RRC     ;Convert to directory block pointer
E89F: 0F                  878 |     RRC     ;by multiplying by 32 and masking off
E8A0: 0F                  879 |     RRC     ;the excess
E8A1: E6 60               880 |     ANI 60H ;
E8A3: 4F                  881 |     MOV C,A ;Stash block pointer
E8A4: 3E 0A               882 |     MVI A,10    ;
E8A6: CD 4B E8            883 |     CALL    DIRPTR  ;Get character @ DDMA + block pointer + 10 = Second char of ext
E8A9: 17                  884 |     RAL     ;Check for MSB set :: SYSTEM file
E8AA: DA 0F E9            885 |     JC  DIR9    ;Skip- System files are not listed by DIR


