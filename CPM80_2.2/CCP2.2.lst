E9AA: C3 09 E6           1036 |     JMP WHAT    ;replace REN4 and TRANS8
                         1037 | ;
                         1038 | ;   **********************************
                         1039 | ;   SAVE CREATES DISK FILE FROM MEMORY
                         1040 | ;   STARTING AT 0100H.  256 BYTE PAGES
                         1041 | ;     FILENAME MUST BE UNCONDITIONAL
                         1042 | ;   IF A FILE OF THE SAME NAME & TYPE
                         1043 | ;     ALREADY EXISTS, IT IS ERASED.
                         1044 | ;   **********************************
                         1045 | ;
E9AD: CD F8 E7           1046 | SAVE:   CALL    DECIML  ;GET THE NUMBER OF PAGES TO BE SAVED
E9B0: F5                 1047 |     PUSH    PSW ;
E9B1: CD 5E E6           1048 |     CALL    TRFCB   ;SET UP THE FILE NAME
E9B4: C2 09 E6           1049 |     JNZ WHAT    ;Cannot be ambigous file
E9B7: CD 54 E8           1050 |     CALL    SETTRD  ;SET UP DISK
E9BA: 11 CD EB           1051 |     LXI D,FCB   ;
E9BD: D5                 1052 |     PUSH    D   ;
E9BE: CD EF E4           1053 |     CALL    DELETF  ;DELETE OLD FILE OF SAME NAME
E9C1: D1                 1054 |     POP D   ;
E9C2: CD 09 E5           1055 |     CALL    CREATE  ;CREATE A NEW FILE IN DIRECTORY
E9C5: CA FB E9           1056 |     JZ  SAVE3   ;
E9C8: AF                 1057 |     XRA A   ;
E9C9: 32 ED EB           1058 |     STA FCB+32  ;ZERO OUT SECTOR COUNTER
E9CC: F1                 1059 |     POP PSW ;


