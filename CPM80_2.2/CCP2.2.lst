                          596 | ;
                          597 | ;   COMMAND SEARCH
                          598 | ;
                          599 | ;   Try to match command name starting at FCB + 1
                          600 | ;   with those in the intrinsic command list.
                          601 | ;   Exit with command number (0 to 5) in (A) if a
                          602 | ;   match has been made, else exit with a 6 in (A)
                          603 | ;   signifying that this may be a transient command.
                          604 | ;
E72E: 21 10 E7            605 | CSRCH:  LXI H,CMNDL ; Point to start of command list.
E731: 0E 00               606 |     MVI C,00H   ; Zero out command counter.
E733: 79                  607 | CSRCH1: MOV A,C ; Check counter for maximum number of tries.
E734: FE 06               608 |     CPI 6   ;(There are 6 intrinsic commands + transients)
E736: D0                  609 |     RNC     ; Return is no match in six tries. It is a transient command.
E737: 11 CE EB            610 |     LXI D,FCB+1 ; Point to start of command to be matched.
E73A: 06 04               611 |     MVI B,04H   ; Maximum number of characters in command name.


