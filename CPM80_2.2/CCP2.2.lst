E9AA: C3 09 E6           1028 |     JMP WHAT    ;replace REN4 and TRANS8
                         1029 | ;
                         1030 | ;   **********************************
                         1031 | ;   SAVE CREATES DISK FILE FROM MEMORY
                         1032 | ;   STARTING AT 0100H.  256 BYTE PAGES
                         1033 | ;     FILENAME MUST BE UNCONDITIONAL
                         1034 | ;   IF A FILE OF THE SAME NAME & TYPE
                         1035 | ;     ALREADY EXISTS, IT IS ERASED.
                         1036 | ;   **********************************
                         1037 | ;
E9AD: CD F8 E7           1038 | SAVE:   CALL    DECIML  ;GET THE NUMBER OF PAGES TO BE SAVED
E9B0: F5                 1039 |     PUSH    PSW ;
E9B1: CD 5E E6           1040 |     CALL    TRFCB   ;SET UP THE FILE NAME
E9B4: C2 09 E6           1041 |     JNZ WHAT    ;Cannot be ambigous file
E9B7: CD 54 E8           1042 |     CALL    SETTRD  ;SET UP DISK
E9BA: 11 CD EB           1043 |     LXI D,FCB   ;
E9BD: D5                 1044 |     PUSH    D   ;
E9BE: CD EF E4           1045 |     CALL    DELETF  ;DELETE OLD FILE OF SAME NAME
E9C1: D1                 1046 |     POP D   ;
E9C2: CD 09 E5           1047 |     CALL    CREATE  ;CREATE A NEW FILE IN DIRECTORY
E9C5: CA FB E9           1048 |     JZ  SAVE3   ;
E9C8: AF                 1049 |     XRA A   ;
E9C9: 32 ED EB           1050 |     STA FCB+32  ;ZERO OUT SECTOR COUNTER
E9CC: F1                 1051 |     POP PSW ;
E9CD: 6F                 1052 |     MOV L,A ;
E9CE: 26 00              1053 |     MVI H,00H   ;CHECK PAGE COUNTER


