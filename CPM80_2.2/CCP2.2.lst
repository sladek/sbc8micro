                          588 | ;
                          589 | ;   COMMAND SEARCH
                          590 | ;
                          591 | ;   Try to match command name starting at FCB + 1
                          592 | ;   with those in the intrinsic command list.
                          593 | ;   Exit with command number (0 to 5) in (A) if a
                          594 | ;   match has been made, else exit with a 6 in (A)
                          595 | ;   signifying that this may be a transient command.
                          596 | ;
E72E: 21 10 E7            597 | CSRCH:  LXI H,CMNDL ; Point to start of command list.
E731: 0E 00               598 |     MVI C,00H   ; Zero out command counter.
E733: 79                  599 | CSRCH1: MOV A,C ; Check counter for maximum number of tries.
E734: FE 06               600 |     CPI 6   ;(There are 6 intrinsic commands + transients)
E736: D0                  601 |     RNC     ; Return is no match in six tries. It is a transient command.
E737: 11 CE EB            602 |     LXI D,FCB+1 ; Point to start of command to be matched.
E73A: 06 04               603 |     MVI B,04H   ; Maximum number of characters in command name.
E73C: 1A                  604 | CSRCH2: LDAX    D   ;
E73D: BE                  605 |     CMP M   ;


