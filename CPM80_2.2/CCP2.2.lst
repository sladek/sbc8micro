                          449 | ;
                          450 | ;   TRANSFER FILE CONTROL BLOCK
                          451 | ;   This is a key subroutine that handles all
                          452 | ;   of the setting up of file control blocks
                          453 | ;   and of moving around the control buffer.
                          454 | ;
                          455 | ;   No entry parameters are passed in registers
                          456 | ;   On exit (A) contains a count of the number of
                          457 | ;   '?' wildcards in file control block and ZFLAG
                          458 | ;   is set if this count =0 and FCB contains the
                          459 | ;   file block. The input buffer pointer has been
                          460 | ;   advanced to one beyond end of information used.
                          461 | ;
                          462 | ;   This subroutine is not only used to set up
                          463 | ;   file control blocks, but also the numbers
                          464 | ;   for SAVE and USER.
                          465 | ;
E65E: 3E 00               466 | TRFCB:  MVI A,00H   ;Initial offset=0, primary entry point
E660: 21 CD EB            467 | TRFCB1: LXI H,FCB   ;(Alternate entry point, offset in (A))
E663: CD 59 E6            468 |     CALL    ADDAH   ;Point to current character in FCB
