                          847 |     ;(NOTE: Change  this command to MOV  A,M and save 2 bytes)
E874: C3 BD E4            848 |     JMP SELDSK  ;  so go make change
                          849 | ;
                          850 | ;   START OF INTRINSIC COMMANDS
                          851 | ;
                          852 | ;   *******************************
                          853 | ;   DIR SEARCHES FILE DIRECTORY FOR
                          854 | ;   FILES BY FILE NAME OR FILE TYPE
                          855 | ;        ? MATCHES ANY LETTER
                          856 | ;   * MATCHES THE WHOLE FILENAME OR
                          857 | ;             FILETYPE
                          858 | ;   *******************************
                          859 | ;
                          860 | ;   NOTE ON SYSTEM FILES:
                          861 | ;   'System' type files are rendered invisible to the
                          862 | ;   DIR command because the MSB of the second byte of
                          863 | ;   the file ext is set. A minor change in the following
                          864 | ;   code could make these files listable in the Directory
                          865 | ;
E877: CD 5E E6            866 | DIR:    CALL    TRFCB   ; TRANSFER THE COMMAND LINE INTO 005CH.
E87A: CD 54 E8            867 |     CALL    SETTRD  ; SET TO TRANSIENT DISK
E87D: 21 CE EB            868 |     LXI H,FCB+1 ; POINT TO START OF FILE NAME
E880: 7E                  869 |     MOV A,M ; CHECK FOR A BLANK
E881: FE 20               870 |     CPI 20H ;' '
E883: C2 8F E8            871 |     JNZ DIR1    ; NOT BLANK, GO FIND WHAT IS WANTED.
                          872 | ;
E886: 06 0B               873 |     MVI B,11    ; BLANK ::= DISPLAY ENTIRE DIRECTORY
E888: 36 3F               874 | DIR0:   MVI M,3FH   ; FILL ENTIRE FILENAME/TYPE ARE WITH WILDCARD [?]'?'
E88A: 23                  875 |     INX H   ;
E88B: 05                  876 |     DCR B   ;
E88C: C2 88 E8            877 |     JNZ DIR0    ;
                          878 | ;
E88F: 1E 00               879 | DIR1:   MVI E,00H   ; SEARCH FOR FILE.
E891: D5                  880 |     PUSH    D   ;
E892: CD E9 E4            881 |     CALL    SRCHF1  ;
E895: CC EA E7            882 |     CZ  NFERR   ; <NOT FOUND> ERROR
E898: CA 1B E9            883 | DIR2:   JZ  DIR10   ;
E89B: 3A EE EB            884 |     LDA RETVAL  ;Get directory entry number
E89E: 0F                  885 |     RRC     ;Convert to directory block pointer
E89F: 0F                  886 |     RRC     ;by multiplying by 32 and masking off
E8A0: 0F                  887 |     RRC     ;the excess
E8A1: E6 60               888 |     ANI 60H ;
E8A3: 4F                  889 |     MOV C,A ;Stash block pointer
E8A4: 3E 0A               890 |     MVI A,10    ;
E8A6: CD 4B E8            891 |     CALL    DIRPTR  ;Get character @ DDMA + block pointer + 10 = Second char of ext


