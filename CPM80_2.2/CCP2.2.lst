                          957 | ;
                          958 | ;   ******************************************************
                          959 | ;   ERASE FILES FROM DISK
                          960 | ;
                          961 | ;   '*' and '?' can be used the same as in 'DIR'
                          962 | ;   Does not actually wipe out information from the disk,
                          963 | ;   but merely has the first byte of the file control block
                          964 | ;   set to 0E5H. This routine in CCP merely sets up the
                          965 | ;   file names to be erased; the real work is done by BDOS
                          966 | ;   ******************************************************
                          967 | ;
E91F: CD 5E E6            968 | ERA:    CALL    TRFCB   ;Set up the file control block
E922: FE 0B               969 |     CPI 11  ;If 11 '?' are in the FCB then you are
E924: C2 42 E9            970 |     JNZ ERA1    ;asking to erase the whole disk. *.*
E927: 01 52 E9            971 |     LXI B,MSG3  ;Ask for verification before proceeding
E92A: CD A7 E4            972 |     CALL    CRMSG   ;
E92D: CD 39 E5            973 |     CALL    CMNDIN  ;Get keyboard entry
E930: 21 07 E4            974 |     LXI H,INBLEN    ;check for return without entry
E933: 35                  975 |     DCR M   ;
E934: C2 82 E7            976 |     JNZ NXTCMD  ;Abort on empty line
E937: 23                  977 |     INX H   ;
E938: 7E                  978 |     MOV A,M ;
E939: FE 59               979 |     CPI 'Y' ;Yes, proceed with erasing everything
E93B: C2 82 E7            980 |     JNZ NXTCMD  ;Chickened out
E93E: 23                  981 |     INX H   ;
E93F: 22 88 E4            982 |     SHLD    BPTR1   ;
E942: CD 54 E8            983 | ERA1:   CALL    SETTRD  ;set the transient disk
E945: 11 CD EB            984 |     LXI D,FCB   ;Point to the file control block
E948: CD EF E4            985 |     CALL    DELETF  ;Call the routine that calls th e BDOS erase
E94B: 3C                  986 |     INR A   ;Check the return parameter
E94C: CC EA E7            987 |     CZ  NFERR   ;Warn if item not found
E94F: C3 86 EB            988 |     JMP COMEND  ;EXIT
                          989 | ;
E952: 41 4C 4C 20 28...   990 | MSG3:   DB  'ALL (Y/N)?',0
                          991 | ;
                          992 | ;   ***********************************
                          993 | ;   OUTPUT NAMED FILE TO THE CONSOLE
                          994 | ;   File name.ext must be unconditional
                          995 | ;   ***********************************
                          996 | ;
E95D: CD 5E E6            997 | TYPE:   CALL    TRFCB   ;Set up file name in FCB
E960: C2 09 E6            998 |     JNZ WHAT    ;Badly formed filename: ambigous
E963: CD 54 E8            999 |     CALL    SETTRD  ;Set the disk
E966: CD D0 E4           1000 |     CALL    OPENF1  ;Open the file for reading
E969: CA A7 E9           1001 |     JZ  TYPE4   ;Error on opening
E96C: CD 98 E4           1002 |     CALL    PCRLF   ;
E96F: 21 F1 EB           1003 |     LXI H,TYPCTR    ;Initiate counter


