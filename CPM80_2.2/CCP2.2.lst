E91C: C3 86 EB            948 |     JMP COMEND  ;EXIT
                          949 | ;
                          950 | ;   ******************************************************
                          951 | ;   ERASE FILES FROM DISK
                          952 | ;
                          953 | ;   '*' and '?' can be used the same as in 'DIR'
                          954 | ;   Does not actually wipe out information from the disk,
                          955 | ;   but merely has the first byte of the file control block
                          956 | ;   set to 0E5H. This routine in CCP merely sets up the
                          957 | ;   file names to be erased; the real work is done by BDOS
                          958 | ;   ******************************************************
                          959 | ;
E91F: CD 5E E6            960 | ERA:    CALL    TRFCB   ;Set up the file control block
E922: FE 0B               961 |     CPI 11  ;If 11 '?' are in the FCB then you are
E924: C2 42 E9            962 |     JNZ ERA1    ;asking to erase the whole disk. *.*
E927: 01 52 E9            963 |     LXI B,MSG3  ;Ask for verification before proceeding
E92A: CD A7 E4            964 |     CALL    CRMSG   ;
E92D: CD 39 E5            965 |     CALL    CMNDIN  ;Get keyboard entry
E930: 21 07 E4            966 |     LXI H,INBLEN    ;check for return without entry
E933: 35                  967 |     DCR M   ;
E934: C2 82 E7            968 |     JNZ NXTCMD  ;Abort on empty line
E937: 23                  969 |     INX H   ;
E938: 7E                  970 |     MOV A,M ;
E939: FE 59               971 |     CPI 'Y' ;Yes, proceed with erasing everything
E93B: C2 82 E7            972 |     JNZ NXTCMD  ;Chickened out
E93E: 23                  973 |     INX H   ;
E93F: 22 88 E4            974 |     SHLD    BPTR1   ;
E942: CD 54 E8            975 | ERA1:   CALL    SETTRD  ;set the transient disk
E945: 11 CD EB            976 |     LXI D,FCB   ;Point to the file control block
E948: CD EF E4            977 |     CALL    DELETF  ;Call the routine that calls th e BDOS erase
E94B: 3C                  978 |     INR A   ;Check the return parameter
E94C: CC EA E7            979 |     CZ  NFERR   ;Warn if item not found
E94F: C3 86 EB            980 |     JMP COMEND  ;EXIT
                          981 | ;
E952: 41 4C 4C 20 28...   982 | MSG3:   DB  'ALL (Y/N)?',0
                          983 | ;
                          984 | ;   ***********************************
                          985 | ;   OUTPUT NAMED FILE TO THE CONSOLE
                          986 | ;   File name.ext must be unconditional
                          987 | ;   ***********************************
                          988 | ;
E95D: CD 5E E6            989 | TYPE:   CALL    TRFCB   ;Set up file name in FCB
E960: C2 09 E6            990 |     JNZ WHAT    ;Badly formed filename: ambigous
E963: CD 54 E8            991 |     CALL    SETTRD  ;Set the disk
E966: CD D0 E4            992 |     CALL    OPENF1  ;Open the file for reading
E969: CA A7 E9            993 |     JZ  TYPE4   ;Error on opening
E96C: CD 98 E4            994 |     CALL    PCRLF   ;
E96F: 21 F1 EB            995 |     LXI H,TYPCTR    ;Initiate counter
E972: 36 FF               996 |     MVI M,0FFH  ;
E974: 21 F1 EB            997 | TYPE1:  LXI H,TYPCTR    ;


