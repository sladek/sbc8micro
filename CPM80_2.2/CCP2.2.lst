                           23 | ;
                           24 | ;   EQUATES
                           25 | ;
                           26 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                           27 | ;
                           28 | ;
                           29 | BDOS_SYS    EQU 0005H   ;Link to operating system
                           30 | IOBYTE  EQU 0003H   ;I/O assigment byte for transient programs
                           31 | LOGIN   EQU 0004H   ;User number and disk number for transient programs
                           32 | DFCB    EQU 005CH   ;Default file control block
                           33 | TPA EQU 0100H   ;Start of transient program area
                           34 | DDMA    EQU 0080H   ;Default DMA block
                           35 | SECLEN  EQU 0080H   ;Sector length := 128 bytes.
                           36 | ;
                           37 | ;   SERIAL NUMBERS
                           38 | ;
                           39 | VER EQU 2   ;CPM VERSION
                           40 | REL EQU 2   ;CPM RELEASE
                           41 | REV EQU 00  ;USER REVISION
                           42 | SNH EQU 00  ;SERIAL NUMBER, HIGH
                           43 | SNL EQU 00  ;SERIAL NUMBER, LOW
                           44 | ;
                           45 | ;   NOTE:
                           46 | ;       USER MUST INSERT CORRECT SERIAL NUMBER
                           47 | ;       IN THE FORMAT HH-LLLL, WHERE HH IS TWO
                           48 | ;       DIGITS & LLLL IS FOUR DIGITS. IF THE
                           49 | ;       SERIAL NUMBERS IN CCP/CPM AND BDOS/CPM
                           50 | ;       DO NOT MATCH, YOU WILL BOMB OUT WHEN
                           51 | ;       LOADING A TRANSIENT PROGRAM.


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

                           52 | ;
                           53 | ;
                           54 |     ORG CCP ;SET PROGRAM START
                           55 | ;
                           56 | ;   NOTE:
                           57 | ;       On entry (C) contains the user number in the
                           58 | ;       upper 4 bits, and the current logged in disk
                           59 | ;       number in to lower 4 bits. This is why you log
                           60 | ;       back to disk B: if you rebooted while logged
                           61 | ;       into B:
                           62 | ;
E400: C3 5C E7             63 | ORIGIN: JMP CCP1    ;JUMP TO START OF CONSOLE COMMAND PROGRAM
                           64 | ;
E403: C3 58 E7             65 |     JMP CCP0    ;JUMP TO START OF CCP W/ CLEARING OF INPUT BUFFER COUNTER
                           66 | ;
                           67 | ;   INPUT BUFFER WITH COPYRIGHT MESSAGE THROWN IN
                           68 | ;
E406: 7F                   69 | INPB:   DB  127 ;MAXIMUM LENGTH OF INPUT BUFFER
E407: 00                   70 | INBLEN: DB  0   ;CURRENT LENGTH OF INPUT BUFFER
E408: 20 20 20 20 20...    71 | BUFFER: DB  '                '
E418: 43 4F 50 59 52...    72 |     DB  'COPYRIGHT (C) 1979, '
E42C: 44 49 47 49 54...    73 |     DB  'DIGITAL RESEARCH  '
E43E:                      74 |     DS  BUFFER+128-$
                           75 | ;
                           76 | ;   POINTERS TO INPUT BUFFER
                           77 | ;
E488: 08 E4                78 | BPTR1:  DW  BUFFER  ;Pointer to input buffer used while parsing input line
E48A: 00 00                79 | BPTR2:  DW  0000H   ;Pointer to start of current command inn input buffer.
                           80 |             ;Used by WHAT for error prompt.
                           81 | ;   ***************
                           82 | ;   SUBROUTINE AREA
                           83 | ;   ***************
                           84 | ;
                           85 | ;   TIES TO BDOS VIA VECTOR IN 0005H
                           86 | ;
                           87 | ;   NOTE:
                           88 | ;       The code in this section could be cleaned up
                           89 | ;       shortened by rearranging things to have the
                           90 | ;       code flow from one segment to the next
                           91 | ;       instead of jumping back.
                           92 | ;
E48C: 5F                   93 | OUTPUT: MOV E,A ;OUTPUT 1 BYTE TO CONSOLE
E48D: 0E 02                94 |     MVI C,02H   ;
E48F: C3 05 00             95 |     JMP BDOS_SYS    ;
                           96 | ;
                           97 | ;   NOTE:
                           98 | ;       Why not include OUTPUT inside of PCHAR and
                           99 | ;       thus eliminate an- extra call?
                          100 | ;       The only other call to OUTPUT is in PMSG,
                          101 | ;       which should be changed anyway.
                          102 | ;
                          103 | ;PCHAR: PUSH    B   ;
                          104 | ;   MOV E,A ;
                          105 | ;   MVI C,02H   ;
                          106 | ;   CALL    BDOS_SYS    ;
                          107 | ;   POP B   ;


Assembly Listing                                                                                                 Page: 3
------------------------------------------------------------------------------------------------------------------------

                          108 | ;   RET     ;
                          109 | ;
E492: C5                  110 | PCHAR:  PUSH    B   ;PRINT A CHARACTER ON THE CONSOLE
E493: CD 8C E4            111 |     CALL    OUTPUT  ;
E496: C1                  112 |     POP B   ;
E497: C9                  113 |     RET     ;
                          114 | ;
E498: 3E 0D               115 | PCRLF:  MVI A,0DH   ;PRINT A CARRIAGE RETURN & LINE FEED
E49A: CD 92 E4            116 |     CALL    PCHAR   ;
E49D: 3E 0A               117 |     MVI A,0AH   ;
E49F: C3 92 E4            118 |     JMP PCHAR   ;
                          119 | ;
E4A2: 3E 20               120 | SPACE:  MVI A,20H   ;PRINT A SPACE
E4A4: C3 92 E4            121 |     JMP PCHAR   ;
                          122 | ;
E4A7: C5                  123 | CRMSG:  PUSH    B   ;PRINT A STRING PRECEDED BY A CR/LF
E4A8: CD 98 E4            124 |     CALL    PCRLF   ;
E4AB: E1                  125 |     POP H   ;
                          126 | ;
                          127 | ;   This code could be shortened by terminating the
                          128 | ;   error code strings with a '$' and using BDOS
                          129 | ;   command 9.
                          130 | ;
E4AC: 7E                  131 | PMSG:   MOV A,M ;PRINT A STRING TERMINATED BY A NULL
E4AD: B7                  132 |     ORA A   ;
E4AE: C8                  133 |     RZ      ;
E4AF: 23                  134 |     INX H   ;
E4B0: E5                  135 |     PUSH    H   ;
E4B1: CD 8C E4            136 |     CALL    OUTPUT  ;
E4B4: E1                  137 |     POP H   ;
E4B5: C3 AC E4            138 |     JMP PMSG    ;
                          139 | ;
E4B8: 0E 0D               140 | RESET:  MVI C,0DH   ;RESET THE DISK SYSTEM
E4BA: C3 05 00            141 |     JMP BDOS_SYS    ;
                          142 | ;
E4BD: 5F                  143 | SELDSK: MOV E,A ;SELECT DISK
E4BE: 0E 0E               144 |     MVI C,0EH   ;
E4C0: C3 05 00            145 |     JMP BDOS_SYS    ;
                          146 | ;
E4C3: CD 05 00            147 | BDOS1:  CALL    BDOS_SYS    ; CALL TO BDOS W/ RETURN VALUE SAVED
E4C6: 32 EE EB            148 |     STA RETVAL  ;
E4C9: 3C                  149 |     INR A   ;Set the ZFLAG for error condition
E4CA: C9                  150 |     RET     ;
                          151 | ;
E4CB: 0E 0F               152 | OPENF:  MVI C,0FH   ;OPEN DISK FILE FOR READING OR WRITING
E4CD: C3 C3 E4            153 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          154 | ;
E4D0: AF                  155 | OPENF1: XRA A   ;OPEN FILE @ FCB, AND ZERO RECORD COUNTER
E4D1: 32 ED EB            156 |     STA FCB+32  ;
E4D4: 11 CD EB            157 |     LXI D,FCB   ;
E4D7: C3 CB E4            158 |     JMP OPENF   ;
                          159 | ;
E4DA: 0E 10               160 | CLOSEF: MVI C,10H   ;CLOSE FILE AFTER READING OR WRITING
E4DC: C3 C3 E4            161 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          162 | ;
E4DF: 0E 11               163 | SRCHF:  MVI C,11H   ;SEARCH FOR FIRST OCCURENCE OF FILE NAME


Assembly Listing                                                                                                 Page: 4
------------------------------------------------------------------------------------------------------------------------

E4E1: C3 C3 E4            164 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          165 | ;
E4E4: 0E 12               166 | SRCHNX: MVI C,12H   ;SEARCH FOR NEXT OCCURENCE OF FILE NAME
E4E6: C3 C3 E4            167 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          168 | ;
E4E9: 11 CD EB            169 | SRCHF1: LXI D,FCB   ;SEARCH FOR FIRST OCCURENCE OF FILE
E4EC: C3 DF E4            170 |     JMP SRCHF   ; NAME USING (FCB).
                          171 | ;
E4EF: 0E 13               172 | DELETF: MVI C,13H   ;DELETE FILE FROM DIRECTORY
E4F1: C3 05 00            173 |     JMP BDOS_SYS    ;
                          174 | ;
E4F4: CD 05 00            175 | BDOS2:  CALL    BDOS_SYS    ; CALL TO BDOS W/ RETURN VALUE
E4F7: B7                  176 |     ORA A   ;
E4F8: C9                  177 |     RET     ;
                          178 | ;
E4F9: 0E 14               179 | READF:  MVI C,14H   ;READ ONE SECTOR FROM DISK
E4FB: C3 F4 E4            180 |     JMP BDOS2   ; CALL TO BDOS W/ RETURN VALUE
                          181 | ;
E4FE: 11 CD EB            182 | READ1:  LXI D,FCB   ;READ ONE SECTOR USING 'FCB'
E501: C3 F9 E4            183 |     JMP READF   ;
                          184 | ;
E504: 0E 15               185 | WRITEF: MVI C,15H   ;WRITE ONE SECTOR TO DISK
E506: C3 F4 E4            186 |     JMP BDOS2   ; CALL TO BDOS W/ RETURN VALUE
                          187 | ;
E509: 0E 16               188 | CREATE: MVI C,16H   ;CREATE A NEW FILE NAME IN DISK DIRECTORY
E50B: C3 C3 E4            189 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          190 | ;
E50E: 0E 17               191 | RENAME: MVI C,17H   ;RENAME EXISTING FILE IN DISK DIRECTORY
E510: C3 05 00            192 |     JMP BDOS_SYS    ;
                          193 | ;
E513: 1E FF               194 | GETUSR: MVI E,0FFH  ;GET CURRENT USER NUMBER
                          195 | ;
                          196 | ;   SET USER NUMBER TO VALUE IN (E), EXCEPT IF
                          197 | ;   VALUE IS 0FFH.
                          198 | ;
E515: 0E 20               199 | SETUSR: MVI C,20H   ;
E517: C3 05 00            200 |     JMP BDOS_SYS    ;
                          201 | ;
                          202 | ;   Set log-in byte for transient program with current
                          203 | ;   user number in upper 4 bits and current drive in
                          204 | ;   lower 4 bits.
                          205 | ;
E51A: CD 13 E5            206 | SETLOG: CALL    GETUSR  ; SET LOG-IN BYTE W/ CURRENT DRIVE & USER NUMBER
E51D: 87                  207 |     ADD A   ;
E51E: 87                  208 |     ADD A   ;
E51F: 87                  209 |     ADD A   ;
E520: 87                  210 |     ADD A   ;Shift user number to upper nibble
E521: 21 EF EB            211 |     LXI H,CURDSK    ;
E524: B6                  212 |     ORA M   ;Combine with disk number
E525: 32 04 00            213 |     STA LOGIN   ;Place where transient programs
E528: C9                  214 |     RET     ;  can find it.
                          215 | ;
                          216 | ;   LOG IN CURRENT DISK
                          217 | ;   Place current drive number in log-in byte without
                          218 | ;   including user number.
                          219 | ;


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

E529: 3A EF EB            220 | LOGCUR: LDA CURDSK  ;
E52C: 32 04 00            221 |     STA LOGIN   ;
E52F: C9                  222 |     RET     ;
                          223 | ;
                          224 | ;   CONVERT lower case INPUT TO UPPER CASE
                          225 | ;
E530: FE 61               226 | LCUC:   CPI 61H ;'a'
E532: D8                  227 |     RC      ;
E533: FE 7B               228 |     CPI 7BH ;'z'+1
E535: D0                  229 |     RNC     ;
E536: E6 5F               230 |     ANI 5FH ;MASK OFF BIT 5
E538: C9                  231 |     RET     ;
                          232 | ;
                          233 | ;   COMMAND INPUT
                          234 | ;
                          235 | ;   IF SUBMIT FLAG <> 0 THEN INPUT FROM SUBMIT FILE\
                          236 | ;       ELSE INPUT FROM KEYBOARD INPUT BUFFER
                          237 | ;
E539: 3A AB EB            238 | CMNDIN: LDA SUBFL   ;CHECK SUBMIT FILE FLAG
E53C: B7                  239 |     ORA A   ;
E53D: CA 96 E5            240 |     JZ  LINEIN  ;FLAG RESET: GET INPUT FROM KEYBOARD
                          241 | ;
                          242 | ;   NOTE ABOUT SUBMIT FILES:
                          243 | ;
                          244 | ;   When the command SUBMIT <filename>
                          245 | ;   is given, a file named $$$.SUB is compiled with
                          246 | ;   one command line per record in the file.
                          247 | ;   the file is unusual in that the commands are stored
                          248 | ;   in reverse order. This makes it simple for the
                          249 | ;   following code to pull one command off at a time,
                          250 | ;   erasing as it goes. Note that the sector counter is
                          251 | ;   decremented and the file closed each time.
                          252 | ;   When the last command has been executed, or if an
                          253 | ;   error is encountered, the $$$.SUB file is erased
                          254 | ;   and control reverts to the keyboard for input.
                          255 | ;
E540: 3A EF EB            256 |     LDA CURDSK  ;FLAG SET: GET INPUT FROM SUBMIT FILE ON CURRENT DISK
E543: B7                  257 |     ORA A   ;
E544: 3E 00               258 |     MVI A,00H   ;
E546: C4 BD E4            259 |     CNZ SELDSK  ;Set to disk 0 if not there already
E549: 11 AC EB            260 |     LXI D,SUBFCB    ; Point to submit file's file control block
E54C: CD CB E4            261 |     CALL    OPENF   ; Open the submit file for reading
E54F: CA 96 E5            262 |     JZ  LINEIN  ;Go to console on Open File Error
E552: 3A BB EB            263 |     LDA SUBFCB+15   ;Get top sector number
E555: 3D                  264 |     DCR A   ;Decrement? Yes $$$.SUB files are backwards
E556: 32 CC EB            265 |     STA SUBFCB+32   ;Put number in Next Sector slot
E559: 11 AC EB            266 |     LXI D,SUBFCB    ;
E55C: CD F9 E4            267 |     CALL    READF   ;Read sector into buffer
E55F: C2 96 E5            268 |     JNZ LINEIN  ;Go to console on read error
E562: 11 07 E4            269 |     LXI D,INBLEN    ;Point to start of keyboard buffer
E565: 21 80 00            270 |     LXI H,DDMA  ;Point to start of default buffer
E568: 06 80               271 |     MVI B,SECLEN    ;Set counter
E56A: CD 42 E8            272 |     CALL    BLKMOV  ;Move line into keyboard buffer
E56D: 21 BA EB            273 |     LXI H,SUBFCB+14 ;
E570: 36 00               274 |     MVI M,00H   ;
E572: 23                  275 |     INX H   ;


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

E573: 35                  276 |     DCR M   ;Decrement sector count
E574: 11 AC EB            277 |     LXI D,SUBFCB    ;close the file
E577: CD DA E4            278 |     CALL    CLOSEF  ;
E57A: CA 96 E5            279 |     JZ  LINEIN  ;Go to console on close error
E57D: 3A EF EB            280 |     LDA CURDSK  ;
E580: B7                  281 |     ORA A   ;
E581: C4 BD E4            282 |     CNZ SELDSK  ;Set to current disk if not so already
E584: 21 08 E4            283 |     LXI H,BUFFER    ;
E587: CD AC E4            284 |     CALL    PMSG    ;Echo the $$$.SUB line to console
E58A: CD C2 E5            285 |     CALL    KSTAT   ;Check for a keyboard break
E58D: CA A7 E5            286 |     JZ  LINP1   ;NO BREAK- Continue
E590: CD DD E5            287 |     CALL    EXITSB  ; BREAK- Close off submit mode
E593: C3 82 E7            288 |     JMP NXTCMD  ;This leaves the return address on the
                          289 |             ;stack, but NXTCMD re-initializes stack
                          290 | ;
                          291 | ;   Get the input from the Console Device
                          292 | ;
E596: CD DD E5            293 | LINEIN: CALL    EXITSB  ;RESET SUBMIT MODE FLAGS< ETC
E599: CD 1A E5            294 |     CALL    SETLOG  ; SET LOG-IN BYTE W/ CURRENT DRIVE & USER NUMBER
E59C: 0E 0A               295 |     MVI C,0AH   ;BDOS COMMAND 10 ::= READ INPUT BUFFER
E59E: 11 06 E4            296 |     LXI D,INPB  ;POINT TO START OF INPUT BUFFER
E5A1: CD 05 00            297 |     CALL    BDOS_SYS    ;GET A LINE FROM THE CONSOLE
E5A4: CD 29 E5            298 |     CALL    LOGCUR  ;
E5A7: 21 07 E4            299 | LINP1:  LXI H,INBLEN    ;
E5AA: 46                  300 |     MOV B,M ;Move the line byte count into (B)
E5AB: 23                  301 | LINP2:  INX H   ;Step through buffer changing lower
E5AC: 78                  302 |     MOV A,B ;case into upper case.
E5AD: B7                  303 |     ORA A   ;
E5AE: CA BA E5            304 |     JZ  LINP3   ;Exit when (B)=0
E5B1: 7E                  305 |     MOV A,M ;
E5B2: CD 30 E5            306 |     CALL    LCUC    ;Convert lower case to UPPER CASE
E5B5: 77                  307 |     MOV M,A ;
E5B6: 05                  308 |     DCR B   ;
E5B7: C3 AB E5            309 |     JMP LINP2   ;Loop
                          310 | ;
E5BA: 77                  311 | LINP3:  MOV M,A ;Poke a zero into end of line to mark end
E5BB: 21 08 E4            312 |     LXI H,BUFFER    ;Save command starting address
E5BE: 22 88 E4            313 |     SHLD    BPTR1   ; for later use.
E5C1: C9                  314 |     RET     ;
                          315 | ;
                          316 | ;   KEYBOARD STATUS CHECK
                          317 | ;   Return with ZFLAG set is no key pressed
                          318 | ;   Else return with character in accumulator
                          319 | ;
E5C2: 0E 0B               320 | KSTAT:  MVI C,0BH   ;
E5C4: CD 05 00            321 |     CALL    BDOS_SYS    ;
E5C7: B7                  322 |     ORA A   ;
E5C8: C8                  323 |     RZ      ;
E5C9: 0E 01               324 |     MVI C,01H   ;
E5CB: CD 05 00            325 |     CALL    BDOS_SYS    ;
E5CE: B7                  326 |     ORA A   ;
E5CF: C9                  327 |     RET     ;
                          328 | ;
                          329 | ;   INTEROGATE THE DISK
                          330 | ;
E5D0: 0E 19               331 | INTDSK: MVI C,19H   ;


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

E5D2: C3 05 00            332 |     JMP BDOS_SYS    ;
                          333 | ;
                          334 | ;   SET THE DMA ADDRESS
                          335 | ;
E5D5: 11 80 00            336 | SETDMA: LXI D,DDMA  ;
E5D8: 0E 1A               337 | STDMA1: MVI C,1AH   ;
E5DA: C3 05 00            338 |     JMP BDOS_SYS    ;
                          339 | ;
                          340 | ;   EXIT THE SUBMIT MODE
                          341 | ;   Check to see if the Submit flag is set
                          342 | ;   and reset it, along with the disk selection
                          343 | ;   Erase any $$$.SUB file that may be in the directory
                          344 | ;
E5DD: 21 AB EB            345 | EXITSB: LXI H,SUBFL ;SUBMIT FILE FLAG
E5E0: 7E                  346 |     MOV A,M ;
E5E1: B7                  347 |     ORA A   ;
E5E2: C8                  348 |     RZ      ;Not in submit mode, exit
E5E3: 36 00               349 |     MVI M,00H   ;Reset submit flag
E5E5: AF                  350 |     XRA A   ;
E5E6: CD BD E4            351 |     CALL    SELDSK  ;Select correct disk
E5E9: 11 AC EB            352 |     LXI D,SUBFCB    ;
E5EC: CD EF E4            353 |     CALL    DELETF  ;Delete the $$$.SUB file from disk
E5EF: 3A EF EB            354 |     LDA CURDSK  ;
E5F2: C3 BD E4            355 |     JMP SELDSK  ;Restore current disk and exit
                          356 | ;
                          357 | ;   COMPARE SERIAL NUMBERS
                          358 | ;   Serial numbers of CCP and BDOS are
                          359 | ;   compared. If there is no match, you
                          360 | ;   are banished to Digital Siberia.
                          361 | ;   This S/R is called before a transient
                          362 | ;   program is loaded into the TPA.
                          363 | ;
E5F5: 11 28 E7            364 | CMPSER: LXI D,SERNO ;Point to serial no in CCP
E5F8: 21 06 EC            365 |     LXI H,BDOS  ;Point to serial no in BDOS
E5FB: 06 06               366 |     MVI B,6 ;Number of bytes to compared
E5FD: 1A                  367 | CMPSN1: LDAX    D   ;
E5FE: BE                  368 |     CMP M   ;
E5FF: C2 CF E7            369 |     JNZ FATAL   ; OK, you've had it. You are locked out.
E602: 13                  370 |     INX D   ;
E603: 23                  371 |     INX H   ;
E604: 05                  372 |     DCR B   ;
E605: C2 FD E5            373 |     JNZ CMPSN1  ;
E608: C9                  374 |     RET     ; Good comparison. You are home free
                          375 | ;
                          376 | ;   GENERAL PURPOSE ERROR HANDLING ROUTINE
                          377 | ;   Anything that you do wrong in entering a
                          378 | ;   command lands you here. The command line
                          379 | ;   is typed back at you for your edification
                          380 | ;   and embarrassment. After you have been shown
                          381 | ;   a '?', you are put back in the command mode.
                          382 | ;
E609: CD 98 E4            383 | WHAT:   CALL    PCRLF   ;
E60C: 2A 8A E4            384 |     LHLD    BPTR2   ; Point to the offending command
E60F: 7E                  385 | WHAT1:  MOV A,M ; and print until a space or null is found
E610: FE 20               386 |     CPI ' ' ;
E612: CA 22 E6            387 |     JZ  WHAT2   ;


Assembly Listing                                                                                                 Page: 8
------------------------------------------------------------------------------------------------------------------------

E615: B7                  388 |     ORA A   ;
E616: CA 22 E6            389 |     JZ  WHAT2   ;
E619: E5                  390 |     PUSH    H   ;
E61A: CD 8C E4            391 |     CALL    OUTPUT  ;
E61D: E1                  392 |     POP H   ;
E61E: 23                  393 |     INX H   ;
E61F: C3 0F E6            394 |     JMP WHAT1   ;
                          395 | ;
E622: 3E 3F               396 | WHAT2:  MVI A,'?'   ; OK, what did you have in mind?
E624: CD 8C E4            397 |     CALL    OUTPUT  ;
E627: CD 98 E4            398 |     CALL    PCRLF   ;
E62A: CD DD E5            399 |     CALL    EXITSB  ;
E62D: C3 82 E7            400 |     JMP NXTCMD  ; Back for another command.
                          401 | ;
                          402 | ;   SPECIAL CHARACTER CHECK
                          403 | ;   Returns with ZFLAG set if any of the special
                          404 | ;   characters is found, or bombs you out if a
                          405 | ;   control character is found. Contains a useless
                          406 | ;   byte.
                          407 | ;
E630: 1A                  408 | CHRCHK: LDAX    D   ;
E631: B7                  409 |     ORA A   ;
E632: C8                  410 |     RZ      ;Exit on null
E633: FE 20               411 |     CPI ' ' ;
E635: DA 09 E6            412 |     JC  WHAT    ;Bomb out on control character
E638: C8                  413 |     RZ      ;
E639: FE 3D               414 |     CPI '=' ;
E63B: C8                  415 |     RZ      ;
E63C: FE 5F               416 |     CPI '_' ;
E63E: C8                  417 |     RZ      ;
E63F: FE 2E               418 |     CPI '.' ;
E641: C8                  419 |     RZ      ;
E642: FE 3A               420 |     CPI ':' ;
E644: C8                  421 |     RZ      ;
E645: FE 3B               422 |     CPI ';' ;
E647: C8                  423 |     RZ      ;
E648: FE 3C               424 |     CPI '<' ;
E64A: C8                  425 |     RZ      ;
E64B: FE 3E               426 |     CPI '>' ;
E64D: C8                  427 |     RZ      ; This command is redundant!
E64E: C9                  428 |     RET     ;
                          429 | ;
                          430 | ;   STEP (DE) UNTIL A NULL OR NON-SPACE IS FOUND
