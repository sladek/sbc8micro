                          630 | ;
                          631 | ;   ******************************
                          632 | ;   MAIN OPERATING ROUTINE FOR CCP
                          633 | ;   ******************************
                          634 | ;
                          635 | ;   Entry point number 1
                          636 | ;   Input buffer counter is zeroed out so no imbedded
                          637 | ;   command can be executed on initial boot up.
                          638 | ;
E758: AF                  639 | CCP0:   XRA A   ;
E759: 32 07 E4            640 |     STA INBLEN  ;
                          641 | ;
                          642 | ;
                          643 | ;   Entry point number 2
                          644 | ;   Entry a this point allows commands inbedded in
                          645 | ;   input buffer to be automatically executed
                          646 | ;   on initial boot up.
                          647 | ;
                          648 | ;   On entry (C) has user number in the high nibble
                          649 | ;   and the disk drive in the lower nibble
                          650 | ;
E75C: 31 00 00            651 | CCP1:   LXI SP,STACK    ;Set up loacal stack
E75F: C5                  652 |     PUSH    B   ;Save entry parameter
E760: 79                  653 |     MOV A,C ;
E761: 1F                  654 |     RAR     ;Move upper 4 bits down
E762: 1F                  655 |     RAR     ;
E763: 1F                  656 |     RAR     ;
E764: 1F                  657 |     RAR     ;
E765: E6 0F               658 |     ANI 0FH ;Extract user number from input parameter
E767: 5F                  659 |     MOV E,A ;
E768: CD 15 E5            660 |     CALL    SETUSR  ;Put user number in its place
E76B: CD B8 E4            661 |     CALL    RESET   ;Reset disk system
E76E: 32 AB EB            662 |     STA SUBFL   ;SUBMIT FILE FLAG
E771: C1                  663 |     POP B   ;Get back entry parameter
E772: 79                  664 |     MOV A,C ;
E773: E6 0F               665 |     ANI 0FH ;Extract disk drive number from input parameter
E775: 32 EF EB            666 |     STA CURDSK  ;Set to correct disk drive
E778: CD BD E4            667 |     CALL    SELDSK  ;


