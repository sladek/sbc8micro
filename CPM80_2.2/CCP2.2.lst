                          441 | ;
                          442 | ;   TRANSFER FILE CONTROL BLOCK
                          443 | ;   This is a key subroutine that handles all
                          444 | ;   of the setting up of file control blocks
                          445 | ;   and of moving around the control buffer.
                          446 | ;
                          447 | ;   No entry parameters are passed in registers
                          448 | ;   On exit (A) contains a count of the number of
                          449 | ;   '?' wildcards in file control block and ZFLAG
                          450 | ;   is set if this count =0 and FCB contains the
                          451 | ;   file block. The input buffer pointer has been
                          452 | ;   advanced to one beyond end of information used.
                          453 | ;
                          454 | ;   This subroutine is not only used to set up
                          455 | ;   file control blocks, but also the numbers
                          456 | ;   for SAVE and USER.
                          457 | ;
E65E: 3E 00               458 | TRFCB:  MVI A,00H   ;Initial offset=0, primary entry point
E660: 21 CD EB            459 | TRFCB1: LXI H,FCB   ;(Alternate entry point, offset in (A))
E663: CD 59 E6            460 |     CALL    ADDAH   ;Point to current character in FCB
E666: E5                  461 |     PUSH    H   ;
E667: E5                  462 |     PUSH    H   ;Save pointer twice.
E668: AF                  463 |     XRA A   ;
E669: 32 F0 EB            464 |     STA TRDISK  ;
E66C: 2A 88 E4            465 |     LHLD    BPTR1   ;Get current pointer to the input buffer
E66F: EB                  466 |     XCHG        ;
E670: CD 4F E6            467 |     CALL    STEP    ;Get first non-blank character
E673: EB                  468 |     XCHG        ;
E674: 22 8A E4            469 |     SHLD    BPTR2   ;Save pointer in case of error
E677: EB                  470 |     XCHG        ;
E678: E1                  471 |     POP H   ;Get FCB pointer
E679: 1A                  472 |     LDAX    D   ;
E67A: B7                  473 |     ORA A   ;Check for null command
E67B: CA 89 E6            474 |     JZ  TRFCB2  ;
E67E: DE 40               475 |     SBI 40H ;Remove ASCII bias.
E680: 47                  476 |     MOV B,A ;Save possible disk number in (B)
E681: 13                  477 |     INX D   ;
E682: 1A                  478 |     LDAX    D   ;
E683: FE 3A               479 |     CPI ':' ; This means that this is a disk number.
E685: CA 90 E6            480 |     JZ  TRFCB3  ; Go set transient disk.
E688: 1B                  481 |     DCX D   ; Get current logged in disk number.
E689: 3A EF EB            482 | TRFCB2: LDA CURDSK  ;
E68C: 77                  483 |     MOV M,A ;
E68D: C3 96 E6            484 |     JMP TRFCB4  ;
                          485 | ;
E690: 78                  486 | TRFCB3: MOV A,B ; Set transient disk number.
E691: 32 F0 EB            487 |     STA TRDISK  ;
E694: 70                  488 |     MOV M,B ; Put disk number into head of File Control Block.
E695: 13                  489 |     INX D   ;
                          490 | ;
                          491 | ;   Move file name of up to 8 characters into bytes
                          492 | ;   1 through 8 of FCB. Exit at reaching a special
                          493 | ;   character or a null. Pad excess with blanks.


