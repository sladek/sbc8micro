                         1166 | ;
                         1167 | ;   *************************************************
                         1168 | ;   TRANS LOADS A PROGRAM INTO THE TPA IF IT IS NOT A
                         1169 | ;   COMMAND NAME,  AND A PROPER  <FILENAME>.COM  FILE
                         1170 | ;         EXISTS ON THE TRANSIENT DISK.
                         1171 | ;   *************************************************
                         1172 | ;
EAA5: CD F5 E5           1173 | TRANS:  CALL    CMPSER  ; CHECK FOR A KOSHER SERIAL NUMBER. BOMB OUT IF NO GOOD.
EAA8: 3A CE EB           1174 |     LDA FCB+1   ; SPACE ::= NO FILE NAME PRESENT.
EAAB: FE 20              1175 |     CPI ' ' ;
EAAD: C2 C4 EA           1176 |     JNZ TRANS1  ;OK- Filename present
EAB0: 3A F0 EB           1177 |     LDA TRDISK  ;NG- Just clean things up and leave
EAB3: B7                 1178 |     ORA A   ;
EAB4: CA 89 EB           1179 |     JZ  CMEND1  ;EXIT IF ON THE LOGIN DISK
EAB7: 3D                 1180 |     DCR A   ;
EAB8: 32 EF EB           1181 |     STA CURDSK  ;OTHERWISE LOG BACK TO THE LOGIN DISK
                         1182 |     ; ORDER OF CALLS TO SELDSK AND LOGCUR HAS BEEN CHANGED HERE TO PREVENT
                         1183 |     ; ATTEMPT TO RETURN TO THE SAME DISK IF IT DOESN'T EXIST. sO FIRST WE
                         1184 |     ; TRY TO SELECT NEW DISK AND IF IF DOESN'T EXIST IT WILL END WITH ERROR
                         1185 |     ; AND REBOOT TO PRVIOUSLY SELECTED DISK
                         1186 |     ; CALL  LOGCUR  ; THIS IS MOVED AFTER CALL SELDSK
EABB: CD BD E4           1187 |     CALL    SELDSK  ;
EABE: CD 29 E5           1188 |     CALL    LOGCUR  ;
EAC1: C3 89 EB           1189 |     JMP CMEND1  ;AND GO BACK FOR ANOTHER COMMAND
                         1190 | ;
EAC4: 11 D6 EB           1191 | TRANS1: LXI D,FCB+9 ; CHECK THE FILE TYPE.
EAC7: 1A                 1192 |     LDAX    D   ;
EAC8: FE 20              1193 |     CPI ' ' ;
EACA: C2 09 E6           1194 |     JNZ WHAT    ; YOU'RE NOT SUPPOSED TO HAVE A FILE TYPE W/ A TRANSIENT.
EACD: D5                 1195 |     PUSH    D   ;
EACE: CD 54 E8           1196 |     CALL    SETTRD  ; SET TO TRANSIENT DRIVE.
EAD1: D1                 1197 |     POP D   ;
EAD2: 21 83 EB           1198 |     LXI H,COM   ; MOVE FILE TYPE "COM" INTO FCB.
EAD5: CD 40 E8           1199 |     CALL    MOVE3   ;
EAD8: CD D0 E4           1200 |     CALL    OPENF1  ; OPEN FILE FOR READING.
EADB: CA 6B EB           1201 |     JZ  TRANS8  ; ERROR CONDITION, FILE NOT FOUND.
EADE: 21 00 01           1202 |     LXI H,TPA   ; STARTING POINT FOR PROGRAM LOADING.
                         1203 |     ;
EAE1: E5                 1204 | TRANS2: PUSH    H   ; MOVE PROGRAM INTO TPA SECTOR BY SECTOR.
EAE2: EB                 1205 |     XCHG        ;
EAE3: CD D8 E5           1206 |     CALL    STDMA1  ; POINT TO LOADING LOCATION.
EAE6: 11 CD EB           1207 |     LXI D,FCB   ;
EAE9: CD F9 E4           1208 |     CALL    READF   ; READ 1 SECTOR INTO MEMORY.
EAEC: C2 01 EB           1209 |     JNZ TRANS3  ; ZFLAG RESET ::= GOOD READ, GO AROUND FOR MORE.
