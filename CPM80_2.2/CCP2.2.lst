E66F: EB                  474 |     XCHG        ;
E670: CD 4F E6            475 |     CALL    STEP    ;Get first non-blank character
E673: EB                  476 |     XCHG        ;
E674: 22 8A E4            477 |     SHLD    BPTR2   ;Save pointer in case of error
E677: EB                  478 |     XCHG        ;
E678: E1                  479 |     POP H   ;Get FCB pointer
E679: 1A                  480 |     LDAX    D   ;
E67A: B7                  481 |     ORA A   ;Check for null command
