                           23 | ;
                           24 | ;   EQUATES
                           25 | ;
                           26 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                            6 | 
                            7 | VER:    EQU 2   ;CP/M VERSION
                            8 | REL:    EQU 2   ;CP/M RELEASE
                            9 | REV:    EQU 0   ;REVISION
                           10 | SNH:    EQU 00  ;SERIAL NUMBER, HIGH. 2 DIGITS
                           11 | SNL:    EQU 0000    ;SERIAL  NUMBER, LOW. 4 DIGITS
                           27 | ;
                           28 | ;
                           29 | BDOS_SYS    EQU 0005H   ;Link to operating system
                           30 | IOBYTE  EQU 0003H   ;I/O assigment byte for transient programs
                           31 | LOGIN   EQU 0004H   ;User number and disk number for transient programs
                           32 | DFCB    EQU 005CH   ;Default file control block
                           33 | TPA EQU 0100H   ;Start of transient program area
                           34 | DDMA    EQU 0080H   ;Default DMA block
                           35 | SECLEN  EQU 0080H   ;Sector length := 128 bytes.
                           36 | ;
                           37 | ;   NOTE:
                           38 | ;       USER MUST INSERT CORRECT SERIAL NUMBER
                           39 | ;       IN THE FORMAT HH-LLLL, WHERE HH IS TWO
                           40 | ;       DIGITS & LLLL IS FOUR DIGITS. IF THE
                           41 | ;       SERIAL NUMBERS IN CCP/CPM AND BDOS/CPM
                           42 | ;       DO NOT MATCH, YOU WILL BOMB OUT WHEN
                           43 | ;       LOADING A TRANSIENT PROGRAM.
                           44 | ;
                           45 | ;


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

                           46 |     ORG CCP ;SET PROGRAM START
                           47 | ;
                           48 | ;   NOTE:
                           49 | ;       On entry (C) contains the user number in the
                           50 | ;       upper 4 bits, and the current logged in disk
                           51 | ;       number in to lower 4 bits. This is why you log
                           52 | ;       back to disk B: if you rebooted while logged
                           53 | ;       into B:
                           54 | ;
E400: C3 5C E7             55 | ORIGIN: JMP CCP1    ;JUMP TO START OF CONSOLE COMMAND PROGRAM
                           56 | ;
E403: C3 58 E7             57 |     JMP CCP0    ;JUMP TO START OF CCP W/ CLEARING OF INPUT BUFFER COUNTER
                           58 | ;
                           59 | ;   INPUT BUFFER WITH COPYRIGHT MESSAGE THROWN IN
                           60 | ;
E406: 7F                   61 | INPB:   DB  127 ;MAXIMUM LENGTH OF INPUT BUFFER
E407: 00                   62 | INBLEN: DB  0   ;CURRENT LENGTH OF INPUT BUFFER
E408: 20 20 20 20 20...    63 | BUFFER: DB  '                '
E418: 43 4F 50 59 52...    64 |     DB  'COPYRIGHT (C) 1979, '
E42C: 44 49 47 49 54...    65 |     DB  'DIGITAL RESEARCH  '
E43E:                      66 |     DS  BUFFER+128-$
                           67 | ;
                           68 | ;   POINTERS TO INPUT BUFFER
                           69 | ;
E488: 08 E4                70 | BPTR1:  DW  BUFFER  ;Pointer to input buffer used while parsing input line
E48A: 00 00                71 | BPTR2:  DW  0000H   ;Pointer to start of current command inn input buffer.
                           72 |             ;Used by WHAT for error prompt.
                           73 | ;   ***************
                           74 | ;   SUBROUTINE AREA
                           75 | ;   ***************
                           76 | ;
                           77 | ;   TIES TO BDOS VIA VECTOR IN 0005H
                           78 | ;
                           79 | ;   NOTE:
                           80 | ;       The code in this section could be cleaned up
                           81 | ;       shortened by rearranging things to have the
                           82 | ;       code flow from one segment to the next
                           83 | ;       instead of jumping back.
                           84 | ;
E48C: 5F                   85 | OUTPUT: MOV E,A ;OUTPUT 1 BYTE TO CONSOLE
E48D: 0E 02                86 |     MVI C,02H   ;
E48F: C3 05 00             87 |     JMP BDOS_SYS    ;
                           88 | ;
                           89 | ;   NOTE:
                           90 | ;       Why not include OUTPUT inside of PCHAR and
                           91 | ;       thus eliminate an- extra call?
                           92 | ;       The only other call to OUTPUT is in PMSG,
                           93 | ;       which should be changed anyway.
                           94 | ;
                           95 | ;PCHAR: PUSH    B   ;
                           96 | ;   MOV E,A ;
                           97 | ;   MVI C,02H   ;
                           98 | ;   CALL    BDOS_SYS    ;
                           99 | ;   POP B   ;
                          100 | ;   RET     ;
                          101 | ;


Assembly Listing                                                                                                 Page: 3
------------------------------------------------------------------------------------------------------------------------

E492: C5                  102 | PCHAR:  PUSH    B   ;PRINT A CHARACTER ON THE CONSOLE
E493: CD 8C E4            103 |     CALL    OUTPUT  ;
E496: C1                  104 |     POP B   ;
E497: C9                  105 |     RET     ;
                          106 | ;
E498: 3E 0D               107 | PCRLF:  MVI A,0DH   ;PRINT A CARRIAGE RETURN & LINE FEED
E49A: CD 92 E4            108 |     CALL    PCHAR   ;
E49D: 3E 0A               109 |     MVI A,0AH   ;
E49F: C3 92 E4            110 |     JMP PCHAR   ;
                          111 | ;
E4A2: 3E 20               112 | SPACE:  MVI A,20H   ;PRINT A SPACE
E4A4: C3 92 E4            113 |     JMP PCHAR   ;
                          114 | ;
E4A7: C5                  115 | CRMSG:  PUSH    B   ;PRINT A STRING PRECEDED BY A CR/LF
E4A8: CD 98 E4            116 |     CALL    PCRLF   ;
E4AB: E1                  117 |     POP H   ;
                          118 | ;
                          119 | ;   This code could be shortened by terminating the
                          120 | ;   error code strings with a '$' and using BDOS
                          121 | ;   command 9.
                          122 | ;
E4AC: 7E                  123 | PMSG:   MOV A,M ;PRINT A STRING TERMINATED BY A NULL
E4AD: B7                  124 |     ORA A   ;
E4AE: C8                  125 |     RZ      ;
E4AF: 23                  126 |     INX H   ;
E4B0: E5                  127 |     PUSH    H   ;
E4B1: CD 8C E4            128 |     CALL    OUTPUT  ;
E4B4: E1                  129 |     POP H   ;
E4B5: C3 AC E4            130 |     JMP PMSG    ;
                          131 | ;
E4B8: 0E 0D               132 | RESET:  MVI C,0DH   ;RESET THE DISK SYSTEM
E4BA: C3 05 00            133 |     JMP BDOS_SYS    ;
                          134 | ;
E4BD: 5F                  135 | SELDSK: MOV E,A ;SELECT DISK
E4BE: 0E 0E               136 |     MVI C,0EH   ;
E4C0: C3 05 00            137 |     JMP BDOS_SYS    ;
                          138 | ;
E4C3: CD 05 00            139 | BDOS1:  CALL    BDOS_SYS    ; CALL TO BDOS W/ RETURN VALUE SAVED
E4C6: 32 EE EB            140 |     STA RETVAL  ;
E4C9: 3C                  141 |     INR A   ;Set the ZFLAG for error condition
E4CA: C9                  142 |     RET     ;
                          143 | ;
E4CB: 0E 0F               144 | OPENF:  MVI C,0FH   ;OPEN DISK FILE FOR READING OR WRITING
E4CD: C3 C3 E4            145 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          146 | ;
E4D0: AF                  147 | OPENF1: XRA A   ;OPEN FILE @ FCB, AND ZERO RECORD COUNTER
E4D1: 32 ED EB            148 |     STA FCB+32  ;
E4D4: 11 CD EB            149 |     LXI D,FCB   ;
E4D7: C3 CB E4            150 |     JMP OPENF   ;
                          151 | ;
E4DA: 0E 10               152 | CLOSEF: MVI C,10H   ;CLOSE FILE AFTER READING OR WRITING
E4DC: C3 C3 E4            153 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          154 | ;
E4DF: 0E 11               155 | SRCHF:  MVI C,11H   ;SEARCH FOR FIRST OCCURENCE OF FILE NAME
E4E1: C3 C3 E4            156 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          157 | ;


Assembly Listing                                                                                                 Page: 4
------------------------------------------------------------------------------------------------------------------------

E4E4: 0E 12               158 | SRCHNX: MVI C,12H   ;SEARCH FOR NEXT OCCURENCE OF FILE NAME
E4E6: C3 C3 E4            159 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          160 | ;
E4E9: 11 CD EB            161 | SRCHF1: LXI D,FCB   ;SEARCH FOR FIRST OCCURENCE OF FILE
E4EC: C3 DF E4            162 |     JMP SRCHF   ; NAME USING (FCB).
                          163 | ;
E4EF: 0E 13               164 | DELETF: MVI C,13H   ;DELETE FILE FROM DIRECTORY
E4F1: C3 05 00            165 |     JMP BDOS_SYS    ;
                          166 | ;
E4F4: CD 05 00            167 | BDOS2:  CALL    BDOS_SYS    ; CALL TO BDOS W/ RETURN VALUE
E4F7: B7                  168 |     ORA A   ;
E4F8: C9                  169 |     RET     ;
                          170 | ;
E4F9: 0E 14               171 | READF:  MVI C,14H   ;READ ONE SECTOR FROM DISK
E4FB: C3 F4 E4            172 |     JMP BDOS2   ; CALL TO BDOS W/ RETURN VALUE
                          173 | ;
E4FE: 11 CD EB            174 | READ1:  LXI D,FCB   ;READ ONE SECTOR USING 'FCB'
E501: C3 F9 E4            175 |     JMP READF   ;
                          176 | ;
E504: 0E 15               177 | WRITEF: MVI C,15H   ;WRITE ONE SECTOR TO DISK
E506: C3 F4 E4            178 |     JMP BDOS2   ; CALL TO BDOS W/ RETURN VALUE
                          179 | ;
E509: 0E 16               180 | CREATE: MVI C,16H   ;CREATE A NEW FILE NAME IN DISK DIRECTORY
E50B: C3 C3 E4            181 |     JMP BDOS1   ; CALL TO BDOS W/ RETURN VALUE
                          182 | ;
E50E: 0E 17               183 | RENAME: MVI C,17H   ;RENAME EXISTING FILE IN DISK DIRECTORY
E510: C3 05 00            184 |     JMP BDOS_SYS    ;
                          185 | ;
E513: 1E FF               186 | GETUSR: MVI E,0FFH  ;GET CURRENT USER NUMBER
                          187 | ;
                          188 | ;   SET USER NUMBER TO VALUE IN (E), EXCEPT IF
                          189 | ;   VALUE IS 0FFH.
                          190 | ;
E515: 0E 20               191 | SETUSR: MVI C,20H   ;
E517: C3 05 00            192 |     JMP BDOS_SYS    ;
                          193 | ;
                          194 | ;   Set log-in byte for transient program with current
                          195 | ;   user number in upper 4 bits and current drive in
                          196 | ;   lower 4 bits.
                          197 | ;
E51A: CD 13 E5            198 | SETLOG: CALL    GETUSR  ; SET LOG-IN BYTE W/ CURRENT DRIVE & USER NUMBER
E51D: 87                  199 |     ADD A   ;
E51E: 87                  200 |     ADD A   ;
E51F: 87                  201 |     ADD A   ;
E520: 87                  202 |     ADD A   ;Shift user number to upper nibble
E521: 21 EF EB            203 |     LXI H,CURDSK    ;
E524: B6                  204 |     ORA M   ;Combine with disk number
E525: 32 04 00            205 |     STA LOGIN   ;Place where transient programs
E528: C9                  206 |     RET     ;  can find it.
                          207 | ;
                          208 | ;   LOG IN CURRENT DISK
                          209 | ;   Place current drive number in log-in byte without
                          210 | ;   including user number.
                          211 | ;
E529: 3A EF EB            212 | LOGCUR: LDA CURDSK  ;
E52C: 32 04 00            213 |     STA LOGIN   ;


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

E52F: C9                  214 |     RET     ;
                          215 | ;
                          216 | ;   CONVERT lower case INPUT TO UPPER CASE
                          217 | ;
E530: FE 61               218 | LCUC:   CPI 61H ;'a'
E532: D8                  219 |     RC      ;
E533: FE 7B               220 |     CPI 7BH ;'z'+1
E535: D0                  221 |     RNC     ;
E536: E6 5F               222 |     ANI 5FH ;MASK OFF BIT 5
E538: C9                  223 |     RET     ;
                          224 | ;
                          225 | ;   COMMAND INPUT
                          226 | ;
                          227 | ;   IF SUBMIT FLAG <> 0 THEN INPUT FROM SUBMIT FILE\
                          228 | ;       ELSE INPUT FROM KEYBOARD INPUT BUFFER
                          229 | ;
E539: 3A AB EB            230 | CMNDIN: LDA SUBFL   ;CHECK SUBMIT FILE FLAG
E53C: B7                  231 |     ORA A   ;
E53D: CA 96 E5            232 |     JZ  LINEIN  ;FLAG RESET: GET INPUT FROM KEYBOARD
                          233 | ;
                          234 | ;   NOTE ABOUT SUBMIT FILES:
                          235 | ;
                          236 | ;   When the command SUBMIT <filename>
                          237 | ;   is given, a file named $$$.SUB is compiled with
                          238 | ;   one command line per record in the file.
                          239 | ;   the file is unusual in that the commands are stored
                          240 | ;   in reverse order. This makes it simple for the
                          241 | ;   following code to pull one command off at a time,
                          242 | ;   erasing as it goes. Note that the sector counter is
                          243 | ;   decremented and the file closed each time.
                          244 | ;   When the last command has been executed, or if an
                          245 | ;   error is encountered, the $$$.SUB file is erased
                          246 | ;   and control reverts to the keyboard for input.
                          247 | ;
E540: 3A EF EB            248 |     LDA CURDSK  ;FLAG SET: GET INPUT FROM SUBMIT FILE ON CURRENT DISK
E543: B7                  249 |     ORA A   ;
E544: 3E 00               250 |     MVI A,00H   ;
E546: C4 BD E4            251 |     CNZ SELDSK  ;Set to disk 0 if not there already
E549: 11 AC EB            252 |     LXI D,SUBFCB    ; Point to submit file's file control block
E54C: CD CB E4            253 |     CALL    OPENF   ; Open the submit file for reading
E54F: CA 96 E5            254 |     JZ  LINEIN  ;Go to console on Open File Error
E552: 3A BB EB            255 |     LDA SUBFCB+15   ;Get top sector number
E555: 3D                  256 |     DCR A   ;Decrement? Yes $$$.SUB files are backwards
E556: 32 CC EB            257 |     STA SUBFCB+32   ;Put number in Next Sector slot
E559: 11 AC EB            258 |     LXI D,SUBFCB    ;
E55C: CD F9 E4            259 |     CALL    READF   ;Read sector into buffer
E55F: C2 96 E5            260 |     JNZ LINEIN  ;Go to console on read error
E562: 11 07 E4            261 |     LXI D,INBLEN    ;Point to start of keyboard buffer
E565: 21 80 00            262 |     LXI H,DDMA  ;Point to start of default buffer
E568: 06 80               263 |     MVI B,SECLEN    ;Set counter
E56A: CD 42 E8            264 |     CALL    BLKMOV  ;Move line into keyboard buffer
E56D: 21 BA EB            265 |     LXI H,SUBFCB+14 ;
E570: 36 00               266 |     MVI M,00H   ;
E572: 23                  267 |     INX H   ;
E573: 35                  268 |     DCR M   ;Decrement sector count
E574: 11 AC EB            269 |     LXI D,SUBFCB    ;close the file


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

E577: CD DA E4            270 |     CALL    CLOSEF  ;
E57A: CA 96 E5            271 |     JZ  LINEIN  ;Go to console on close error
E57D: 3A EF EB            272 |     LDA CURDSK  ;
E580: B7                  273 |     ORA A   ;
E581: C4 BD E4            274 |     CNZ SELDSK  ;Set to current disk if not so already
E584: 21 08 E4            275 |     LXI H,BUFFER    ;
E587: CD AC E4            276 |     CALL    PMSG    ;Echo the $$$.SUB line to console
E58A: CD C2 E5            277 |     CALL    KSTAT   ;Check for a keyboard break
E58D: CA A7 E5            278 |     JZ  LINP1   ;NO BREAK- Continue
E590: CD DD E5            279 |     CALL    EXITSB  ; BREAK- Close off submit mode
E593: C3 82 E7            280 |     JMP NXTCMD  ;This leaves the return address on the
                          281 |             ;stack, but NXTCMD re-initializes stack
                          282 | ;
                          283 | ;   Get the input from the Console Device
                          284 | ;
E596: CD DD E5            285 | LINEIN: CALL    EXITSB  ;RESET SUBMIT MODE FLAGS< ETC
E599: CD 1A E5            286 |     CALL    SETLOG  ; SET LOG-IN BYTE W/ CURRENT DRIVE & USER NUMBER
E59C: 0E 0A               287 |     MVI C,0AH   ;BDOS COMMAND 10 ::= READ INPUT BUFFER
E59E: 11 06 E4            288 |     LXI D,INPB  ;POINT TO START OF INPUT BUFFER
E5A1: CD 05 00            289 |     CALL    BDOS_SYS    ;GET A LINE FROM THE CONSOLE
E5A4: CD 29 E5            290 |     CALL    LOGCUR  ;
E5A7: 21 07 E4            291 | LINP1:  LXI H,INBLEN    ;
E5AA: 46                  292 |     MOV B,M ;Move the line byte count into (B)
E5AB: 23                  293 | LINP2:  INX H   ;Step through buffer changing lower
E5AC: 78                  294 |     MOV A,B ;case into upper case.
E5AD: B7                  295 |     ORA A   ;
E5AE: CA BA E5            296 |     JZ  LINP3   ;Exit when (B)=0
E5B1: 7E                  297 |     MOV A,M ;
E5B2: CD 30 E5            298 |     CALL    LCUC    ;Convert lower case to UPPER CASE
E5B5: 77                  299 |     MOV M,A ;
E5B6: 05                  300 |     DCR B   ;
E5B7: C3 AB E5            301 |     JMP LINP2   ;Loop
                          302 | ;
E5BA: 77                  303 | LINP3:  MOV M,A ;Poke a zero into end of line to mark end
E5BB: 21 08 E4            304 |     LXI H,BUFFER    ;Save command starting address
E5BE: 22 88 E4            305 |     SHLD    BPTR1   ; for later use.
E5C1: C9                  306 |     RET     ;
                          307 | ;
                          308 | ;   KEYBOARD STATUS CHECK
                          309 | ;   Return with ZFLAG set is no key pressed
                          310 | ;   Else return with character in accumulator
                          311 | ;
E5C2: 0E 0B               312 | KSTAT:  MVI C,0BH   ;
E5C4: CD 05 00            313 |     CALL    BDOS_SYS    ;
E5C7: B7                  314 |     ORA A   ;
E5C8: C8                  315 |     RZ      ;
E5C9: 0E 01               316 |     MVI C,01H   ;
E5CB: CD 05 00            317 |     CALL    BDOS_SYS    ;
E5CE: B7                  318 |     ORA A   ;
E5CF: C9                  319 |     RET     ;
                          320 | ;
                          321 | ;   INTEROGATE THE DISK
                          322 | ;
E5D0: 0E 19               323 | INTDSK: MVI C,19H   ;
E5D2: C3 05 00            324 |     JMP BDOS_SYS    ;
                          325 | ;


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

                          326 | ;   SET THE DMA ADDRESS
                          327 | ;
E5D5: 11 80 00            328 | SETDMA: LXI D,DDMA  ;
E5D8: 0E 1A               329 | STDMA1: MVI C,1AH   ;
E5DA: C3 05 00            330 |     JMP BDOS_SYS    ;
                          331 | ;
                          332 | ;   EXIT THE SUBMIT MODE
                          333 | ;   Check to see if the Submit flag is set
                          334 | ;   and reset it, along with the disk selection
                          335 | ;   Erase any $$$.SUB file that may be in the directory
                          336 | ;
E5DD: 21 AB EB            337 | EXITSB: LXI H,SUBFL ;SUBMIT FILE FLAG
E5E0: 7E                  338 |     MOV A,M ;
E5E1: B7                  339 |     ORA A   ;
E5E2: C8                  340 |     RZ      ;Not in submit mode, exit
E5E3: 36 00               341 |     MVI M,00H   ;Reset submit flag
E5E5: AF                  342 |     XRA A   ;
E5E6: CD BD E4            343 |     CALL    SELDSK  ;Select correct disk
E5E9: 11 AC EB            344 |     LXI D,SUBFCB    ;
E5EC: CD EF E4            345 |     CALL    DELETF  ;Delete the $$$.SUB file from disk
E5EF: 3A EF EB            346 |     LDA CURDSK  ;
E5F2: C3 BD E4            347 |     JMP SELDSK  ;Restore current disk and exit
                          348 | ;
                          349 | ;   COMPARE SERIAL NUMBERS
                          350 | ;   Serial numbers of CCP and BDOS are
                          351 | ;   compared. If there is no match, you
                          352 | ;   are banished to Digital Siberia.
                          353 | ;   This S/R is called before a transient
                          354 | ;   program is loaded into the TPA.
                          355 | ;
E5F5: 11 28 E7            356 | CMPSER: LXI D,SERNO ;Point to serial no in CCP
E5F8: 21 00 EC            357 |     LXI H,BDOS-6;Point to serial no in BDOS
E5FB: 06 06               358 |     MVI B,6 ;Number of bytes to compared
E5FD: 1A                  359 | CMPSN1: LDAX    D   ;
E5FE: BE                  360 |     CMP M   ;
E5FF: C2 CF E7            361 |     JNZ FATAL   ; OK, you've had it. You are locked out.
E602: 13                  362 |     INX D   ;
E603: 23                  363 |     INX H   ;
E604: 05                  364 |     DCR B   ;
E605: C2 FD E5            365 |     JNZ CMPSN1  ;
E608: C9                  366 |     RET     ; Good comparison. You are home free
                          367 | ;
                          368 | ;   GENERAL PURPOSE ERROR HANDLING ROUTINE
                          369 | ;   Anything that you do wrong in entering a
                          370 | ;   command lands you here. The command line
                          371 | ;   is typed back at you for your edification
                          372 | ;   and embarrassment. After you have been shown
                          373 | ;   a '?', you are put back in the command mode.
                          374 | ;
E609: CD 98 E4            375 | WHAT:   CALL    PCRLF   ;
E60C: 2A 8A E4            376 |     LHLD    BPTR2   ; Point to the offending command
E60F: 7E                  377 | WHAT1:  MOV A,M ; and print until a space or null is found
E610: FE 20               378 |     CPI ' ' ;
E612: CA 22 E6            379 |     JZ  WHAT2   ;
E615: B7                  380 |     ORA A   ;
E616: CA 22 E6            381 |     JZ  WHAT2   ;


Assembly Listing                                                                                                 Page: 8
------------------------------------------------------------------------------------------------------------------------

E619: E5                  382 |     PUSH    H   ;
E61A: CD 8C E4            383 |     CALL    OUTPUT  ;
E61D: E1                  384 |     POP H   ;
E61E: 23                  385 |     INX H   ;
E61F: C3 0F E6            386 |     JMP WHAT1   ;
                          387 | ;
E622: 3E 3F               388 | WHAT2:  MVI A,'?'   ; OK, what did you have in mind?
E624: CD 8C E4            389 |     CALL    OUTPUT  ;
E627: CD 98 E4            390 |     CALL    PCRLF   ;
E62A: CD DD E5            391 |     CALL    EXITSB  ;
E62D: C3 82 E7            392 |     JMP NXTCMD  ; Back for another command.
                          393 | ;
                          394 | ;   SPECIAL CHARACTER CHECK
                          395 | ;   Returns with ZFLAG set if any of the special
                          396 | ;   characters is found, or bombs you out if a
                          397 | ;   control character is found. Contains a useless
                          398 | ;   byte.
                          399 | ;
E630: 1A                  400 | CHRCHK: LDAX    D   ;
E631: B7                  401 |     ORA A   ;
E632: C8                  402 |     RZ      ;Exit on null
E633: FE 20               403 |     CPI ' ' ;
E635: DA 09 E6            404 |     JC  WHAT    ;Bomb out on control character
E638: C8                  405 |     RZ      ;
E639: FE 3D               406 |     CPI '=' ;
E63B: C8                  407 |     RZ      ;
E63C: FE 5F               408 |     CPI '_' ;
E63E: C8                  409 |     RZ      ;
E63F: FE 2E               410 |     CPI '.' ;
E641: C8                  411 |     RZ      ;
E642: FE 3A               412 |     CPI ':' ;
E644: C8                  413 |     RZ      ;
E645: FE 3B               414 |     CPI ';' ;
E647: C8                  415 |     RZ      ;
E648: FE 3C               416 |     CPI '<' ;
E64A: C8                  417 |     RZ      ;
E64B: FE 3E               418 |     CPI '>' ;
E64D: C8                  419 |     RZ      ; This command is redundant!
E64E: C9                  420 |     RET     ;
                          421 | ;
                          422 | ;   STEP (DE) UNTIL A NULL OR NON-SPACE IS FOUND
