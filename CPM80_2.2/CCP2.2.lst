E972: 36 FF              1004 |     MVI M,0FFH  ;
E974: 21 F1 EB           1005 | TYPE1:  LXI H,TYPCTR    ;
E977: 7E                 1006 |     MOV A,M ;Get the buffer counter
E978: FE 80              1007 |     CPI 80H ;Check for end of buffer
E97A: DA 87 E9           1008 |     JC  TYPE2   ;Not at end, get character from buffer
                         1009 | ;
                         1010 | ;   At end of buffer- Read from disk
                         1011 | ;
