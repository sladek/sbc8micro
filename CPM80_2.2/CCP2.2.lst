E977: 7E                  998 |     MOV A,M ;Get the buffer counter
E978: FE 80               999 |     CPI 80H ;Check for end of buffer
E97A: DA 87 E9           1000 |     JC  TYPE2   ;Not at end, get character from buffer
                         1001 | ;
                         1002 | ;   At end of buffer- Read from disk
                         1003 | ;
E97D: E5                 1004 |     PUSH    H   ;Read a sector from disk to the buffer
E97E: CD FE E4           1005 |     CALL    READ1   ;
E981: E1                 1006 |     POP H   ;
E982: C2 A0 E9           1007 |     JNZ TYPE3   ;RETURN VALUE <> 0. End of file or bad read
E985: AF                 1008 |     XRA A   ;
E986: 77                 1009 |     MOV M,A ;Zero (TYPCTR)
E987: 34                 1010 | TYPE2:  INR M   ;
E988: 21 80 00           1011 |     LXI H,DDMA  ;
E98B: CD 59 E6           1012 |     CALL    ADDAH   ;Point to character
E98E: 7E                 1013 |     MOV A,M ;Get the character
E98F: FE 1A              1014 |     CPI 1AH ;Check for end of file
E991: CA 86 EB           1015 |     JZ  COMEND  ;EXIT
E994: CD 8C E4           1016 |     CALL    OUTPUT  ;Not EOF, output the byte to the console
E997: CD C2 E5           1017 |     CALL    KSTAT   ;Check for keyboard break
E99A: C2 86 EB           1018 |     JNZ COMEND  ;EXIT ON ANY KEY
E99D: C3 74 E9           1019 |     JMP TYPE1   ;Back for the next letter
                         1020 | ;
                         1021 | ;   (A) = 1 :: End of file
                         1022 | ;   (A) = 2 :: Read error
                         1023 | ;
E9A0: 3D                 1024 | TYPE3:  DCR A   ;
E9A1: CA 86 EB           1025 |     JZ  COMEND  ;EXIT AT END OF FILE
