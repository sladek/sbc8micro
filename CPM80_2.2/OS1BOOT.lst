
Assembly Listing                                 MDS COLD START LOADER AT 3000H                                  Page: 1
------------------------------------------------------------------------------------------------------------------------

                            1 |     TITLE   'MDS COLD START LOADER AT 3000H'
                            2 | ;
                            3 | ;   MDS-800 COLD START LOADER FOR CP/M 2.0
                            4 | ;
                            5 | ;   VERSION 2.0 AUGUST, 1979
                            6 | ;
                            7 | FALSE   EQU 0
                            8 | TRUE    EQU  !FALSE
                            9 | TESTING EQU FALSE   ;IF TRUE, THEN GO TO MON80 ON ERRORS
                           10 | ;
                           11 |     IF  TESTING
                           12 : BIAS    EQU 03400H
                           13 :     ENDIF
                           14 |     IF  !TESTING
                           15 | BIAS    EQU 0000H
                           16 |     ENDIF
                           17 | CPMB    EQU BIAS        ;BASE OF DOS LOAD
                           18 | BDOS    EQU 806H+BIAS   ;ENTRY TO DOS FOR CALLS
                           19 | BDOSE   EQU 1880H+BIAS  ;END OF DOS LOAD
                           20 | BOOT    EQU 1600H+BIAS  ;COLD START ENTRY POINT
                           21 | RBOOT   EQU BOOT+3      ;WARM START ENTRY POINT
                           22 | ;
                           23 |     ORG 03000H  ;LOADED DOWN FROM HARDWARE BOOT AT 3000H
                           24 | ;
                           25 | BDOSL   EQU BDOSE-CPMB
                           26 | NTRKS   EQU 2   ;NUMBER OF TRACKS TO READ
                           27 | BDOSS   EQU BDOSL/128   ;NUMBER OF SECTORS IN DOS
                           28 | BDOS0   EQU 25  ;NUMBER OF BDOS SECTORS ON TRACK 0
                           29 | BDOS1   EQU BDOSS-BDOS0 ;NUMBER OF SECTORS ON TRACK 1
                           30 | ;
                           31 | MON80   EQU 0F800H  ;INTEL MONITOR BASE
                           32 | RMON80  EQU 0FF0FH  ;RESTART LOCATION FOR MON80
                           33 | BASE    EQU 078H    ;'BASE' USED BY CONTROLLER
                           34 | RTYPE   EQU BASE+1  ;RESULT TYPE
                           35 | RBYTE   EQU BASE+3  ;RESULT BYTE
                           36 | RESET   EQU BASE+7  ;RESET CONTROLLER
                           37 | ;
                           38 | DSTAT   EQU BASE    ;DISK STATUS PORT
                           39 | ILOW    EQU BASE+1  ;LOW IOPB ADDRESS
                           40 | IHIGH   EQU BASE+2  ;HIGH IOPB ADDRESS
                           41 | BSW EQU 0FFH    ;BOOT SWITCH
                           42 | RECAL   EQU 3H  ;RECALIBRATE SELECTED DRIVE
                           43 | READF   EQU 4H  ;DISK READ FUNCTION
                           44 | STACK   EQU 100H    ;USE END OF BOOT FOR STACK
                           45 | ;
                           46 | RSTART:
3000: 31 00 01             47 |     LXI SP,STACK;IN CASE OF CALL TO MON80
                           48 | ;   CLEAR DISK STATUS
3003: DB 79                49 |     IN  RTYPE
3005: DB 7B                50 |     IN  RBYTE
                           51 | ;   CHECK IF BOOT SWITCH IS OFF
                           52 | COLDSTART:
3007: DB FF                53 |     IN  BSW
3009: E6 02                54 |     ANI 02H ;SWITCH ON?
300B: C2 07 30             55 |     JNZ COLDSTART
                           56 | ;   CLEAR THE CONTROLLER


Assembly Listing                                 MDS COLD START LOADER AT 3000H                                  Page: 2
------------------------------------------------------------------------------------------------------------------------

300E: D3 7F                57 |     OUT RESET   ;LOGIC CLEARED
                           58 | ;
                           59 | ;
3010: 06 02                60 |     MVI B,NTRKS ;NUMBER OF TRACKS TO READ
3012: 21 42 30             61 |     LXI H,IOPB0
                           62 | ;
                           63 | START:
                           64 | ;
                           65 | ;   READ FIRST/NEXT TRACK INTO CPMB
3015: 7D                   66 |     MOV A,L
3016: D3 79                67 |     OUT ILOW
3018: 7C                   68 |     MOV A,H
3019: D3 7A                69 |     OUT IHIGH
301B: DB 78                70 | WAIT0:  IN  DSTAT
301D: E6 04                71 |     ANI 4
301F: CA 1B 30             72 |     JZ  WAIT0
                           73 | ;
                           74 | ;   CHECK DISK STATUS
3022: DB 79                75 |     IN  RTYPE
3024: E6 03                76 |     ANI 11B
3026: FE 02                77 |     CPI 2
                           78 | ;
                           79 |     IF  TESTING
                           80 :     CNC RMON80  ;GO TO MONITOR IF 11 OR 10
                           81 :     ENDIF
                           82 |     IF  !TESTING
3028: D2 00 30             83 |     JNC RSTART  ;RETRY THE LOAD
                           84 |     ENDIF
                           85 | ;
302B: DB 7B                86 |     IN  RBYTE   ;I/O COMPLETE, CHECK STATUS
                           87 | ;   IF NOT READY, THEN GO TO MON80
302D: 17                   88 |     RAL
302E: DC 0F FF             89 |     CC  RMON80  ;NOT READY BIT SET
3031: 1F                   90 |     RAR     ;RESTORE
3032: E6 1E                91 |     ANI 11110B  ;OVERRUN/ADDR ERR/SEEK/CRC/XXXX
                           92 | ;
                           93 |     IF  TESTING
                           94 :     CNZ RMON80  ;GO TO MONITOR
                           95 :     ENDIF
                           96 |     IF  !TESTING
3034: C2 00 30             97 |     JNZ RSTART  ;RETRY THE LOAD
                           98 |     ENDIF
                           99 | ;
                          100 | ;
3037: 11 00 00            101 |     LXI D,IOPBL ;LENGTH OF IOPB
303A: 19                  102 |     DAD D   ;ADDRESSING NEXT IOPB
303B: 05                  103 |     DCR B   ;COUNT DOWN TRACKS
303C: C2 15 30            104 |     JNZ START
                          105 | ;
                          106 | ;
                          107 | ;   JMP TO BOOT TO PRINT INITIAL MESSAGE, AND SET UP JMPS
303F: C3 00 16            108 |     JMP BOOT
                          109 | ;
                          110 | ;   PARAMETER BLOCKS
3042: 80                  111 | IOPB0:  DB  80H ;IOCW, NO UPDATE
3043: 04                  112 |     DB  READF   ;READ FUNCTION


Assembly Listing                                 MDS COLD START LOADER AT 3000H                                  Page: 3
------------------------------------------------------------------------------------------------------------------------

3044: 19                  113 |     DB  BDOS0   ;# SECTORS TO READ ON TRACK 0
3045: 00                  114 |     DB  0   ;TRACK 0
3046: 02                  115 |     DB  2   ;START WITH SECTOR 2 ON TRACK 0
3047: 00 00               116 |     DW  CPMB    ;START AT BASE OF BDOS
                          117 | IOPBL   EQU $-IOPB0
                          118 | ;
3049: 80                  119 | IOPB1:  DB  80H
304A: 04                  120 |     DB  READF
304B: 18                  121 |     DB  BDOS1   ;SECTORS TO READ ON TRACK 1
304C: 01                  122 |     DB  1   ;TRACK 1
304D: 01                  123 |     DB  1   ;SECTOR 1
304E: 80 0C               124 |     DW  CPMB+BDOS0*128  ;BASE OF SECOND READ
                          125 | ;
                          126 |     END

