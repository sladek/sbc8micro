MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
BIAS	EQU	(MSIZE-20)*1024
CCP	EQU	3400H+BIAS
BDOS	EQU	CCP+0806H
BIOS	EQU	CCP+1600H

VER:	EQU	2	;CP/M VERSION
REL:	EQU	2	;CP/M RELEASE
REV:	EQU	0	;REVISION
SNH:	EQU	00	;SERIAL NUMBER, HIGH. 2 DIGITS
SNL:	EQU	0000	;SERIAL  NUMBER, LOW. 4 DIGITS
