
Assembly Listing                                                                                                 Page: 1
------------------------------------------------------------------------------------------------------------------------

                            1 | ;--------------------------------------------------------------------
                            2 | ; 
                            3 | ; PUTSYS - WRITE SYSTEM TRACKS FROM MEMORY AT 3380H
                            4 | ;
                            5 | ; BASED ON GETSYS/PUTSYS IN D.R. MANUALS, CONFIGURED FOR THE
                            6 | ; DIGITAL RESEARCH COMPUTERS OF TEXAS (FERGUSON) BIG-BOARD 
                            7 | ;      BRIAN KANTOR, 1983
                            8 | ;--------------------------------------------------------------------
                            9 | ; BOOT LOADER   IMAGE STARTS AT E380H
                           10 | ; CCP       IMAGE STARTS AT E400H
                           11 | ; BDOS      IMAGE STARTS AT EC00H
                           12 | ; BIOS      IMAGE STARTS AT FA00H
                           13 | ; (END OF SYSTEM TRACK IMAGE IS END OF BIOS AT FFFFH
                           14 | ;-------------------------------------------------------------------
                           15 | 
                           16 | 
                           17 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                            6 | 
                            7 | VER:    EQU 2   ;CP/M VERSION
                            8 | REL:    EQU 2   ;CP/M RELEASE
                            9 | REV:    EQU 0   ;REVISION
                           10 | SNH:    EQU 00  ;SERIAL NUMBER, HIGH. 2 DIGITS
                           11 | SNL:    EQU 0000    ;SERIAL  NUMBER, LOW. 4 DIGITS
                           18 | 
                           19 |     ORG     0
0000: C3 00 00             20 | LOOP:   JMP LOOP            ; END LOOP USED FOR TESTING ONLY
                           21 | 
                           22 |     ORG 100H
                           23 | 
                           24 | PUTSYS:
0100: 0E 01                25 |     MVI C,1         ;SELECT THE B DISK
0102: CD 1B FA             26 |     CALL    BIOS+27         ;SELECT
0105: 21 00 E4             27 |     LXI H,CCP           ;CONVENIENT PLACE
0108: 06 00                28 |     MVI B,0         ;START ON TRACK 0
010A: 0E 02                29 |     MVI C,2         ;SECTOR 2 ON TRACK 0
                           30 |     ; WE WILL START ON SECTOR 2 track 0
                           31 |     ; AS SECTOR 1 IS RESERVED FOR BOOT LOADER
010C: C3 11 01             32 |     JMP WR_SEC
                           33 | WR_TRK:
010F: 0E 01                34 |     MVI C, 1            ; OTHER TRACKS START WITH SECTOR 1
                           35 | WR_SEC:
0111: CD 29 01             36 |     CALL    WRITE_SEC       ;PUT A SECTOR
0114: 11 80 00             37 |     LXI D,128           ;SECTOR LENGTH
0117: 19                   38 |     DAD D           ;PUT POINTER AT END OF SECTOR
0118: 0C                   39 |     INR C           ;BUMP COUNT
0119: 79                   40 |     MOV A,C         ;CHECK IF WE GOT 26 YET
011A: FE 1B                41 |     CPI 27          ;26 ON A TRACK
011C: C2 11 01             42 |     JNZ WR_SEC
                           43 | 
                           44 | ; AT END OF TRACK, PUT NEXT ONE
                           45 | 


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

011F: 04                   46 |     INR B           ;BUMP TRACK COUNT
0120: 78                   47 |     MOV A,B         ;CHECK COUNT
0121: FE 02                48 |     CPI 2           ;DONE 0 AND 1 YET?
0123: C2 0F 01             49 |     JNZ WR_TRK          ;NO, DO ANOTHER
                           50 | 
                           51 | ; DONE, SO BOOT SYSTEM
                           52 | 
0126: C3 00 00             53 |     JMP 0
                           54 | 
                           55 | ; SUBROUTINE TO WRITE A SECTOR (USE THE BIOS)
                           56 | 
                           57 | WRITE_SEC:
0129: E5                   58 |     PUSH    H
012A: C5                   59 |     PUSH    B
012B: 44                   60 |     MOV B,H         ; SET DMA ADDRESS
012C: 4D                   61 |     MOV C,L
012D: CD 24 FA             62 |     CALL    BIOS+36         ;SETDMA
0130: C1                   63 |     POP B
                           64 | 
0131: C5                   65 |     PUSH    B
0132: 48                   66 |     MOV C,B         ; SET TRACK NUMBER
0133: 06 00                67 |     MVI B,0
0135: CD 1E FA             68 |     CALL    BIOS+30
0138: C1                   69 |     POP B
                           70 | 
0139: C5                   71 |     PUSH    B
013A: 06 00                72 |     MVI B,0
013C: CD 21 FA             73 |     CALL    BIOS+33         ; SET SECTOR NUMBER
013F: CD 2A FA             74 |     CALL    BIOS+42         ; SECTOR WRITE
0142: C1                   75 |     POP B
0143: E1                   76 |     POP H
0144: C9                   77 |     RET
                           78 | 
                           79 |     END

