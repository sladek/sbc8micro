
Assembly Listing                                                                                                 Page: 1
------------------------------------------------------------------------------------------------------------------------

                            1 | ;--------------------------------------------------------------------
                            2 | ; 
                            3 | ; PUTSYS - WRITE SYSTEM TRACKS FROM MEMORY AT 3380H
                            4 | ;
                            5 | ; BASED ON GETSYS/PUTSYS IN D.R. MANUALS, CONFIGURED FOR THE
                            6 | ; DIGITAL RESEARCH COMPUTERS OF TEXAS (FERGUSON) BIG-BOARD 
                            7 | ;      BRIAN KANTOR, 1983
                            8 | ;--------------------------------------------------------------------
                            9 | ; BOOT LOADER   IMAGE STARTS AT E380H
                           10 | ; CCP       IMAGE STARTS AT E400H
                           11 | ; BDOS      IMAGE STARTS AT EC00H
                           12 | ; BIOS      IMAGE STARTS AT FA00H
                           13 | ; (END OF SYSTEM TRACK IMAGE IS END OF BIOS AT 4FFFH
                           14 | ;-------------------------------------------------------------------
                           15 | 
                           16 | 
                           17 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                           18 | 
                           19 |     ORG     0
0000: C3 00 00             20 | LOOP:   JMP LOOP            ; END LOOP USED FOR TESTING ONLY
                           21 | 
                           22 |     ORG 100H
                           23 | 
                           24 | PUTSYS:
0100: 0E 01                25 |     MVI C,1         ;SELECT THE B DISK
0102: CD 1B FA             26 |     CALL    BIOS+27         ;SELECT
0105: 21 00 E4             27 |     LXI H,CCP           ;CONVENIENT PLACE
0108: 06 00                28 |     MVI B,0         ;START ON TRACK 0
                           29 | WR_TRK:
010A: 0E 01                30 |     MVI C,1         ;SECTOR 1
                           31 | WR_SEC:
010C: CD 24 01             32 |     CALL    WRITE_SEC       ;PUT A SECTOR
010F: 11 80 00             33 |     LXI D,128           ;SECTOR LENGTH
0112: 19                   34 |     DAD D           ;PUT POINTER AT END OF SECTOR
0113: 0C                   35 |     INR C           ;BUMP COUNT
0114: 79                   36 |     MOV A,C         ;CHECK IF WE GOT 26 YET
0115: FE 1B                37 |     CPI 27          ;26 ON A TRACK
0117: C2 0C 01             38 |     JNZ WR_SEC
                           39 | 
                           40 | ; AT END OF TRACK, PUT NEXT ONE
                           41 | 
011A: 04                   42 |     INR B           ;BUMP TRACK COUNT
011B: 78                   43 |     MOV A,B         ;CHECK COUNT
011C: FE 02                44 |     CPI 2           ;DONE 0 AND 1 YET?
011E: C2 0A 01             45 |     JNZ WR_TRK          ;NO, DO ANOTHER
                           46 | 
                           47 | ; DONE, SO BOOT SYSTEM
                           48 | 
0121: C3 00 00             49 |     JMP 0
                           50 | 
                           51 | ; SUBROUTINE TO WRITE A SECTOR (USE THE BIOS)


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

                           52 | 
                           53 | WRITE_SEC:
0124: E5                   54 |     PUSH    H
0125: C5                   55 |     PUSH    B
0126: 44                   56 |     MOV B,H         ; SET DMA ADDRESS
0127: 4D                   57 |     MOV C,L
0128: CD 24 FA             58 |     CALL    BIOS+36         ;SETDMA
012B: C1                   59 |     POP B
                           60 | 
012C: C5                   61 |     PUSH    B
012D: 48                   62 |     MOV C,B         ; SET TRACK NUMBER
012E: 06 00                63 |     MVI B,0
0130: CD 1E FA             64 |     CALL    BIOS+30
0133: C1                   65 |     POP B
                           66 | 
0134: C5                   67 |     PUSH    B
0135: 06 00                68 |     MVI B,0
0137: CD 21 FA             69 |     CALL    BIOS+33         ; SET SECTOR NUMBER
013A: CD 2A FA             70 |     CALL    BIOS+42         ; SECTOR WRITE
013D: C1                   71 |     POP B
013E: E1                   72 |     POP H
013F: C9                   73 |     RET
                           74 | 
                           75 |     END

