
Assembly Listing                                                                                                 Page: 1
------------------------------------------------------------------------------------------------------------------------

                            1 | ;--------------------------------------------------------------------
                            2 | ; 
                            3 | ; GETSYS - READS SYSTEM TRACKS INTO MEMORY AT E380H
                            4 | ;
                            5 | ; BASED ON GETSYS/PUTSYS IN D.R. MANUALS, CONFIGURED FOR THE
                            6 | ; DIGITAL RESEARCH COMPUTERS OF TEXAS (FERGUSON) BIG-BOARD 
                            7 | ;      BRIAN KANTOR, 1983
                            8 | ;--------------------------------------------------------------------
                            9 | ; BOOT LOADER   IMAGE STARTS AT E380H
                           10 | ; CCP       IMAGE STARTS AT E400H
                           11 | ; BDOS      IMAGE STARTS AT EC00H
                           12 | ; BIOS      IMAGE STARTS AT FA00H
                           13 | ; (END OF SYSTEM TRACK IMAGE IS END OF BIOS AT 4FFFH
                           14 | ;-------------------------------------------------------------------
                           15 | 
                           16 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                           17 |     IFNDEF  MSIZE
                           18 : MSIZE:  EQU 20
                           19 :     ENDIF
                           20 | 
                           21 |     ORG     0
0000: C3 00 00             22 | LOOP:   JMP LOOP
                           23 | 
                           24 |     ORG 100H
                           25 | GETSYS:
0100: 0E 00                26 |     MVI C,0         ;SELECT THE A DISK
0102: CD 1B FA             27 |     CALL    BIOS+27         ;SELDSK
0105: 21 00 E4             28 |     LXI H,CCP           ;CONVENIENT PLACE
0108: 06 00                29 |     MVI B,0         ;START ON TRACK 0
                           30 | RD_TRK:
010A: 0E 01                31 |     MVI C,1         ;SECTOR 1
                           32 | RD_SEC:
010C: CD 24 01             33 |     CALL    READ_SEC        ;GET A SECTOR
010F: 11 80 00             34 |     LXI D,128           ;SECTOR LENGTH
0112: 19                   35 |     DAD D           ;PUT POINTER AT END OF SECTOR
0113: 0C                   36 |     INR C           ;BUMP COUNT
0114: 79                   37 |     MOV A,C         ;CHECK IF WE GOT 26 YET
0115: FE 1B                38 |     CPI 27          ;26 ON A TRACK
0117: C2 0C 01             39 |     JNZ RD_SEC
                           40 | 
                           41 | ; AT END OF TRACK, GET NEXT ONE
                           42 | 
011A: 04                   43 |     INR B           ;BUMP TRACK COUNT
011B: 78                   44 |     MOV A,B         ;CHECK COUNT
011C: FE 02                45 |     CPI 2           ;DONE 0 AND 1 YET?
011E: C2 0A 01             46 |     JNZ RD_TRK          ;NO, DO ANOTHER
                           47 | 
                           48 | ; DONE, SO BOOT SYSTEM
                           49 | 
0121: C3 00 00             50 |     JMP 0           ;RETURN TO CP/M
                           51 | ;


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

                           52 | ; SUBROUTINE TO READ A SECTOR (USE THE BIOS)
                           53 | ;
                           54 | 
                           55 | READ_SEC:
0124: E5                   56 |     PUSH    H
0125: C5                   57 |     PUSH    B
0126: 44                   58 |     MOV B,H         ; SET DMA ADDRESS
0127: 4D                   59 |     MOV C,L
0128: CD 24 FA             60 |     CALL    BIOS+36         ; SETDMA
012B: C1                   61 |     POP B
                           62 | 
012C: C5                   63 |     PUSH    B
012D: 48                   64 |     MOV C,B         ; SET TRACK NUMBER
012E: 06 00                65 |     MVI B,0
0130: CD 1E FA             66 |     CALL    BIOS+30 ; SETTRK
0133: C1                   67 |     POP B
                           68 | 
0134: C5                   69 |     PUSH    B
0135: 06 00                70 |     MVI B,0
0137: CD 21 FA             71 |     CALL    BIOS+33         ; SET SECTOR NUMBER (SETSEC)
013A: CD 27 FA             72 |     CALL    BIOS+39         ; SECTOR READ
013D: C1                   73 |     POP B
013E: E1                   74 |     POP H
013F: C9                   75 |     RET
                           76 | 
                           77 |     END
                           78 |     

