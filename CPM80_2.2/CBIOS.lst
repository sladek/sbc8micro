FC17: DB 7B               412 |     IN  RBYTE   ;CLEARS THE CONTROLLER
                          413 | ;
FC19: 3E 28               414 |     MVI A,IOPB & 0FFH   ;LOW ADDRESS FOR IOPB
FC1B: 06 FF               415 |     MVI B,IOPB SHR 8    ;HIGH ADDRESS FOR IOPB
FC1D: D3 79               416 |     OUT ILOW        ;LOW ADDRESS TO CONTROLLER
FC1F: 78                  417 |     MOV A,B
FC20: D3 7A               418 |     OUT IHIGH   ;HIGH ADDRESS
                          419 | ;
                          420 | WAIT0:  
FC22: DB 78               421 |     IN  DSTAT
                          422 |         ;WAIT FOR COMPLETION
FC24: E6 04               423 |     ANI IORDY       ;READY?
FC26: CA 22 FC            424 |     JZ  WAIT0
                          425 | ;
                          426 | ;   CHECK IO COMPLETION OK
FC29: DB 79               427 |     IN  RTYPE       ;MUST BE IO COMPLETE (00) UNLINKED
                          428 | ;   00 UNLINKED I/O COMPLETE,    01 LINKED I/O COMPLETE (NOT USED)
                          429 | ;   10 DISK STATUS CHANGED       11 (NOT USED)
FC2B: FE 02               430 |     CPI 10B     ;READY STATUS CHANGE?
FC2D: CA 41 FC            431 |     JZ  WREADY
                          432 | ;
                          433 | ;   MUST BE 00 IN THE ACCUMULATOR
FC30: B7                  434 |     ORA A
FC31: C2 46 FC            435 |     JNZ WERROR      ;SOME OTHER CONDITION, RETRY
                          436 | ;
                          437 | ;   CHECK I/O ERROR BITS
FC34: DB 7B               438 |     IN  RBYTE
FC36: 17                  439 |     RAL
FC37: DA 41 FC            440 |     JC  WREADY      ;UNIT NOT READY
FC3A: 1F                  441 |     RAR
FC3B: E6 FE               442 |     ANI 11111110B   ;ANY OTHER ERRORS?  (DELETED DATA OK)
FC3D: C2 46 FC            443 |     JNZ WERROR
                          444 | ;
                          445 | ;   READ OR WRITE IS OK, ACCUMULATOR CONTAINS ZERO
FC40: C9                  446 |     RET
                          447 | ;
                          448 | WREADY: ;NOT READY, TREAT AS ERROR FOR NOW
FC41: DB 7B               449 |     IN  RBYTE       ;CLEAR RESULT BYTE
FC43: C3 46 FC            450 |     JMP TRYCOUNT
                          451 | ;
                          452 | WERROR: ;RETURN HARDWARE MALFUNCTION (CRC, TRACK, SEEK, ETC.)
                          453 | ;   THE MDS CONTROLLER HAS RETURNED A BIT IN EACH POSITION
                          454 | ;   OF THE ACCUMULATOR, CORRESPONDING TO THE CONDITIONS:
                          455 | ;   0   - DELETED DATA (ACCEPTED AS OK ABOVE)
                          456 | ;   1   - CRC ERROR
                          457 | ;   2   - SEEK ERROR
                          458 | ;   3   - ADDRESS ERROR (HARDWARE MALFUNCTION)
                          459 | ;   4   - DATA OVER/UNDER FLOW (HARDWARE MALFUNCTION)
                          460 | ;   5   - WRITE PROTECT (TREATED AS NOT READY)
                          461 | ;   6   - WRITE ERROR (HARDWARE MALFUNCTION)
                          462 | ;   7   - NOT READY
                          463 | ;   (ACCUMULATOR BITS ARE NUMBERED 7 6 5 4 3 2 1 0)
                          464 | ;
                          465 | ;   IT MAY BE USEFUL TO FILTER OUT THE VARIOUS CONDITIONS,
                          466 | ;   BUT WE WILL GET A PERMANENT ERROR MESSAGE IF IT IS NOT
                          467 | ;   RECOVERABLE.  IN ANY CASE, THE NOT READY CONDITION IS


Assembly Listing                                                                                                Page: 10
------------------------------------------------------------------------------------------------------------------------

                          468 | ;   TREATED AS A SEPARATE CONDITION FOR LATER IMPROVEMENT
                          469 | TRYCOUNT:
                          470 | ;   REGISTER C CONTAINS RETRY COUNT, DECREMENT 'TIL ZERO
FC46: 0D                  471 |     DCR C
FC47: C2 15 FC            472 |     JNZ REWAIT  ;FOR ANOTHER TRY
                          473 | ;
                          474 | ;   CANNOT RECOVER FROM ERROR
                          475 | ;   MVI A,1 ;ERROR CODE ORIGINALLY SET JUST TO 1
                          476 | ;   BUT WE WANT TO DISTINGUISH ALSO OTHER ERRORS LIKE R/O 
                          477 | ;   ERROR CODE IS IN A REGISTER
FC4A: C9                  478 |     RET
                          479 | ;
FC4B:                     480 | DISKNO: DS  1   ;DISK NUMBER 0-15
                          481 | ;
                          482 | ;   SCRATCH RAM AREA FOR BDOS USE
                          483 | BEGDAT  EQU $   ;BEGINNING OF DATA AREA
FC4C:                     484 | DIRBF:  DS  128 ;SCRATCH DIRECTORY AREA
FCCC:                     485 | ALL00:  DS  31  ;ALLOCATION VECTOR 0
FCEB:                     486 | ALL01:  DS  31  ;ALLOCATION VECTOR 1
FD0A:                     487 | ALL02:  DS  255 ;ALLOCATION VECTOR 2 (HARD DRIVE C:)
FE09:                     488 | ALL03:  DS  255 ;ALLOCATION VECTOR 3 (HARD DRIVE D:)
FF08:                     489 | CHK00:  DS  16  ;CHECK VECTOR 0
FF18:                     490 | CHK01:  DS  16  ;CHECK VECTOR 1
                          491 | ; HARD DRIVE IS NOT REMOVABLE SO WE DON'T HAVE TO ALLOCATE CHECK VECTORS FOR THEM
                          492 | ;CHK02: DS  16  ;CHECK VECTOR 2
                          493 | ;CHK03: DS  16  ;CHECK VECTOR 3
                          494 | ;
                          495 | ENDDAT  EQU $   ;END OF DATA AREA
                          496 | DATSIZ  EQU $-BEGDAT;SIZE OF DATA AREA
                          497 | ;
                          498 | ;
                          499 | ;
                          500 | ;   DATA AREAS (MUST BE IN RAM)
                          501 | IOPB:   ;IO PARAMETER BLOCK
FF28: 80                  502 |     DB  80H ;NORMAL I/O OPERATION
FF29: 04                  503 | IOF:    DB  READF   ;IO FUNCTION, INITIAL READ
FF2A: 01                  504 | ION:    DB  1   ;NUMBER OF SECTORS TO READ
FF2B: 02                  505 | IOT:    DB  OFFSET  ;TRACK NUMBER
FF2C: 01                  506 | IOS:    DB  1   ;SECTOR NUMBER
FF2D: 80 00               507 | IOD:    DW  BUFF    ;IO ADDRESS
                          508 | ;
