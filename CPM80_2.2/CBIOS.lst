                          356 | ;
                          357 | SETDMA: ;SET DMA ADDRESS GIVEN BY REGISTERS B AND C
FBE5: 69                  358 |     MOV L,C ;LOW ORDER ADDRESS
FBE6: 60                  359 |     MOV H,B ;HIGH ORDER ADDRESS
FBE7: 22 2D FF            360 |     SHLD    IOD ;SAVE THE ADDRESS
FBEA: C9                  361 |     RET
                          362 | ;
                          363 | READ:   ;READ NEXT DISK RECORD (ASSUMING DISK/TRK/SEC/DMA SET)
FBEB: 0E 04               364 |     MVI C,READF ;SET TO READ FUNCTION
FBED: CD 0A FC            365 |     CALL    SETFUNC
FBF0: CD 13 FC            366 |     CALL    WAITIO  ;PERFORM READ FUNCTION
FBF3: C9                  367 |     RET     ;MAY HAVE ERROR SET IN REG-A
                          368 | ;
                          369 | ;
                          370 | WRITE:  ;DISK WRITE FUNCTION
FBF4: 0E 06               371 |     MVI C,WRITF
FBF6: CD 0A FC            372 |     CALL    SETFUNC ;SET TO WRITE FUNCTION
FBF9: CD 13 FC            373 |     CALL    WAITIO
FBFC: C9                  374 |     RET     ;MAY HAVE ERROR SET
                          375 | ;
                          376 | ;   UTILITY SUBROUTINES
                          377 | PRMSG:  ;PRINT MESSAGE AT H,L TO 0
FBFD: 7E                  378 |     MOV A,M
FBFE: B7                  379 |     ORA A   ;ZERO?
FBFF: C8                  380 |     RZ
                          381 | ;   MORE TO PRINT
FC00: E5                  382 |     PUSH    H
FC01: 4F                  383 |     MOV C,A
FC02: CD 6C FB            384 |     CALL    CONOUT
FC05: E1                  385 |     POP H
FC06: 23                  386 |     INX H
FC07: C3 FD FB            387 |     JMP PRMSG
                          388 | ;
                          389 | SETFUNC:
                          390 | ;   SET FUNCTION FOR NEXT I/O (COMMAND IN REG-C)
FC0A: 21 29 FF            391 |     LXI H,IOF   ;IO FUNCTION ADDRESS
FC0D: 7E                  392 |     MOV A,M ;GET IT TO ACCUMULATOR FOR MASKING
FC0E: E6 F8               393 |     ANI 11111000B   ;REMOVE PREVIOUS COMMAND
FC10: B1                  394 |     ORA C   ;SET TO NEW COMMAND
FC11: 77                  395 |     MOV M,A ;REPLACED IN IOPB
                          396 | ;   THE MDS-800 CONTROLLER REQUIRES DISK BANK BIT IN SECTOR BYTE
                          397 | ;   MASK THE BIT FROM THE CURRENT I/O FUNCTION
                          398 | ;   ANI 00100000B   ;MASK THE DISK SELECT BIT
                          399 | ;   LXI H,IOS       ;ADDRESS THE SECTOR SELECT BYTE
                          400 | ;   ORA M       ;SELECT PROPER DISK BANK
                          401 | ;   MOV M,A     ;SET DISK SELECT BIT ON/OFF
                          402 | ;   FOR MDS-800 CONTROLLER UNCOMMENT ABOVE CODE FOR DISK MASKING
                          403 | ;   IF NECESSARY. MAKE SURE YOU UNDERSTAND WHAT YOU ARE DOING
FC12: C9                  404 |     RET
                          405 | 
                          406 | ;
                          407 | WAITIO:
FC13: 0E 0A               408 |     MVI C,RETRY ;MAX RETRIES BEFORE PERM ERROR
                          409 | REWAIT:
                          410 | ;   START THE I/O FUNCTION AND WAIT FOR COMPLETION
FC15: DB 79               411 |     IN  RTYPE   ;IN RTYPE


Assembly Listing                                                                                                 Page: 9
