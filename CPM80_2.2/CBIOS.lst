                            1 | ;   Skeletal CBIOS for first level of CP/M 2.0 alteration
                            2 | ;
                            3 | msize   equ 20  ;cp/m version memory size in kilobytes
                            4 | ;
                            5 | ;   "bias" is address offset from 3400H for memory systems
                            6 | ;   than 16K (referred to as "b" throughout the text).
                            7 | ;
                            8 | bias    equ (msize-20)*1024
                            9 | ccp equ 3400H+bias  ;base of ccp
                           10 | bdos    equ ccp+806h    ;base of bdos
                           11 | bios    equ ccp+1600h   ;base of bios
                           12 | cdisk   equ 0004H   ;current disk number 0=A,...,15=P
                           13 | iobyte  equ 0003h   ;intel i/o byte
                           14 | ;
                           15 |     org bios    ;origin of this program
                           16 | nsects  equ ($-ccp)/128 ;warm start sector count
                           17 | ;
                           18 | ;   jump vector for individual subroutines
4A00: C3 9C 4A             19 |     jmp boot        ;cold start
4A03: C3 A6 4A             20 | wboote: jmp wboot       ;warm start
4A06: C3 11 4B             21 |     jmp const       ;console status
4A09: C3 24 4B             22 |     jmp conin       ;console character in
4A0C: C3 37 4B             23 |     jmp conout      ;console character out
4A0F: C3 49 4B             24 |     jmp list        ;list character out
4A12: C3 4D 4B             25 |     jmp punch       ;punch character out
4A15: C3 4F 4B             26 |     jmp reader      ;reader character out
4A18: C3 54 4B             27 |     jmp home        ;move head to home position
4A1B: C3 5A 4B             28 |     jmp seldsk      ;select disk
4A1E: C3 7D 4B             29 |     jmp settrk      ;set track number
4A21: C3 92 4B             30 |     jmp setsec      ;set sector number
4A24: C3 AD 4B             31 |     jmp setdma      ;set dma address
4A27: C3 C3 4B             32 |     jmp read        ;read disk
4A2A: C3 D6 4B             33 |     jmp write       ;write disk
4A2D: C3 4B 4B             34 |     jmp listst      ;return list status
4A30: C3 A7 4B             35 |     jmp sectran     ;sector translate
                           36 | ;
                           37 | ;   fixed data tables for four-drive standard
                           38 | ;   IBM-compatible 8" disks
                           39 | ;   disk parameter header for disk 00
4A33: 73 4A 00 00          40 | dpbase: dw  trans,0000H
4A37: 00 00 00 00          41 |     dw  0000H,0000H
4A3B: F0 4C 8D 4A          42 |     dw  dirbf,dpblk
4A3F: EC 4D 70 4D          43 |     dw  chk00,all00
                           44 | ;   disk parameter header for disk 01
4A43: 73 4A 00 00          45 |     dw  trans,0000H
4A47: 00 00 00 00          46 |     dw  0000H,0000H
4A4B: F0 4C 8D 4A          47 |     dw  dirbf,dpblk
4A4F: FC 4D 8F 4D          48 |     dw  chk01,all01
                           49 | ;   disk parameter header for disk 02
4A53: 73 4A 00 00          50 |     dw  trans,0000H
4A57: 00 00 00 00          51 |     dw  0000H,0000H
4A5B: F0 4C 8D 4A          52 |     dw  dirbf,dpblk
4A5F: 0C 4E AE 4D          53 |     dw  chk02,all02
                           54 | ;   disk parameter header for disk 03
4A63: 73 4A 00 00          55 |     dw  trans,0000H
4A67: 00 00 00 00          56 |     dw  0000H,0000H


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

4A6B: F0 4C 8D 4A          57 |     dw  dirbf,dpblk
4A6F: 1C 4E CD 4D          58 |     dw  chk03,all03
                           59 | ;
                           60 | ;   sector translate vector
4A73: 01 07 0D 13          61 | trans:  db  1,7,13,19   ;sectors 1,2,3,4
4A77: 19 05 0B 11          62 |     db  25,5,11,17  ;sectors 5,6,7,8
4A7B: 17 03 09 0F          63 |     db  23,3,9,15   ;sectors 9,10,11,12
4A7F: 15 02 08 0E          64 |     db  21,2,8,14   ;sectors 13,14,15,16
4A83: 14 1A 06 0C          65 |     db  20,26,6,12  ;sectors 17,18,19,20
4A87: 12 18 04 0A          66 |     db  18,24,4,10  ;sectors 21,22,23,24
4A8B: 10 16                67 |     db  16,22       ;sectors 25,26
                           68 | ;
                           69 | dpblk:  ;disk parameter block, common to all disks
4A8D: 1A 00                70 |     dw  26      ;sectors per track
4A8F: 03                   71 |     db  3       ;block shift factor
4A90: 07                   72 |     db  7       ;block mask
4A91: 00                   73 |     db  0       ;null mask
4A92: F2 00                74 |     dw  242     ;disk size-1
4A94: 3F 00                75 |     dw  63      ;directory max
4A96: C0                   76 |     db  192     ;alloc 0
4A97: 00                   77 |     db  0       ;alloc 1
4A98: 10 00                78 |     dw  16      ;check size
4A9A: 02 00                79 |     dw  2       ;track offset
                           80 | ;
                           81 | ;   end of fixed tables
                           82 | ;
                           83 | ;   individual subroutines to perform each function
                           84 | boot:   ;simplest case is to just perform parameter initialization
4A9C: AF                   85 |     xra a       ;zero in the accum
4A9D: 32 03 00             86 |     sta iobyte      ;clear the iobyte
4AA0: 32 04 00             87 |     sta cdisk       ;select disk zero
4AA3: C3 EF 4A             88 |     jmp gocpm       ;initialize and go to cp/m
                           89 | ;
                           90 | wboot:  ;simplest case is to read the disk until all sectors loaded
4AA6: 31 80 00             91 |     lxi sp,80h      ;use space below buffer for stack
4AA9: 0E 00                92 |     mvi c,0     ;select disk 0
4AAB: CD 5A 4B             93 |     call    seldsk
4AAE: CD 54 4B             94 |     call    home        ;go to track 00
                           95 | ;
4AB1: 06 2C                96 |     mvi b,nsects    ;b counts # of sectors to load
4AB3: 0E 00                97 |     mvi c,0     ;c has the current track number
4AB5: 16 02                98 |     mvi d,2     ;d has the next sector to read
                           99 | ;   note that we begin by reading track 0, sector 2 since sector 1
                          100 | ;   contains the cold start loader, which is skipped in a warm start
4AB7: 21 00 34            101 |     lxi h,ccp       ;base of cp/m (initial load point)
                          102 | load1:  ;load one more sector
4ABA: C5                  103 |     push    b   ;save sector count, current track
4ABB: D5                  104 |     push    d   ;save next sector to read
4ABC: E5                  105 |     push    h   ;save dma address
4ABD: 4A                  106 |     mov c,d ;get sector address to register c
4ABE: CD 92 4B            107 |     call    setsec  ;set sector address from register c
4AC1: C1                  108 |     pop b   ;recall dma address to b,c
4AC2: C5                  109 |     push    b   ;replace on stack for later recall
4AC3: CD AD 4B            110 |     call    setdma  ;set dma address from b,c
                          111 | ;
                          112 | ;   drive set to 0, track set, sector set, dma address set


Assembly Listing                                                                                                 Page: 3
------------------------------------------------------------------------------------------------------------------------

4AC6: CD C3 4B            113 |     call    read
4AC9: FE 00               114 |     cpi 00h ;any errors?
4ACB: C2 A6 4A            115 |     jnz wboot   ;retry the entire boot if an error occurs
                          116 | ;
                          117 | ;   no error, move to next sector
4ACE: E1                  118 |     pop h   ;recall dma address
4ACF: 11 80 00            119 |     lxi d,128   ;dma=dma+128
4AD2: 19                  120 |     dad d   ;new dma address is in h,l
4AD3: D1                  121 |     pop d   ;recall sector address
4AD4: C1                  122 |     pop b   ;recall number of sectors remaining, and current trk
4AD5: 05                  123 |     dcr b   ;sectors=sectors-1
4AD6: CA EF 4A            124 |     jz  gocpm   ;transfer to cp/m if all have been loaded
                          125 | ;
                          126 | ;   more sectors remain to load, check for track change
4AD9: 14                  127 |     inr d
4ADA: 7A                  128 |     mov a,d ;sector=27?, if so, change tracks
4ADB: FE 1B               129 |     cpi 27
4ADD: DA BA 4A            130 |     jc  load1   ;carry generated if sector<27
                          131 | ;
                          132 | ;   end of current track, go to next track
4AE0: 16 01               133 |     mvi d,1 ;begin with first sector of next track
4AE2: 0C                  134 |     inr c   ;track=track+1
                          135 | ;
                          136 | ;   save register state, and change tracks
4AE3: C5                  137 |     push    b
4AE4: D5                  138 |     push    d
4AE5: E5                  139 |     push    h
4AE6: CD 7D 4B            140 |     call    settrk  ;track address set from register c
4AE9: E1                  141 |     pop h
4AEA: D1                  142 |     pop d
4AEB: C1                  143 |     pop b
4AEC: C3 BA 4A            144 |     jmp load1   ;for another sector
                          145 | ;
                          146 | ;   end of load operation, set parameters and go to cp/m
                          147 | gocpm:
4AEF: 3E C3               148 |     mvi a,0c3h  ;c3 is a jmp instruction
4AF1: 32 00 00            149 |     sta 0   ;for jmp to wboot
4AF4: 21 03 4A            150 |     lxi h,wboote    ;wboot entry point
4AF7: 22 01 00            151 |     shld    1   ;set address field for jmp at 0
                          152 | ;
4AFA: 32 05 00            153 |     sta 5   ;for jmp to bdos
4AFD: 21 06 3C            154 |     lxi h,bdos  ;bdos entry point
4B00: 22 06 00            155 |     shld    6   ;address field of jump at 5 to bdos
                          156 | ;
4B03: 01 80 00            157 |     lxi b,80h   ;default dma address is 80h
4B06: CD AD 4B            158 |     call    setdma
                          159 | ;
4B09: FB                  160 |     ei      ;enable the interrupt system
4B0A: 3A 04 00            161 |     lda cdisk   ;get current disk number
4B0D: 4F                  162 |     mov c,a ;send to the ccp
4B0E: C3 00 34            163 |     jmp ccp ;go to cp/m for further processing
                          164 | ;
                          165 | ;
                          166 | ;   simple i/o handlers (must be filled in by user)
                          167 | ;   in each case, the entry point is provided, with space reserved
                          168 | ;   to insert your own code


Assembly Listing                                                                                                 Page: 4
------------------------------------------------------------------------------------------------------------------------

                          169 | ;
                          170 | const:  ;console status, return 0ffh if character ready, 00h if not
4B11:                     171 |     ds  10h ;space for status subroutine
4B21: 3E 00               172 |     mvi a,00h
4B23: C9                  173 |     ret
                          174 | ;
                          175 | conin:  ;console character into register a
4B24:                     176 |     ds  10h ;space for input routine
4B34: E6 7F               177 |     ani 7fh ;strip parity bit
4B36: C9                  178 |     ret
                          179 | ;
                          180 | conout: ;console character output from register c
4B37: 79                  181 |     mov a,c ;get to accumulator
4B38:                     182 |     ds  10h ;space for output routine
4B48: C9                  183 |     ret
                          184 | ;
                          185 | list:   ;list character from register c
4B49: 79                  186 |     mov a,c ;character to register a
4B4A: C9                  187 |     ret     ;null subroutine
                          188 | ;
                          189 | listst: ;return list status (0 if not ready, 1 if ready)
4B4B: AF                  190 |     xra a   ;0 is always ok to return
4B4C: C9                  191 |     ret
                          192 | ;
                          193 | punch:  ;punch character from register c
4B4D: 79                  194 |     mov a,c ;character to register a
4B4E: C9                  195 |     ret     ;null subroutine
                          196 | ;
                          197 | ;
                          198 | reader: ;read character into register a from reader device
4B4F: 3E 1A               199 |     mvi a,1ah   ;enter end of file for now (replace later)
4B51: E6 7F               200 |     ani 7fh ;remember to strip parity bit
4B53: C9                  201 |     ret
                          202 | ;
                          203 | ;
                          204 | ;   i/o drivers for the disk follow
                          205 | ;   for now, we will simply store the parameters away for use
                          206 | ;   in the read and write subroutines
                          207 | ;
                          208 | home:   ;move to the track 00 position of current drive
                          209 | ;   translate this call into a settrk call with parameter 00
4B54: 0E 00               210 |     mvi c,0 ;select track 0
4B56: CD 7D 4B            211 |     call    settrk
4B59: C9                  212 |     ret     ;we will move to 00 on first read/write
                          213 | ;
                          214 | seldsk: ;select disk given by register C
4B5A: 21 00 00            215 |     lxi h,0000h ;error return code
4B5D: 79                  216 |     mov a,c
4B5E: 32 EF 4C            217 |     sta diskno
4B61: FE 04               218 |     cpi 4   ;must be between 0 and 3
4B63: D0                  219 |     rnc     ;no carry if 4,5,...
                          220 | ;   disk number is in the proper range
4B64:                     221 |     ds  10  ;space for disk select
                          222 | ;   compute proper disk parameter header address
4B6E: 3A EF 4C            223 |     lda diskno
4B71: 6F                  224 |     mov l,a ;L=disk number 0,1,2,3


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

4B72: 26 00               225 |     mvi h,0 ;high order zero
4B74: 29                  226 |     dad h   ;*2
4B75: 29                  227 |     dad h   ;*4
4B76: 29                  228 |     dad h   ;*8
4B77: 29                  229 |     dad h   ;*16 (size of each header)
4B78: 11 33 4A            230 |     lxi d,dpbase
4B7B: 19                  231 |     dad d   ;HL=.dpbase(diskno*16)
4B7C: C9                  232 |     ret
                          233 | ;
                          234 | settrk: ;set track given by register c
4B7D: 79                  235 |     mov a,c
4B7E: 32 E9 4C            236 |     sta track
4B81:                     237 |     ds  10h ;space for track select
4B91: C9                  238 |     ret
                          239 | ;
                          240 | setsec: ;set sector given by register c
4B92: 79                  241 |     mov a,c
4B93: 32 EB 4C            242 |     sta sector
4B96:                     243 |     ds  10h ;space for sector select
4BA6: C9                  244 |     ret
                          245 | ;
                          246 | sectran:
                          247 |     ;translate the sector given by BC using the
                          248 |     ;translate table given by DE
4BA7: EB                  249 |     xchg        ;HL=.trans
4BA8: 09                  250 |     dad b   ;HL=.trans(sector)
4BA9: 6E                  251 |     mov l,m ;L = trans(sector)
4BAA: 26 00               252 |     mvi h,0 ;HL= trans(sector)
4BAC: C9                  253 |     ret     ;with value in HL
                          254 | ;
                          255 | setdma: ;set dma address given by registers b and c
4BAD: 69                  256 |     mov l,c ;low order address
4BAE: 60                  257 |     mov h,b ;high order address
4BAF: 22 ED 4C            258 |     shld    dmaad   ;save the address
4BB2:                     259 |     ds  10h ;space for setting the dma address
4BC2: C9                  260 |     ret
                          261 | ;
                          262 | read:   ;perform read operation (usually this is similar to write
                          263 | ;   so we will allow space to set up read command, then use
                          264 | ;   common code in write)
4BC3:                     265 |     ds  10h ;set up read command
4BD3: C3 E6 4B            266 |     jmp waitio  ;to perform the actual i/o
                          267 | ;
                          268 | write:  ;perform a write operation
4BD6:                     269 |     ds  10h ;set up write command
                          270 | ;
                          271 | waitio: ;enter here from read and write to perform the actual i/o 
                          272 | ;   operation.  return a 00h in register a if the operation completes
                          273 | ;   properly, and 01h if an error occurs during the read or write
                          274 | ;
                          275 | ;   in this case, we have saved the disk number in 'diskno' (0,1)
                          276 | ;           the track number in 'track' (0-76)
                          277 | ;           the sector number in 'sector' (1-26)
                          278 | ;           the dma address in 'dmaad' (0-65535)
4BE6:                     279 |     ds  256 ;space reserved for I/O drivers
4CE6: 3E 01               280 |     mvi a,1 ;error condition


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

4CE8: C9                  281 |     ret     ;replaced when filled-in
                          282 | ;
                          283 | ;   the remainder of the CBIOS is reserved uninitialized
                          284 | ;   data area, and does not need to be a part of the
                          285 | ;   system memory image (the space must be available,
                          286 | ;   however, between "begdat" and "enddat").
                          287 | ;
4CE9:                     288 | track:  ds  2   ;two bytes for expansion
4CEB:                     289 | sector: ds  2   ;two bytes for expansion
4CED:                     290 | dmaad:  ds  2   ;direct memory address
4CEF:                     291 | diskno: ds  1   ;disk number 0-15
                          292 | ;
                          293 | ;   scratch ram area for BDOS use
                          294 | begdat  equ $   ;beginning of data area
4CF0:                     295 | dirbf:  ds  128 ;scratch directory area
4D70:                     296 | all00:  ds  31  ;allocation vector 0
4D8F:                     297 | all01:  ds  31  ;allocation vector 1
4DAE:                     298 | all02:  ds  31  ;allocation vector 2
4DCD:                     299 | all03:  ds  31  ;allocation vector 3
4DEC:                     300 | chk00:  ds  16  ;check vector 0
4DFC:                     301 | chk01:  ds  16  ;check vector 1
4E0C:                     302 | chk02:  ds  16  ;check vector 2
4E1C:                     303 | chk03:  ds  16  ;check vector 3
                          304 | ;
                          305 | enddat  equ $   ;end of data area
                          306 | datsiz  equ $-begdat;size of data area
                          307 |     end

