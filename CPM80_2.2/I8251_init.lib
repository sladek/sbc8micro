; Assuming 8251 Data Port = 0D8H, Command/Status Port = 0DAH
; Constants
usart_data  EQU 0F4H    ; Data port
usart_cmd   EQU 0F5H    ; Command/Status port

init_console:
    mvi a, 00H          ; 1. Send at least 3 nulls to ensure
    out usart_cmd       ;    the 8251 is in command mode.
    out usart_cmd
    out usart_cmd
    mvi a, 40H          ; 2. Internal Reset command
    out usart_cmd
    
    ; 3. Mode Instruction:
    ; Bits 0-1: 00 = Synchronous, 01 = 1x, 10 = 16x, 11 = 64x
    ; Bits 2-3: 00 = 5bit, 01 = 6bit, 10 = 7bit, 11 = 8bit
    ; Bits 4-5: Parity (00=none)
    ; Bits 6-7: Stop bits (01=1 stop)
    mvi a, 4FH          ; 0100 1110 -> 1 stop, no parity, 8 data, 64x baud
    out usart_cmd
    
    ; 4. Command Instruction:
    ; Enable Tx, Enable Rx, DTR, RTS
    mvi a, 37H          ; 0011 0111 -> TxEN, RxE, DTR, RTS
    out usart_cmd
    ret
