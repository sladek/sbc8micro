F118: B5                 1266 |     ORA L   ;  PREVIOUS CONTENTS OF
F119: 6F                 1267 |     MOV L,A ;   (BC) INTO (HL)
F11A: 78                 1268 |     MOV A,B ;
F11B: B4                 1269 |     ORA H   ;
F11C: 67                 1270 |     MOV H,A ;
F11D: C9                 1271 |     RET     ;RETURN W/ UPDATED VALUE IN (HL)
