                          382 | ;   BLANK OUT THE CURRENT CURSOR POSITION
                          383 | ;   BY BACKSPACE, SPACE.
                          384 | ;
EDA4: CD AC ED            385 | BLANK:  CALL    BLANK1  ;
EDA7: 0E 20               386 |     MVI C,' '   ;
EDA9: CD 0C FA            387 |     CALL    CONOUT  ;BIOS CALL/CONSOLE OUTPUT
EDAC: 0E 08               388 | BLANK1: MVI C,BCKSPA    ;
EDAE: C3 0C FA            389 |     JMP CONOUT  ;BIOS CALL/CONSOLE OUTPUT
                          390 | ;
                          391 | ;   BREAK OUT OF THE CURRENT DISPLAY LINE AND
                          392 | ;   START A NEW LINE. USED BY ^U (ABORT LINE),
                          393 | ;   AND ^R (RETYPE LINE) IN CONSOLE BUFFER INPUT.
                          394 | ;
EDB1: 0E 23               395 | BREAK:  MVI C,'#'   ;MARK THE EXIT POINT
EDB3: CD 48 ED            396 |     CALL    OUTPUT  ;
EDB6: CD C9 ED            397 |     CALL    PCRLF   ;START A NEW LINE
EDB9: 3A 0C EF            398 | BREAK1: LDA CHRCTR  ;OUTPUT BLANKS UNTIL COUNTERS MATCH
EDBC: 21 0B EF            399 |     LXI H,CHCTR2    ;
EDBF: BE                  400 |     CMP M   ;
EDC0: D0                  401 |     RNC     ;
EDC1: 0E 20               402 |     MVI C,' '   ;
EDC3: CD 48 ED            403 |     CALL    OUTPUT  ;
EDC6: C3 B9 ED            404 |     JMP BREAK1  ;
                          405 | ;
                          406 | ;   STANDARD CARRIAGE RETURN/LINE FEED SUBROUTINE
                          407 | ;
EDC9: 0E 0D               408 | PCRLF:  MVI C,CR    ;
EDCB: CD 48 ED            409 |     CALL    OUTPUT  ;
EDCE: 0E 0A               410 |     MVI C,LF    ;
EDD0: C3 48 ED            411 |     JMP OUTPUT  ;
