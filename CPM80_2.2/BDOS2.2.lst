                          503 | ;
                          504 | ;   CONTROL X....BACKSPACE OVER THE CONSOLE LINE
                          505 | ;   AND RESTART THE LINE INPUT. THIS SOUNDS LIKE
                          506 | ;   A NICE IDEA, BUT THINGS GET SCREWED UP BY
                          507 | ;   BACKSPACING THEN RETYPING AT TAB LOCATIONS,
                          508 | ;   AND BY CONTROL CHARACTERS BEING DISPLAYED AS
                          509 | ;   TWO CHARACTERS, BUT STORED IN MEMORY AS ONLY
                          510 | ;   ONE CHARACTER. IN SHORT, EXPECT TO SEE A MESS
                          511 | ;   EVERY SO OFTEN. CONTROL U IS REALLY BETTER.
                          512 | ;
EE48: FE 18               513 | LINE5:  CPI 18H ;^X
EE4A: C2 5F EE            514 |     JNZ LINE7   ;
EE4D: E1                  515 |     POP H   ;
EE4E: 3A 0B EF            516 | LINE6:  LDA CHCTR2  ;WIPE OUT CHARACTERS UNTIL THE COUNTERS MATCH
EE51: 21 0C EF            517 |     LXI H,CHRCTR    ;
EE54: BE                  518 |     CMP M   ;
EE55: D2 E1 ED            519 |     JNC COM10   ;THEY MATCH, SO RESTART CONSOLE INPUT
EE58: 35                  520 |     DCR M   ;
EE59: CD A4 ED            521 |     CALL    BLANK   ;DESTRUCTIVE BACKSPACE
EE5C: C3 4E EE            522 |     JMP LINE6   ;
                          523 | ;
                          524 | ;   CONTROL U....ABORT OUT OF CURRENT INPUT LINE
                          525 | ;   AND START OVER AGAIN.
