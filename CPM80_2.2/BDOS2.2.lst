                         2858 | ;
                         2859 | ;   SET UP THE DISK PARAMETERS
                         2860 | ;
                         2861 | ;   ALL BDOS COMMANDS THAT USE THE DISKS MUST
                         2862 | ;   MAKE A PASS THROUGH THIS SUBROUTINE
                         2863 | ;
                         2864 | ;   NOTE:
                         2865 | ;       THE DIGITAL RESEARCH DOCUMENTATION DOES
                         2866 | ;       NOT MENTION WHAT IS DONE WITH THE USER
                         2867 | ;       NUMBER. WELL HERE IT IS.....
                         2868 | ;       THE USER NUMBER IS PUT INTO THE FIRST
                         2869 | ;       BYTE OF THE DIRECTORY ENTRY. USER 0
                         2870 | ;       IS THEREFORE COMPATIBLE WITH CP/M 1.4
                         2871 | ;       BUT HIGHER USER NUMBERS ARE NOT.
                         2872 | ;       TRY CREATING A DUMMY FILE WITH VARIOUS
                         2873 | ;       USER NUMBERS, THEN INSPECTING THE
                         2874 | ;       DIRECTORY TRACK WITH SPAT.
                         2875 | ;       THIS PIECE OF CODE PUTS THE CURRENT
                         2876 | ;       USER NUMBER INTO THE START OF THE
                         2877 | ;       FILE CONTROL BLOCK SO THAT A MATCH CAN
                         2878 | ;       BE MADE DURING DIRECTORY SEARCHES.
                         2879 | ;
F851: 3E FF              2880 | SETUP:  MVI A,0FFH  ;SET FLAG TO TELL BDOS2 THAT
F853: 32 DE F9           2881 |     STA SETUPF  ;  THE DISKS HAVE BEEN USED
F856: 2A 43 EF           2882 |     LHLD    ENTPAR  ;(HL) <-- ENTRY PARAMETER
F859: 7E                 2883 |     MOV A,M ;GET THE DISK NUMBER FROM FCB
F85A: E6 1F              2884 |     ANI 1FH ;DISK NUMBER TO BE IN RANGE OF
                         2885 |             ;0 TO 1FH. I.E. DRIVES A THROUGH P
F85C: 3D                 2886 |     DCR A   ;
F85D: 32 D6 F9           2887 |     STA PARAM1  ;STORE IT FOR SELDSK
F860: FE 1E              2888 |     CPI 1EH ;
F862: D2 75 F8           2889 |     JNC SETUP1  ;SKIP OVER- ACCESSING LOGGED IN DISK
                         2890 | ;
F865: 3A 42 EF           2891 |     LDA CURDSK  ;SAVE CURRENT DISK NUMBER IN
F868: 32 DF F9           2892 |     STA LOGDSK  ;LOGDSK FOR RESTORING ON EXIT
F86B: 7E                 2893 |     MOV A,M ;GET DISK NUMBER FROM FCB AGAIN
F86C: 32 E0 F9           2894 |     STA DISKNO  ;SAVE IT
                         2895 | ;
                         2896 | ;   THE REASON FOR SETTING THE UPPER 3 BITS OF
                         2897 | ;   (FCB+12) WITH THE UPPER 3 BITS OF THE DRIVE
                         2898 | ;   NUMBER BROUGHT IN IN THE ENTRY PARAMETER IS
                         2899 | ;   NOT DOCUMENTED. THIS MAY BE SOME SORT OF
                         2900 | ;   PASSWORD SECURITY SYSTEM
                         2901 | ;
