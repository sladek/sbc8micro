                         1808 | ;
                         1809 | ;   SEARCH FOR OCCURENCE OF FILE NAME IN DIRECTORY
                         1810 | ;
                         1811 | ;   SERCHF IS INITIAL ENTRY POINT WHICH LEAVES
                         1812 | ;   FCB VECTOR FOR USE BY SUBSEQUENT SEARCHES
                         1813 | ;   WHICH ENTER BY WAY OF SERCHN. NO OTHER BDOS
                         1814 | ;   CALLS WHICH MAKE USE OF SRCHFP BETWEEN THE
                         1815 | ;   INTIAL CALL TO SERCHF AND CALLS TO SERCHN ARE
                         1816 | ;   ARE ALLOWED OR ELSE RATHER STRANGE THINGS MAY HAPPEN.
                         1817 | ;   REMEMBER THAT BDOS IS NOT DESIGNED FOR RECURSIVE CALLS
                         1818 | ;   AND STORED VALUES ARE OVERWRITTEN INSTEAD OF BEING
                         1819 | ;   PUSHED UP ONTO A LOCAL STACK.
                         1820 | ;
                         1821 | ;   SERCHF INITIATES (SRCHFL) TO 0FFH.
                         1822 | ;   A SUCCESSFUL MATCH CLEARS IT TO 00
                         1823 | ;
                         1824 | ;   ENTRY PARAMETER:    (C)= NUMBER OF BYTES TO BE MATCHED
                         1825 | ;               THIS COUNT IS STORED IN (SRCHCT)
                         1826 | ;               FOR SUBSEQUENT CALLS TO SERCHN
                         1827 | ;
F318: 3E FF              1828 | SERCHF: MVI A,0FFH  ;SEARCH FOR FIRST OCCURENCE OF FILE NAME
F31A: 32 D4 F9           1829 |     STA SRCHFL  ;POINTER SET BY SERCHF FOR USE BY SERCHN
F31D: 21 D8 F9           1830 |     LXI H,SRCHCT ;SEARCH BYTE COUNTER
F320: 71                 1831 |     MOV M,C ;
