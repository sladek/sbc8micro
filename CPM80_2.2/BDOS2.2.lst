                          671 | ;   COMMENT:
                          672 | ;       The use of '$', or for that matter any printable
                          673 | ;       character, is inconvenient. Business programs
                          674 | ;       cannot use this command if a dollar sign is to
                          675 | ;       be printed in the string. The proper way to
                          676 | ;       mark the end of a literal is with a null or
                          677 | ;       by setting MSB.
                          678 | ;
EEF8: EB                  679 | COM09:  XCHG        ;MOVE POINTER TO START OF STRING FROM
EEF9: 4D                  680 |     MOV C,L ;(DE) TO (HL), AND THEN TO (BC). WHY
EEFA: 44                  681 |     MOV B,H ;THE GRAND TOUR??
EEFB: C3 D3 ED            682 |     JMP PRNSTR  ;WHY JUMP BACK TO PRNSTR INSTEAD
                          683 |             ;OF HAVING THE CODE RIGHT HERE? ARE WE
                          684 |             ;TO BELIEVE THAT THIS WAS DONE IN THE
                          685 |             ;NAME OF STRUCTURED PROGRAMMING?
                          686 | ;
                          687 | ;   BDOS COMMAND #11....GET CONSOLE INPUT STATUS
                          688 | ;       RETURNS 00 IF NO KEY PRESSED, ELSE 01
                          689 | ;
                          690 | ;   NOTE:
                          691 | ;       This command is not quite compatible with
                          692 | ;       CP/M 1.4 or 2.0 because if a ' ' is pressed
                          693 | ;       the console then waits for another input,
                          694 | ;       and reboots if that input is ^C. If the
                          695 | ;       second input is not ^C, then Command 11
                          696 | ;       returns like nothing happened, but has
                          697 | ;       swallowed the ' '. This does strange things
                          698 | ;       with some older CPMUG programs like Tiny
                          699 | ;       Basic with polled Command 11 until a key
                          700 | ;       was pressed. If you try some of these
                          701 | ;       programs which ran fine under 1.4, but
                          702 | ;       do strange things under 2.2, this may be
                          703 | ;       the place to look.
                          704 | ;
EEFE: CD 23 ED            705 | COM11:  CALL    KBSTAT  ;GET CONSOLE STATUS
EF01: 32 45 EF            706 | EXIT1:  STA RETPAR  ; STORE THE RETURN PARAMETER
EF04: C9                  707 | DUMMY:  RET     ;(USED AS EXIT POINT FOR COM38 AND
                          708 |             ;COM39)
