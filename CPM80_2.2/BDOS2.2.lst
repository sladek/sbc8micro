F3DB: 13                 1994 |     INX D   ;
F3DC: C5                 1995 |     PUSH    B   ;
F3DD: D5                 1996 |     PUSH    D   ;
F3DE: 42                 1997 |     MOV B,D ;
F3DF: 4B                 1998 |     MOV C,E ;
F3E0: CD 35 F2           1999 |     CALL    GETALC  ;GET STATUS OF ALLOCATION BLOCK IN LSB OF (A)
F3E3: 1F                 2000 |     RAR     ;
