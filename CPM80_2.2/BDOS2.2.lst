                          736 | ;
EF47: 21 0B EC            737 | SELERR: LXI H,ERR2  ;DISK SELECT ERROR
                          738 | ;
EF4A: 5E                  739 | ERROR:  MOV E,M ;Move (Vector) to (DE)
EF4B: 23                  740 |     INX H   ;
EF4C: 56                  741 |     MOV D,M ;
EF4D: EB                  742 |     XCHG        ;Swap it to (HL)
EF4E: E9                  743 |     PCHL        ; and do the indirect jump
                          744 | ;
                          745 | ;   BLOCK MOVE SUBROUTINE
                          746 | ;
                          747 | ;   ENTRY PARAMETERS:
                          748 | ;       (HL)    DESTINATION
                          749 | ;       (DE)    SOURCE
                          750 | ;       (C) BYTE COUNT
                          751 | ;
                          752 | ;   NOTE:
                          753 | ;       Z80 users may want to eliminate this and
                          754 | ;       use LDIR with a suitable swapping of the
                          755 | ;       HL and DE register pairs & using (BC)
                          756 | ;       of just (C) as the counter.
                          757 | ;
EF4F: 0C                  758 | BLKMOV: INR C   ;
EF50: 0D                  759 | BLMOV1: DCR C   ;
EF51: C8                  760 |     RZ      ;
EF52: 1A                  761 |     LDAX    D   ;
EF53: 77                  762 |     MOV M,A ;
EF54: 13                  763 |     INX D   ;
EF55: 23                  764 |     INX H   ;
EF56: C3 50 EF            765 |     JMP BLMOV1  ;
                          766 | ;
                          767 | ;   SET UP DISK PARAMETERS WHEN LOGGIN IN A NEW DISK
                          768 | ;
                          769 | ;   THE VARIOUS PARAMETERS FROM BIOS ARE MOVE TO
                          770 | ;   WHERE BDOS CAN USED THEM. THE LOCATION  OF THE
                          771 | ;   DISK SIZE, DIRECTORY TRACK ETC. ARE MOVED TO
                          772 | ;   A PARAMETER BLOCK AT THE END OF BDOS.
                          773 | ;


Assembly Listing                                                                                                Page: 15
------------------------------------------------------------------------------------------------------------------------

                          774 | ;   NOTE:
                          775 | ;       1.  If the program involves much action
                          776 | ;       between disk drives, considerable time
                          777 | ;       can be wasted in this swapping process.
                          778 | ;       This may be an area where improvemnts
                          779 | ;       can be made.
                          780 | ;
                          781 | ;       2.  If the disk is not a single sided,
                          782 | ;       double density 5 1/4" or a single density
                          783 | ;       8", and can thus hold more than 255K, then
                          784 | ;       the block numbers must be double precision
                          785 | ;       and will occupy 2 bytes. Consequently a
                          786 | ;       single directory extent can only hold 8
                          787 | ;       block numbers, and therefore 8K if 1K
                          788 | ;       blocks are used. In order to get enough
                          789 | ;       directory space either the number of
                          790 | ;       directory entries must be increased, or
                          791 | ;       the block size increased to 2K. For
                          792 | ;       more details on this read the Digital
                          793 | ;       Research documentation (and you will
                          794 | ;       get thoroughly confused).
                          795 | ;
EF59: 3A 42 EF            796 | SETDSK: LDA CURDSK  ;GET THE NUMBER OF THE DISK
EF5C: 4F                  797 |     MOV C,A ;
EF5D: CD 1B FA            798 |     CALL    SELDSK  ;BIOS CALL/SELECT DISK DRIVE
EF60: 7C                  799 |     MOV A,H ;IF SELDSK RETURNS (HL)= 0000H
EF61: B5                  800 |     ORA L   ;YOU ARE TRYING TO ACCESS A
EF62: C8                  801 |     RZ      ;NONEXISTENT DRIVE. ERROR RETURN.
                          802 | ;
                          803 | ;   LEGAL DRIVE- LET'S SET THINGS UP
                          804 | ;
                          805 | ;   SELDSK RETURNS WITH POINTER TO START OF DISK
                          806 | ;   PARAMETER BLOCK IN (HL). THE BLOCK CONTAINS
                          807 | ;   8 DATA WORDS:
                          808 | ;           DW  TRANS   ;START OF SECTOR TRANS  TABLE
                          809 | ;           DW  DWORD1  ;
                          810 | ;           DW  DWORD2  ;
                          811 | ;           DW  DWORD3  ;
                          812 | ;           DW  DIRBUF  ;DIRECTORY BUFFER LOCATION
                          813 | ;           DW  DPBLK   ;DISK PARAMETER BLOCK LOCATION
                          814 | ;           DW  CHKxx   ;CHECK VECTOR, DRIVE xx
                          815 | ;           DW  ALLxx   ;ALLOCATION BLOCK VECTOR, DRIVE xx
                          816 | ;
EF63: 5E                  817 |     MOV E,M ;
EF64: 23                  818 |     INX H   ;
EF65: 56                  819 |     MOV D,M ;(DE) <-- ((TRANS))
EF66: 23                  820 |     INX H   ;
EF67: 22 BE F9            821 |     SHLD    DWORD1  ;
EF6A: 23                  822 |     INX H   ;
EF6B: 23                  823 |     INX H   ;
EF6C: 22 C0 F9            824 |     SHLD    DWORD2  ;
EF6F: 23                  825 |     INX H   ;
EF70: 23                  826 |     INX H   ;
EF71: 22 C2 F9            827 |     SHLD    DWORD3  ;
EF74: 23                  828 |     INX H   ;
EF75: 23                  829 |     INX H   ;


