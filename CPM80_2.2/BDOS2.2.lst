                          388 | ;
                          389 | ;   BLANK OUT THE CURRENT CURSOR POSITION
                          390 | ;   BY BACKSPACE, SPACE.
                          391 | ;
EDA4: CD AC ED            392 | BLANK:  CALL    BLANK1  ;
EDA7: 0E 20               393 |     MVI C,' '   ;
EDA9: CD 0C FA            394 |     CALL    CONOUT  ;BIOS CALL/CONSOLE OUTPUT
EDAC: 0E 08               395 | BLANK1: MVI C,BCKSPA    ;
EDAE: C3 0C FA            396 |     JMP CONOUT  ;BIOS CALL/CONSOLE OUTPUT
                          397 | ;
                          398 | ;   BREAK OUT OF THE CURRENT DISPLAY LINE AND
                          399 | ;   START A NEW LINE. USED BY ^U (ABORT LINE),
                          400 | ;   AND ^R (RETYPE LINE) IN CONSOLE BUFFER INPUT.
                          401 | ;
EDB1: 0E 23               402 | BREAK:  MVI C,'#'   ;MARK THE EXIT POINT
EDB3: CD 48 ED            403 |     CALL    OUTPUT  ;
EDB6: CD C9 ED            404 |     CALL    PCRLF   ;START A NEW LINE
EDB9: 3A 0C EF            405 | BREAK1: LDA CHRCTR  ;OUTPUT BLANKS UNTIL COUNTERS MATCH
EDBC: 21 0B EF            406 |     LXI H,CHCTR2    ;
EDBF: BE                  407 |     CMP M   ;
EDC0: D0                  408 |     RNC     ;
EDC1: 0E 20               409 |     MVI C,' '   ;
EDC3: CD 48 ED            410 |     CALL    OUTPUT  ;
EDC6: C3 B9 ED            411 |     JMP BREAK1  ;
                          412 | ;
                          413 | ;   STANDARD CARRIAGE RETURN/LINE FEED SUBROUTINE
                          414 | ;
