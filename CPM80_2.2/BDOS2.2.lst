                         2817 | ;   STRAIGHT LINE? ANYBODY FOR STRUCTURED CODE??
                         2818 | ;
F821: 2A AF F9           2819 | LOGIN:  LHLD    LOGVEC  ;LOG IN VECTOR
F824: 3A 42 EF           2820 |     LDA CURDSK  ;
F827: 4F                 2821 |     MOV C,A ;
