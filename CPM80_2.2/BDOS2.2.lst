                         2684 | ;
                         2685 | ;   COMPUTE ABSOLUTE SECTOR NUMBER FOR FSIZE & COM36
                         2686 | ;
                         2687 | ;ENTRY PARAMETERS:
                         2688 | ;       WHEN CALLED  BY FSIZE
                         2689 | ;       (HL)= POINTER TO CURRENT ENTRY IN DIRECTORY
                         2690 | ;             BUFFER.
                         2691 | ;       (DE)= 15. OFFSET TO DIRECTORY RECORD COUNTER
                         2692 | ;
                         2693 | ;       WHEN CALLED BY COM36
                         2694 | ;       (HL)= POINTER TO  FCB, I.E. (ENTPAR)
                         2695 | ;       (DE)= 32. OFFSET TO RANDOM READ/WRITE COUNTER
                         2696 | ;
                         2697 | ;ON EXIT:
                         2698 | ;       REGISTERS A,B & C HOLD TRIPLE PRECISION SECTOR
                         2699 | ;       NUMBER IN THE FOLLOWING FORMAT:
                         2700 | ;           (C) LOW ORDER BYTE
                         2701 | ;           (B) HIGH ORDER BYTE
                         2702 | ;           (A) OVERFLOW
                         2703 | ;
                         2704 | ;   (A) (B) (C) <-- (BYTE14).AND.0FH*2^12+(BYTE12).AND.1FH*2^7+(BYTE32)or(BYTE15)
                         2705 | ;
