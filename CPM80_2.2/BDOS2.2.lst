------------------------------------------------------------------------------------------------------------------------

EF76: EB                  830 |     XCHG        ;
EF77: 22 D0 F9            831 |     SHLD    SECTBL  ;
                          832 | ;   
                          833 | ;   (DE) NOW POINTS TO DIRBUF IN PARAMETER TABLE.
                          834 | ;   THE FOLLOWING ARE NOW MOVED INTO BDOS PARAMETER AREA:
                          835 | ;
                          836 | ;   (DIRBUF)    POINTER TO DIRECTORY BUFFER
                          837 | ;   (DPBLK)     POINTER TO DISK PARAMETER BLOCK
                          838 | ;   (CHKxx)     POINTER TO DIRECTORY CHECKSUM BLOCK
                          839 | ;   (ALLxx)     POINTER TO ALLOCATION BLOCK MAP
                          840 | ;
EF7A: 21 B9 F9            841 |     LXI H,DIRBPT    ;DIRECTORY BUFFER POINTER
EF7D: 0E 08               842 |     MVI C,08H   ;
EF7F: CD 4F EF            843 |     CALL    BLKMOV  ;
                          844 | ;
                          845 | ;   THE DISK PARAMETER BLOCK IS NOW MOVED INTO
                          846 | ;   BDOS'S PARAMETER AREA. THIS BLOCK IS 15
                          847 | ;   BYTES LONG AND CONTAINS THE FOLLOWING:
                          848 | ;   (VALUES GIVEN ARE FOR 8" SINGLE DENSITY)
                          849 | ;
                          850 | ;       DW  26  ;SECTORS PER TRACK
                          851 | ;       DB  3   ;BLOCK SHIFT FACTOR
                          852 | ;       DB  7   ;BLOCK MASK
                          853 | ;       DB  0   ;NULL MASK
                          854 | ;       DW  242 ;DISK SIZE -1
                          855 | ;       DW  63  ;DIRECTORY ENTRIES -1
                          856 | ;       DB  192 ;ALLOC 0
                          857 | ;       DB  0   ;ALLOC 1
                          858 | ;       DB  2   ;DIRECTORY TRACK OFFSET
                          859 | ;
EF82: 2A BB F9            860 |     LHLD    DPBLK   ;
EF85: EB                  861 |     XCHG        ;
EF86: 21 C1 F9            862 |     LXI H,SECTRS ;SECTORS PER TRACK=
                          863 |             ;HEAD OF DP BLOCK
EF89: 0E 0F               864 |     MVI C,0FH   ;
EF8B: CD 4F EF            865 |     CALL    BLKMOV  ;
                          866 | ;
                          867 | ;   DETERMINE IF WE ARE ON A 5 1/4" OR SINGLE DENSITY
                          868 | ;   8" DISK WHICH HAS A CAPACITY OF LESS THAN 256 K
                          869 | ;   OR IF WE ARE ON A BIG DISK THAT REQUIRES A DOUBLE
                          870 | ;   PRECISION BLOCK NUMBER.
                          871 | ;
EF8E: 2A C6 F9            872 |     LHLD    DSKSIZ  ;DISK SIZE, # OF 1K BLOCKS -1
EF91: 7C                  873 |     MOV A,H ;
EF92: 21 DD F9            874 |     LXI H,BIGDSK    ;8" SD: 0FFH, LARGE CAP DISK: 00H
EF95: 36 FF               875 |     MVI M,0FFH  ;
EF97: B7                  876 |     ORA A   ;
EF98: CA 9D EF            877 |     JZ  SETDS1  ;
EF9B: 36 00               878 |     MVI M,00H   ;
EF9D: 3E FF               879 | SETDS1: MVI A,0FFH  ;
EF9F: B7                  880 |     ORA A   ;RESET ZFLAG TO MARK NON-ERROR RETURN
EFA0: C9                  881 |     RET     ;
