F82B: E5                 2823 |     PUSH    H   ;
F82C: EB                 2824 |     XCHG        ;
F82D: CD 59 EF           2825 |     CALL    SETDSK  ;SET UP DISK PARAMETERS
F830: E1                 2826 |     POP H   ;
F831: CC 47 EF           2827 |     CZ  SELERR  ;DISK SELECT ERROR
F834: 7D                 2828 |     MOV A,L ;LOG IN BIT IN LSB(A)
F835: 1F                 2829 |     RAR     ;CHECK TO SEE IF ON MAP
F836: D8                 2830 |     RC      ;OK- DISK ALREADY LOGGED IN
F837: 2A AF F9           2831 |     LHLD    LOGVEC  ;LOG IN VECTOR
F83A: 4D                 2832 |     MOV C,L ;
F83B: 44                 2833 |     MOV B,H ;
