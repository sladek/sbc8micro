F11B: 21 01 00           1260 |     LXI H,0001  ;SET-BIT IN (HL)
F11E: CD 0F F1           1261 |     CALL    SHLHLC  ;SHIFT (HL) LEFT PER COUNT IN (C)
F121: C1                 1262 |     POP B   ;RESTORE PARAMETER
F122: 79                 1263 |     MOV A,C ;COMBINE SHIFTED SET-BIT WITH
F123: B5                 1264 |     ORA L   ;  PREVIOUS CONTENTS OF
F124: 6F                 1265 |     MOV L,A ;   (BC) INTO (HL)
F125: 78                 1266 |     MOV A,B ;
F126: B4                 1267 |     ORA H   ;
F127: 67                 1268 |     MOV H,A ;
F128: C9                 1269 |     RET     ;RETURN W/ UPDATED VALUE IN (HL)
