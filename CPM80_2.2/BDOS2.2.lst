                         1815 | ;
                         1816 | ;   SEARCH FOR OCCURENCE OF FILE NAME IN DIRECTORY
                         1817 | ;
                         1818 | ;   SERCHF IS INITIAL ENTRY POINT WHICH LEAVES
                         1819 | ;   FCB VECTOR FOR USE BY SUBSEQUENT SEARCHES
                         1820 | ;   WHICH ENTER BY WAY OF SERCHN. NO OTHER BDOS
                         1821 | ;   CALLS WHICH MAKE USE OF SRCHFP BETWEEN THE
                         1822 | ;   INTIAL CALL TO SERCHF AND CALLS TO SERCHN ARE
                         1823 | ;   ARE ALLOWED OR ELSE RATHER STRANGE THINGS MAY HAPPEN.
                         1824 | ;   REMEMBER THAT BDOS IS NOT DESIGNED FOR RECURSIVE CALLS
                         1825 | ;   AND STORED VALUES ARE OVERWRITTEN INSTEAD OF BEING
                         1826 | ;   PUSHED UP ONTO A LOCAL STACK.
                         1827 | ;
                         1828 | ;   SERCHF INITIATES (SRCHFL) TO 0FFH.
                         1829 | ;   A SUCCESSFUL MATCH CLEARS IT TO 00
                         1830 | ;
                         1831 | ;   ENTRY PARAMETER:    (C)= NUMBER OF BYTES TO BE MATCHED
                         1832 | ;               THIS COUNT IS STORED IN (SRCHCT)
                         1833 | ;               FOR SUBSEQUENT CALLS TO SERCHN
                         1834 | ;
F318: 3E FF              1835 | SERCHF: MVI A,0FFH  ;SEARCH FOR FIRST OCCURENCE OF FILE NAME
F31A: 32 D4 F9           1836 |     STA SRCHFL  ;POINTER SET BY SERCHF FOR USE BY SERCHN
F31D: 21 D8 F9           1837 |     LXI H,SRCHCT ;SEARCH BYTE COUNTER
F320: 71                 1838 |     MOV M,C ;
F321: 2A 43 EF           1839 |     LHLD    ENTPAR  ;ENTRY PARAMETER
F324: 22 D9 F9           1840 |     SHLD    SRCHFP  ;SEARCH FCB POINTER, SET BY SERCHF
F327: CD FE F1           1841 |     CALL    SETBC1  ;SET (BLCTR1) <-- -1
F32A: CD A1 EF           1842 |     CALL    SETDIR  ;
