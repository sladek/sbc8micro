EF52: 1A                  768 |     LDAX    D   ;
EF53: 77                  769 |     MOV M,A ;
EF54: 13                  770 |     INX D   ;
EF55: 23                  771 |     INX H   ;
EF56: C3 50 EF            772 |     JMP BLMOV1  ;
                          773 | ;
                          774 | ;   SET UP DISK PARAMETERS WHEN LOGGIN IN A NEW DISK
                          775 | ;
                          776 | ;   THE VARIOUS PARAMETERS FROM BIOS ARE MOVE TO
                          777 | ;   WHERE BDOS CAN USED THEM. THE LOCATION  OF THE
                          778 | ;   DISK SIZE, DIRECTORY TRACK ETC. ARE MOVED TO
                          779 | ;   A PARAMETER BLOCK AT THE END OF BDOS.


Assembly Listing                                                                                                Page: 15
------------------------------------------------------------------------------------------------------------------------

                          780 | ;
                          781 | ;   NOTE:
                          782 | ;       1.  If the program involves much action
                          783 | ;       between disk drives, considerable time
                          784 | ;       can be wasted in this swapping process.
                          785 | ;       This may be an area where improvemnts
                          786 | ;       can be made.
                          787 | ;
                          788 | ;       2.  If the disk is not a single sided,
                          789 | ;       double density 5 1/4" or a single density
                          790 | ;       8", and can thus hold more than 255K, then
                          791 | ;       the block numbers must be double precision
                          792 | ;       and will occupy 2 bytes. Consequently a
                          793 | ;       single directory extent can only hold 8
                          794 | ;       block numbers, and therefore 8K if 1K
                          795 | ;       blocks are used. In order to get enough
                          796 | ;       directory space either the number of
                          797 | ;       directory entries must be increased, or
                          798 | ;       the block size increased to 2K. For
                          799 | ;       more details on this read the Digital
                          800 | ;       Research documentation (and you will
                          801 | ;       get thoroughly confused).
                          802 | ;
EF59: 3A 42 EF            803 | SETDSK: LDA CURDSK  ;GET THE NUMBER OF THE DISK
EF5C: 4F                  804 |     MOV C,A ;
EF5D: CD 1B FA            805 |     CALL    SELDSK  ;BIOS CALL/SELECT DISK DRIVE
EF60: 7C                  806 |     MOV A,H ;IF SELDSK RETURNS (HL)= 0000H
EF61: B5                  807 |     ORA L   ;YOU ARE TRYING TO ACCESS A
EF62: C8                  808 |     RZ      ;NONEXISTENT DRIVE. ERROR RETURN.
                          809 | ;
                          810 | ;   LEGAL DRIVE- LET'S SET THINGS UP
                          811 | ;
                          812 | ;   SELDSK RETURNS WITH POINTER TO START OF DISK
                          813 | ;   PARAMETER BLOCK IN (HL). THE BLOCK CONTAINS
                          814 | ;   8 DATA WORDS:
                          815 | ;           DW  TRANS   ;START OF SECTOR TRANS  TABLE
                          816 | ;           DW  DWORD1  ;
                          817 | ;           DW  DWORD2  ;
                          818 | ;           DW  DWORD3  ;
                          819 | ;           DW  DIRBUF  ;DIRECTORY BUFFER LOCATION
                          820 | ;           DW  DPBLK   ;DISK PARAMETER BLOCK LOCATION
                          821 | ;           DW  CHKxx   ;CHECK VECTOR, DRIVE xx
                          822 | ;           DW  ALLxx   ;ALLOCATION BLOCK VECTOR, DRIVE xx
                          823 | ;
EF63: 5E                  824 |     MOV E,M ;
EF64: 23                  825 |     INX H   ;
EF65: 56                  826 |     MOV D,M ;(DE) <-- ((TRANS))
EF66: 23                  827 |     INX H   ;
EF67: 22 B3 F9            828 |     SHLD    DWORD1  ;
EF6A: 23                  829 |     INX H   ;
EF6B: 23                  830 |     INX H   ;
EF6C: 22 B5 F9            831 |     SHLD    DWORD2  ;
EF6F: 23                  832 |     INX H   ;
EF70: 23                  833 |     INX H   ;
EF71: 22 B7 F9            834 |     SHLD    DWORD3  ;
EF74: 23                  835 |     INX H   ;


Assembly Listing                                                                                                Page: 16
------------------------------------------------------------------------------------------------------------------------

EF75: 23                  836 |     INX H   ;
EF76: EB                  837 |     XCHG        ;
EF77: 22 D0 F9            838 |     SHLD    SECTBL  ;
                          839 | ;   
                          840 | ;   (DE) NOW POINTS TO DIRBUF IN PARAMETER TABLE.
                          841 | ;   THE FOLLOWING ARE NOW MOVED INTO BDOS PARAMETER AREA:
                          842 | ;
                          843 | ;   (DIRBUF)    POINTER TO DIRECTORY BUFFER
                          844 | ;   (DPBLK)     POINTER TO DISK PARAMETER BLOCK
                          845 | ;   (CHKxx)     POINTER TO DIRECTORY CHECKSUM BLOCK
                          846 | ;   (ALLxx)     POINTER TO ALLOCATION BLOCK MAP
                          847 | ;
EF7A: 21 B9 F9            848 |     LXI H,DIRBPT    ;DIRECTORY BUFFER POINTER
EF7D: 0E 08               849 |     MVI C,08H   ;
EF7F: CD 4F EF            850 |     CALL    BLKMOV  ;
                          851 | ;
                          852 | ;   THE DISK PARAMETER BLOCK IS NOW MOVED INTO
                          853 | ;   BDOS'S PARAMETER AREA. THIS BLOCK IS 15
                          854 | ;   BYTES LONG AND CONTAINS THE FOLLOWING:
                          855 | ;   (VALUES GIVEN ARE FOR 8" SINGLE DENSITY)
                          856 | ;
                          857 | ;       DW  26  ;SECTORS PER TRACK
                          858 | ;       DB  3   ;BLOCK SHIFT FACTOR
                          859 | ;       DB  7   ;BLOCK MASK
                          860 | ;       DB  0   ;NULL MASK
                          861 | ;       DW  242 ;DISK SIZE -1
                          862 | ;       DW  63  ;DIRECTORY ENTRIES -1
                          863 | ;       DB  192 ;ALLOC 0
                          864 | ;       DB  0   ;ALLOC 1
                          865 | ;       DB  2   ;DIRECTORY TRACK OFFSET
                          866 | ;
EF82: 2A BB F9            867 |     LHLD    DPBLK   ;
EF85: EB                  868 |     XCHG        ;
EF86: 21 C1 F9            869 |     LXI H,SECTRS ;SECTORS PER TRACK=
                          870 |             ;HEAD OF DP BLOCK
EF89: 0E 0F               871 |     MVI C,0FH   ;
EF8B: CD 4F EF            872 |     CALL    BLKMOV  ;
                          873 | ;
                          874 | ;   DETERMINE IF WE ARE ON A 5 1/4" OR SINGLE DENSITY
                          875 | ;   8" DISK WHICH HAS A CAPACITY OF LESS THAN 256 K
                          876 | ;   OR IF WE ARE ON A BIG DISK THAT REQUIRES A DOUBLE
                          877 | ;   PRECISION BLOCK NUMBER.
                          878 | ;
EF8E: 2A C6 F9            879 |     LHLD    DSKSIZ  ;DISK SIZE, # OF 1K BLOCKS -1
EF91: 7C                  880 |     MOV A,H ;
EF92: 21 DD F9            881 |     LXI H,BIGDSK    ;8" SD: 0FFH, LARGE CAP DISK: 00H
EF95: 36 FF               882 |     MVI M,0FFH  ;
EF97: B7                  883 |     ORA A   ;
EF98: CA 9D EF            884 |     JZ  SETDS1  ;
EF9B: 36 00               885 |     MVI M,00H   ;
EF9D: 3E FF               886 | SETDS1: MVI A,0FFH  ;
EF9F: B7                  887 |     ORA A   ;SET ZFLAG TO MARK NON-ERROR RETURN
EFA0: C9                  888 |     RET     ;
