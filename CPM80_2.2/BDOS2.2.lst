                         2851 | ;
                         2852 | ;   SET UP THE DISK PARAMETERS
                         2853 | ;
                         2854 | ;   ALL BDOS COMMANDS THAT USE THE DISKS MUST
                         2855 | ;   MAKE A PASS THROUGH THIS SUBROUTINE
                         2856 | ;
                         2857 | ;   NOTE:
                         2858 | ;       THE DIGITAL RESEARCH DOCUMENTATION DOES
                         2859 | ;       NOT MENTION WHAT IS DONE WITH THE USER
                         2860 | ;       NUMBER. WELL HERE IT IS.....
                         2861 | ;       THE USER NUMBER IS PUT INTO THE FIRST
                         2862 | ;       BYTE OF THE DIRECTORY ENTRY. USER 0
                         2863 | ;       IS THEREFORE COMPATIBLE WITH CP/M 1.4
                         2864 | ;       BUT HIGHER USER NUMBERS ARE NOT.
                         2865 | ;       TRY CREATING A DUMMY FILE WITH VARIOUS
                         2866 | ;       USER NUMBERS, THEN INSPECTING THE
                         2867 | ;       DIRECTORY TRACK WITH SPAT.
                         2868 | ;       THIS PIECE OF CODE PUTS THE CURRENT
                         2869 | ;       USER NUMBER INTO THE START OF THE
                         2870 | ;       FILE CONTROL BLOCK SO THAT A MATCH CAN
                         2871 | ;       BE MADE DURING DIRECTORY SEARCHES.
                         2872 | ;
F851: 3E FF              2873 | SETUP:  MVI A,0FFH  ;SET FLAG TO TELL BDOS2 THAT
F853: 32 DE F9           2874 |     STA SETUPF  ;  THE DISKS HAVE BEEN USED
F856: 2A 43 EF           2875 |     LHLD    ENTPAR  ;(HL) <-- ENTRY PARAMETER
F859: 7E                 2876 |     MOV A,M ;GET THE DISK NUMBER FROM FCB
F85A: E6 1F              2877 |     ANI 1FH ;DISK NUMBER TO BE IN RANGE OF
                         2878 |             ;0 TO 1FH. I.E. DRIVES A THROUGH P
F85C: 3D                 2879 |     DCR A   ;
F85D: 32 D6 F9           2880 |     STA PARAM1  ;STORE IT FOR SELDSK
F860: FE 1E              2881 |     CPI 1EH ;
F862: D2 75 F8           2882 |     JNC SETUP1  ;SKIP OVER- ACCESSING LOGGED IN DISK
                         2883 | ;
F865: 3A 42 EF           2884 |     LDA CURDSK  ;SAVE CURRENT DISK NUMBER IN
F868: 32 DF F9           2885 |     STA LOGDSK  ;LOGDSK FOR RESTORING ON EXIT
F86B: 7E                 2886 |     MOV A,M ;GET DISK NUMBER FROM FCB AGAIN
F86C: 32 E0 F9           2887 |     STA DISKNO  ;SAVE IT
                         2888 | ;
                         2889 | ;   THE REASON FOR SETTING THE UPPER 3 BITS OF
                         2890 | ;   (FCB+12) WITH THE UPPER 3 BITS OF THE DRIVE
