                         1243 | ;
                         1244 | ;   SET CURRENT DISK'S READ ONLY STATUS OR LOGGED IN STATUS
                         1245 | ;
                         1246 | ;   ENTRY PARAMETER:    (LOGVEC) or (ROWORD) IN (BC)
                         1247 | ;               CURRENT DISK NUMBER = (CURDSK)
                         1248 | ;   EXIT PARAMETER:     UPDATED VERSION OF (BC) IN (HL).
                         1249 | ;
                         1250 | ;   NOTE:
                         1251 | ;       (LOGVEC) AND (ROWORD) ARE 16 BIT WORDS
                         1252 | ;       EACH BIT REPRESENTS THE LOG IN AND READ ONLY
                         1253 | ;       STATUS OF THE DRIVE REPRESENTED BY THE BIT.
                         1254 | ;       LSB CORRESPONDS TO DRIVE 'A'.
                         1255 | ;       MSB CORRESPONDS TO DRIVE 'P'.
                         1256 | ;
F116: C5                 1257 | SETVEC: PUSH    B   ;SAVE ENTRY PARAMETER
