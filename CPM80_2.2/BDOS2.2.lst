                         1249 | ;               CURRENT DISK NUMBER = (CURDSK)
                         1250 | ;   EXIT PARAMETER:     UPDATED VERSION OF (BC) IN (HL).
                         1251 | ;
                         1252 | ;   NOTE:
                         1253 | ;       (LOGVEC) AND (ROWORD) ARE 16 BIT WORDS
                         1254 | ;       EACH BIT REPRESENTS THE LOG IN AND READ ONLY
                         1255 | ;       STATUS OF THE DRIVE REPRESENTED BY THE BIT.
                         1256 | ;       LSB CORRESPONDS TO DRIVE 'A'.
                         1257 | ;       MSB CORRESPONDS TO DRIVE 'P'.
                         1258 | ;
F10B: C5                 1259 | SETVEC: PUSH    B   ;SAVE ENTRY PARAMETER
