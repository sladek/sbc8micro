ECA1: CA 00 00            214 |     JZ  REBOOT  ;
ECA4: C9                  215 |     RET     ;
                          216 | ;
                          217 | ;   NOTE:
                          218 | ;       There should be some change made to this
                          219 | ;       piece of code because when you have tried
                          220 | ;       to select a non-existent drive, you will
                          221 | ;       reboot and immediately try to select that
                          222 | ;       drive. This gives an error message and a
                          223 | ;       reboot which reselects the drive........
                          224 | ;
ECA5: 21 D5 EC            225 | SELER1: LXI H,ERMSG3    ;<DISK SELECT ERROR>
ECA8: C3 B4 EC            226 |     JMP ROERR2  ;
                          227 | ;
ECAB: 21 00 00            228 | ROERR:  LXI H,ERMSG5    ;<DISK READ ONLY ERROR>
ECAE: C3 B4 EC            229 |     JMP ROERR2  ;
                          230 | ;
ECB1: 21 DC EC            231 | ROERR1: LXI H,ERMSG4    ;<FILE READ ONLY ERROR>
ECB4: CD E5 EC            232 | ROERR2: CALL    ERRMSG  ;
ECB7: C3 00 00            233 |     JMP REBOOT  ;
                          234 | ;
                          235 | ;   ERROR MESSAGE STRINGS
                          236 | ;
ECBA: 42 64 6F 73 20...   237 | ERMSG0: DB  'Bdos Err On  : $'
                          238 | ERMSG1: EQU ERMSG0+12   ;
                          239 | ;
ECCA: 42 61 64 20 53...   240 | ERMSG2: DB  'Bad Sector$'   ;
                          241 | ;
ECD5: 53 65 6C 65 63...   242 | ERMSG3: DB  'Select$'   ;
                          243 | ;
ECDC: 46 69 6C 65 20...   244 | ERMSG4: DB  'File R/O$' ;
                          245 | ERMSG5: EQU ERMSG4+5    ;
                          246 | ;
                          247 | ;   PRINT OUT THE ERROR MESSAGE
                          248 | ;
ECE5: E5                  249 | ERRMSG: PUSH    H   ;SAVE THE POINTER
ECE6: CD C9 ED            250 |     CALL    PCRLF   ;START A NEW LINE
ECE9: 3A 42 EF            251 |     LDA CURDSK  ;GET THE CURRENT DISK NUMBER
ECEC: C6 41               252 |     ADI 'A' ;ADD THE ASCII BIAS+1
ECEE: 32 C6 EC            253 |     STA ERMSG1  ;POKE INTO ERROR MESSAGE
ECF1: 01 BA EC            254 |     LXI B,ERMSG0    ;POINT TO ERROR MESSAGE
ECF4: CD D3 ED            255 |     CALL    PRNSTR  ;PRINT ERROR MESSAGE STRING
ECF7: C1                  256 |     POP B   ;GET BACK ORIGINAL POINTER
ECF8: CD D3 ED            257 |     CALL    PRNSTR  ;  AND PRINT THAT STRING TOO.
                          258 | ;
                          259 | ;   CONSOLE KEYBOARD INPUT
                          260 | ;
ECFB: 21 0E EF            261 | INPUT:  LXI H,KYBDFL    ;SWAP THE CONTENTS OF THE KEYBOARD FLAG BYTE
ECFE: 7E                  262 |     MOV A,M ;WITH A 00
ECFF: 36 00               263 |     MVI M,00H   ;
ED01: B7                  264 |     ORA A   ;
ED02: C0                  265 |     RNZ     ;RETURN IF SOMETHING ALREADY THERE
ED03: C3 09 FA            266 |     JMP CONIN   ;ELSE GET SOMETHING VIA A BIOS CALL  TO CONSOLE INPUT
                          267 | ;
ED06: CD FB EC            268 | INCHR:  CALL    INPUT   ;GET A CHARACTER FROM KEYBOARD
ED09: CD 14 ED            269 |     CALL    SETFLG  ;CHECK TO SEE IF IS A COTROL CHARACTER


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

ED0C: D8                  270 |     RC      ;RETURN IF IT IS
ED0D: F5                  271 |     PUSH    PSW ;ELSE ECHO IT TO THE CONSOLE
ED0E: 4F                  272 |     MOV C,A ; (AND PERHAPS THE LIST DEVICE)
ED0F: CD 90 ED            273 |     CALL    COM02   ;CONSOLE OUTPUT
ED12: F1                  274 |     POP PSW ;
ED13: C9                  275 |     RET     ;
                          276 | ;
                          277 | ;   SET THE CARRY FLAG IF A CONTROL CHARACTER OTHER THAN
                          278 | ;   CR, LF, TAB OR BACKSPACE IS ENCOUNTERED
                          279 | ;
ED14: FE 0D               280 | SETFLG: CPI CR  ;
ED16: C8                  281 |     RZ      ;
ED17: FE 0A               282 |     CPI LF  ;
ED19: C8                  283 |     RZ      ;
ED1A: FE 09               284 |     CPI TAB ;
ED1C: C8                  285 |     RZ      ;
ED1D: FE 08               286 |     CPI BCKSPA  ;
ED1F: C8                  287 |     RZ      ;
ED20: FE 20               288 |     CPI ' ' ;
ED22: C9                  289 |     RET     ;
                          290 | ;
                          291 | ;   CHECK TO KEYBOARD STATUS TO SEE IF THERE IS
                          292 | ;   SOMETHING TO REPORT
                          293 | ;
ED23: 3A 0E EF            294 | KBSTAT: LDA KYBDFL  ;CHECK THE FLAG
ED26: B7                  295 |     ORA A   ;
ED27: C2 45 ED            296 |     JNZ KBSTA2  ;SOMETHING ALREADY ON HAND
                          297 | ;
ED2A: CD 06 FA            298 |     CALL    CONST   ;BIOS CALL/CONSOLE STATUS
ED2D: E6 01               299 |     ANI 01H ;CHECK LSB ONLY
ED2F: C8                  300 |     RZ      ;NOTHING, SO JUST RETURN
                          301 | ;
ED30: CD 09 FA            302 |     CALL    CONIN   ;BIOS CALL/CONSOLE INPUT
ED33: FE 13               303 |     CPI 13H ;CHECK FOR A CONTROL S
ED35: C2 42 ED            304 |     JNZ KBSTA1  ;EXIT ON CONTROL S
ED38: CD 09 FA            305 |     CALL    CONIN   ;BIOS CALL/CONSOLE INPUT
ED3B: FE 03               306 |     CPI 03H ;CHECK AGAIN FOR A CONTROL C
ED3D: CA 00 00            307 |     JZ  REBOOT  ;REBOOT IF THE IS ^C
ED40: AF                  308 |     XRA A   ; ELSE CLEAR THE EVIDENCE
ED41: C9                  309 |     RET     ;  AND EXIT
                          310 | ;
ED42: 32 0E EF            311 | KBSTA1: STA KYBDFL  ;MARK THE FLAG 'IN USE'
ED45: 3E 01               312 | KBSTA2: MVI A,01H   ; SET RETURN BYTE
ED47: C9                  313 |     RET     ;
                          314 | ;
                          315 | ;   OUTPUT ONE CHARACTER TO THE CONSOLE OUTPUT DEVICE
                          316 | ;   (AND TO THE LIST DEVICE IF THE ^P FLAG IS SET)
                          317 | ;
                          318 | ;   CHARACTER TO BE OUTPUT IS RECEIVED IN (C)
                          319 | ;
ED48: 3A 0A EF            320 | OUTPUT: LDA CHCTR1  ;
ED4B: B7                  321 |     ORA A   ;
ED4C: C2 62 ED            322 |     JNZ OUTPT1  ;
ED4F: C5                  323 |     PUSH    B   ;
ED50: CD 23 ED            324 |     CALL    KBSTAT  ;
ED53: C1                  325 |     POP B   ;


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

ED54: C5                  326 |     PUSH    B   ;
ED55: CD 0C FA            327 |     CALL    CONOUT  ;BIOS CALL/CONSOLE OUTPUT
ED58: C1                  328 |     POP B   ;
ED59: C5                  329 |     PUSH    B   ;
ED5A: 3A 0D EF            330 |     LDA LISTFL  ;CHECK TO SEE IF LIST DEVICE IS SET
ED5D: B7                  331 |     ORA A   ;
ED5E: C4 0F FA            332 |     CNZ LIST    ; IT IS SO DO A BIOS CALL TO LIST DEVICE OUTPUT
ED61: C1                  333 |     POP B   ;
ED62: 79                  334 | OUTPT1: MOV A,C ;
ED63: 21 0C EF            335 |     LXI H,CHRCTR    ;
ED66: FE 7F               336 |     CPI RUBOUT  ;DON'T COUNT RUBOUTS
ED68: C8                  337 |     RZ      ;
ED69: 34                  338 |     INR M   ;BUMP CHARACTER COUNTER
ED6A: FE 20               339 |     CPI ' ' ;
ED6C: D0                  340 |     RNC     ;OK- IT WAS A PRINTABLE CHARACTER
ED6D: 35                  341 |     DCR M   ;UNDO WHAT YOU JUST DID
ED6E: 7E                  342 |     MOV A,M ;** SUPERFLOUS CODE!
ED6F: B7                  343 |     ORA A   ;** SET FLAG LIKE IT WAS SET BY DCR M
ED70: C8                  344 |     RZ      ;
ED71: 79                  345 |     MOV A,C ;
ED72: FE 08               346 |     CPI BCKSPA  ;CHECK FOR A BACKSPACE
ED74: C2 79 ED            347 |     JNZ OUTPT2  ;
ED77: 35                  348 |     DCR M   ;DECREASE COUNTER IF BACKSPACE
ED78: C9                  349 |     RET     ;
                          350 | ;
ED79: FE 0A               351 | OUTPT2: CPI LF  ;ZERO OUT CHARACTER COUNTER IF
ED7B: C0                  352 |     RNZ     ;A LINE FEED IS FOUND, ELSE JUST
ED7C: 36 00               353 |     MVI M,00H   ;RETURN TO CALLER
ED7E: C9                  354 |     RET     ;
                          355 | ;
                          356 | ;   CHARACTER OUTPUT
                          357 | ;
                          358 | ;   CHARACTER TO BE PRINTED RECEIVED IN (C)
                          359 | ;
                          360 | ;   PRINTS CONTROL CHARACTERS AS ^[LETTER]
                          361 | ;   EXPANDS TABS TO 8 BYTE BOUNDARIES
                          362 | ;
ED7F: 79                  363 | OUTCHR: MOV A,C ;
ED80: CD 14 ED            364 |     CALL    SETFLG  ;
ED83: D2 90 ED            365 |     JNC COM02   ; NOT A CONTROL CHAR SO JUST DO CONSOLE OUTPUT
ED86: F5                  366 |     PUSH    PSW ;STASH THE CHARACTER
ED87: 0E 5E               367 |     MVI C,'^'   ;PRINT AN UP-ARROW
ED89: CD 48 ED            368 |     CALL    OUTPUT  ;
ED8C: F1                  369 |     POP PSW ;GET CHARACTER BACK
ED8D: F6 40               370 |     ORI 40H ;REPLACE ASCII BIAS
ED8F: 4F                  371 |     MOV C,A ;
ED90: 79                  372 | COM02:  MOV A,C ;CONSOLE OUTPUT
ED91: FE 09               373 |     CPI TAB ;
ED93: C2 48 ED            374 |     JNZ OUTPUT  ;NOT A TAB, JUST OUTPUT
ED96: 0E 20               375 | OUTCH2: MVI C,' '   ; IT WAS A TAB, SPACE TO NEXT 8 BYTE STOP.
ED98: CD 48 ED            376 |     CALL    OUTPUT  ;
ED9B: 3A 0C EF            377 |     LDA CHRCTR  ;CHECK THE COUNTER
ED9E: E6 07               378 |     ANI 07H ;
EDA0: C2 96 ED            379 |     JNZ OUTCH2  ;NOT AT EVEN LOCATION, DO ANOTHER
EDA3: C9                  380 |     RET     ;
                          381 | ;


