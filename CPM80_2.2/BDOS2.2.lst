                         2707 | ;           (A) OVERFLOW
                         2708 | ;
                         2709 | ;   (A) (B) (C) <-- (BYTE14).AND.0FH*2^12+(BYTE12).AND.1FH*2^7+(BYTE32)or(BYTE15)
                         2710 | ;
