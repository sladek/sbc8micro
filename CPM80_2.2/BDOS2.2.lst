                          679 | ;
                          680 | ;   BDOS COMMAND #11....GET CONSOLE INPUT STATUS
                          681 | ;       RETURNS 00 IF NO KEY PRESSED, ELSE 01
                          682 | ;
                          683 | ;   NOTE:
                          684 | ;       This command is not quite compatible with
                          685 | ;       CP/M 1.4 or 2.0 because if a ' ' is pressed
                          686 | ;       the console then waits for another input,
                          687 | ;       and reboots if that input is ^C. If the
                          688 | ;       second input is not ^C, then Command 11
                          689 | ;       returns like nothing happened, but has
                          690 | ;       swallowed the ' '. This does strange things
                          691 | ;       with some older CPMUG programs like Tiny
                          692 | ;       Basic with polled Command 11 until a key
                          693 | ;       was pressed. If you try some of these
                          694 | ;       programs which ran fine under 1.4, but
                          695 | ;       do strange things under 2.2, this may be
                          696 | ;       the place to look.
                          697 | ;
EEFE: CD 23 ED            698 | COM11:  CALL    KBSTAT  ;GET CONSOLE STATUS
EF01: 32 45 EF            699 | EXIT1:  STA RETPAR  ; STORE THE RETURN PARAMETER
EF04: C9                  700 | DUMMY:  RET     ;(USED AS EXIT POINT FOR COM38 AND
                          701 |             ;COM39)
