------------------------------------------------------------------------------------------------------------------------

EC04: 00 00               102 |     DB  SNL/256,SNL MOD 256 ;
                          103 | ;
                          104 | ;   NOTE:
                          105 | ;       The user must insert the proper serial numbers
                          106 | ;       into BDOS since these numbers are checked by
                          107 | ;       MOVECPM when creating a new system, and by
                          108 | ;       CCP every time a transient program is loaded.
                          109 | ;       Failure to have matching serial numbers will
                          110 | ;       cause an error condition.
                          111 | ;
                          112 | ;   MAIN BDOS ENTRY POINT.
                          113 | ;   ALL CALL ARE ROUTED THROUGH HERE BY
                          114 | ;   VECTOR LOCATED AT 0005H
                          115 | ;
                          116 |     ORG BDOS    ;THIS IS WHERE BDOS FUNCTIONS ARE CALLED
EC06: C3 11 EC            117 |     JMP BDOS1   ;JUMP OVER ERROR VECTORS TO START
                          118 | ;
                          119 | ;   ERROR HANDLER VECTORS
                          120 | ;
EC09: 99 EC               121 | ERR1:   DW  BSERR   ;<BAD   SECTOR   ERROR>
EC0B: A5 EC               122 | ERR2:   DW  SELER1  ;<DISK  SELECT   ERROR>
EC0D: AB EC               123 | ERR3:   DW  ROERR   ;<DISK READ ONLY ERROR>
EC0F: B1 EC               124 | ERR4:   DW  ROERR1  ;<FILE READ ONLY ERROR>
                          125 | ;
                          126 | ;   STARTING POINT OF BASIC DISK OPERATING SYSTEM
                          127 | ;
EC11: EB                  128 | BDOS1:  XCHG        ;
EC12: 22 43 EF            129 |     SHLD    ENTPAR  ;SAVE ENTRY PARAMETER FROM (DE)
EC15: EB                  130 |     XCHG        ;
EC16: 7B                  131 |     MOV A,E ;
EC17: 32 E1 F9            132 |     STA PARAM1  ;ALSO SAVE CONTENTS OF (E)
EC1A: 21 00 00            133 |     LXI H,0000  ;
EC1D: 22 45 EF            134 |     SHLD    RETPAR  ;ZERO OUT RETURN PARAMETER
EC20: 39                  135 |     DAD SP  ;
EC21: 22 0F EF            136 |     SHLD    PSTACK  ;SAVE CALLING PROGRAM STACK POINTER
EC24: 31 41 EF            137 |     LXI SP,BSTACK   ;SET UP BDOS STACK
EC27: AF                  138 |     XRA A   ;
EC28: 32 EB F9            139 |     STA DISKNO  ;ZERO OUT DISK NUMBER
EC2B: 32 E9 F9            140 |     STA SETUPF  ; & DISK SETUP FLAG
EC2E: 21 7F F9            141 |     LXI H,BDOS2 ;PUT EXIT POINT ADDRESS UP FOR
EC31: E5                  142 |     PUSH    H   ; USE WHEN COMMAND IS COMPLETED
EC32: 79                  143 |     MOV A,C ;MOVE COMMAND NUMBER INTO (A)
EC33: FE 29               144 |     CPI 29H ;CHECK FOR VALID COMMAND NUMBER
EC35: D0                  145 |     RNC     ;NO GOOD- THERE ARE ONLY 40 COMMANDS
EC36: 4B                  146 |     MOV C,E ;
EC37: 21 47 EC            147 |     LXI H,COMTAB ;POINT TO START OF COMMAND TABLE
EC3A: 5F                  148 |     MOV E,A ;
EC3B: 16 00               149 |     MVI D,00H   ;
EC3D: 19                  150 |     DAD D   ;
EC3E: 19                  151 |     DAD D   ;POINT TO COMMAND VECTOR
EC3F: 5E                  152 |     MOV E,M ;
EC40: 23                  153 |     INX H   ;
EC41: 56                  154 |     MOV D,M ;MOVE COMMAND VECTOR INTO (DE)
EC42: 2A 43 EF            155 |     LHLD    ENTPAR  ;GET BACK ORIGINAL ENTRY CONTENTS OF (DE)
EC45: EB                  156 |     XCHG        ;SWAP 'EM
EC46: E9                  157 |     PCHL        ;THEN GO OFF TO DO THE COMMAND


