F82A: 77                 2814 |     MOV M,A ;(FCB35) <-- OVERFLOW BYTE
F82B: C9                 2815 |     RET     ;
                         2816 | ;
                         2817 | ;   HERE WE HAVE THE WAY THAT DISKS ARE LOGGED,
                         2818 | ;   AND A MISERABLE AND TANGLED BIT OF CODE IT IS.
                         2819 | ;   WE START HERE,  THEN JUMP TO LOGIN1 WHICH THEN
                         2820 | ;   FINISHES UP THE REST OF THE JOB.
                         2821 | ;   WHY THE HECK ISN'T THIS THING WRITTEN IN A
                         2822 | ;   STRAIGHT LINE? ANYBODY FOR STRUCTURED CODE??
                         2823 | ;
F82C: 2A BA F9           2824 | LOGIN:  LHLD    LOGVEC  ;LOG IN VECTOR
F82F: 3A 42 EF           2825 |     LDA CURDSK  ;
F832: 4F                 2826 |     MOV C,A ;
F833: CD F5 F0           2827 |     CALL    SHRHLC  ;SHIFT (HL) RIGHT PER COUNT IN (C)
F836: E5                 2828 |     PUSH    H   ;
F837: EB                 2829 |     XCHG        ;
F838: CD 59 EF           2830 |     CALL    SETDSK  ;SET UP DISK PARAMETERS
F83B: E1                 2831 |     POP H   ;
F83C: CC 47 EF           2832 |     CZ  SELERR  ;DISK SELECT ERROR
F83F: 7D                 2833 |     MOV A,L ;LOG IN BIT IN LSB(A)
F840: 1F                 2834 |     RAR     ;CHECK TO SEE IF ON MAP
F841: D8                 2835 |     RC      ;OK- DISK ALREADY LOGGED IN
F842: 2A BA F9           2836 |     LHLD    LOGVEC  ;LOG IN VECTOR
F845: 4D                 2837 |     MOV C,L ;
F846: 44                 2838 |     MOV B,H ;
F847: CD 16 F1           2839 |     CALL    SETVEC  ;NEW DISK- PUT ON THE MAP
F84A: 22 BA F9           2840 |     SHLD    LOGVEC  ;LOG IN VECTOR
F84D: C3 AE F2           2841 |     JMP LOGIN1  ;--SEE COMMENTS AT START--
                         2842 | ;
                         2843 | ;   BDOS COMMAND #14....SELECT DISK DRIVE
                         2844 | ;
                         2845 | ;   NOW IF THIS BLOCK OF CODE WERE TO BE MOVED


Assembly Listing                                                                                                Page: 52
