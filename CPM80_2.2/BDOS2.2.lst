                         2016 | ;   SUBROUTINE CALLED BY MAKEF
                         2017 | ;
                         2018 | ;   MOVES 32 BYTES FROM FILE CONTROL BLOCK TO
                         2019 | ;   DIRECTORY ENTRY THEN WRITES DIRECTORY SECTOR
                         2020 | ;   TO DISK.
                         2021 | ;
                         2022 | ;   ALSO CALLED THROUGH SECONDARY ENTRY POINT:
                         2023 | ;
                         2024 | ;   (C)= 16, (E)= 12    WHEN CALLED BY RENAME   
                         2025 | ;   (C)= 00, (E)= 12    WHEN CALLED BY ATTRIB
                         2026 | ;
