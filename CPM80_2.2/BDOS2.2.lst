EF47: 21 0B EC            744 | SELERR: LXI H,ERR2  ;DISK SELECT ERROR
                          745 | ;
EF4A: 5E                  746 | ERROR:  MOV E,M ;Move (Vector) to (DE)
EF4B: 23                  747 |     INX H   ;
EF4C: 56                  748 |     MOV D,M ;
