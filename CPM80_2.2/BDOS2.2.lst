                          762 | ;       HL and DE register pairs & using (BC)
                          763 | ;       of just (C) as the counter.
                          764 | ;
EF4F: 0C                  765 | BLKMOV: INR C   ;
EF50: 0D                  766 | BLMOV1: DCR C   ;
