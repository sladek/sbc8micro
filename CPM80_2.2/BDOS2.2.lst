                         2022 | ;
                         2023 | ;   SUBROUTINE CALLED BY MAKEF
                         2024 | ;
                         2025 | ;   MOVES 32 BYTES FROM FILE CONTROL BLOCK TO
                         2026 | ;   DIRECTORY ENTRY THEN WRITES DIRECTORY SECTOR
                         2027 | ;   TO DISK.
                         2028 | ;
                         2029 | ;   ALSO CALLED THROUGH SECONDARY ENTRY POINT:
                         2030 | ;
                         2031 | ;   (C)= 16, (E)= 12    WHEN CALLED BY RENAME   
                         2032 | ;   (C)= 00, (E)= 12    WHEN CALLED BY ATTRIB
                         2033 | ;
F3FD: 0E 00              2034 | MAKESR: MVI C,00H   ;
F3FF: 1E 20              2035 |     MVI E,32    ;DIRECTORY ENTRY IS 32 BYTES
                         2036 | ;
                         2037 | ;   SECONDARY ENTRY POINT
                         2038 | ;   (C)= OFFSET, (E)= BYTE COUNTER
                         2039 | ;
F401: D5                 2040 | MAKES1: PUSH    D   ;SAVE COUNTER
F402: 06 00              2041 |     MVI B,00H   ;
F404: 2A 43 EF           2042 |     LHLD    ENTPAR  ;ENTRY PARAMETER
F407: 09                 2043 |     DAD B   ;  ADD OFFSET
F408: EB                 2044 |     XCHG        ;     MOVE TO (DE)
F409: CD 5E F1           2045 |     CALL    DIRPTR  ;(HL) <-- (DIRBPT) + (DIROFF)
F40C: C1                 2046 |     POP B   ;
F40D: CD 4F EF           2047 |     CALL    BLKMOV  ;MOVE FILENAME.EXT INTO DIR BUFFER
F410: CD C3 EF           2048 | MAKES2: CALL    TRKSEC  ;SET TRACK AND SECTOR
F413: C3 C6 F1           2049 |     JMP DIRWRT  ;WRITE DIRECTORY BUFFER TO DISK
                         2050 | ;
                         2051 | ;   RENAME FILE
                         2052 | ;
                         2053 | ;   ON ENTRY THE CONTENTS OF (DE) POINTS TO A 32
                         2054 | ;   BYTE BLOCK WHERE THE FIRST 16 BYTES ARE THE
                         2055 | ;   OLD FILENAME.TYP AND THE SECOND 16 ARE THE
                         2056 | ;   NEW FILENAME.EXT. THIS PIECE OF CODE MAKES A
                         2057 | ;   12 BYTE SEARCH TO MATCH THE OLD FILENAME.TYP
                         2058 | ;   WITH ENTRIES IN THE DIRECTORY. WHEN A MATCH
                         2059 | ;   IS MADE THE NEW FILENAME.TYP IS INSERTED INTO
                         2060 | ;   THE DIRECTORY SECTOR AND THE SECTOR WRITTTEN
