                         1242 | ;               CURRENT DISK NUMBER = (CURDSK)
                         1243 | ;   EXIT PARAMETER:     UPDATED VERSION OF (BC) IN (HL).
                         1244 | ;
                         1245 | ;   NOTE:
                         1246 | ;       (LOGVEC) AND (ROWORD) ARE 16 BIT WORDS
                         1247 | ;       EACH BIT REPRESENTS THE LOG IN AND READ ONLY
                         1248 | ;       STATUS OF THE DRIVE REPRESENTED BY THE BIT.
                         1249 | ;       LSB CORRESPONDS TO DRIVE 'A'.
                         1250 | ;       MSB CORRESPONDS TO DRIVE 'P'.
                         1251 | ;
F10B: C5                 1252 | SETVEC: PUSH    B   ;SAVE ENTRY PARAMETER
F10C: 3A 42 EF           1253 |     LDA CURDSK  ;
F10F: 4F                 1254 |     MOV C,A ;PUT DISK NUMBER AS COUNTER IN (C)
F110: 21 01 00           1255 |     LXI H,0001  ;SET-BIT IN (HL)
F113: CD 04 F1           1256 |     CALL    SHLHLC  ;SHIFT (HL) LEFT PER COUNT IN (C)
F116: C1                 1257 |     POP B   ;RESTORE PARAMETER
F117: 79                 1258 |     MOV A,C ;COMBINE SHIFTED SET-BIT WITH
F118: B5                 1259 |     ORA L   ;  PREVIOUS CONTENTS OF
F119: 6F                 1260 |     MOV L,A ;   (BC) INTO (HL)
F11A: 78                 1261 |     MOV A,B ;
F11B: B4                 1262 |     ORA H   ;
F11C: 67                 1263 |     MOV H,A ;
F11D: C9                 1264 |     RET     ;RETURN W/ UPDATED VALUE IN (HL)
                         1265 | ;
                         1266 | ;   GET CURRENT READ ONLY STATUS OF DISK
                         1267 | ;
                         1268 | ;   ENTRY PARAMETERS:   NONE
