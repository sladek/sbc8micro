                         1654 | ;
                         1655 | ;   SET OR CLEAR THE BIT CORRECPONDING TO THE
                         1656 | ;   1K DISK BLOCK NUMBER IN (HL).
                         1657 | ;
                         1658 | ;   ENTRY PARAMETER:    (HL)=DISK 1K BLOCK NUMBER
                         1659 | ;               (C)= 0 WHEN CALLED BY DELETE
                         1660 | ;               (C)= 1 WHEN CALLED BY LOGIN
                         1661 | ;   PASSES ENTRY PARAMETER TO BLKMP5 IN (E)
                         1662 | ;   IF PARAMETER IS 1, THEN THE 1K BLOCK IS MARKED AS
                         1663 | ;   AS BEING IN USE.
                         1664 | ;   IF PARAMETER IS 0, THEN THE 1K BLOCK IS CLEARED AND
