                         1647 | ;
                         1648 | ;   SET OR CLEAR THE BIT CORRECPONDING TO THE
                         1649 | ;   1K DISK BLOCK NUMBER IN (HL).
                         1650 | ;
                         1651 | ;   ENTRY PARAMETER:    (HL)=DISK 1K BLOCK NUMBER
                         1652 | ;               (C)= 0 WHEN CALLED BY DELETE
                         1653 | ;               (C)= 1 WHEN CALLED BY LOGIN
                         1654 | ;   PASSES ENTRY PARAMETER TO BLKMP5 IN (E)
                         1655 | ;   IF PARAMETER IS 1, THEN THE 1K BLOCK IS MARKED AS
                         1656 | ;   AS BEING IN USE.
                         1657 | ;   IF PARAMETER IS 0, THEN THE 1K BLOCK IS CLEARED AND
