                          158 | ;
                          159 | ;   BDOS COMMAND VECTOR TABLE
                          160 | ;
                          161 | ;   Contains vectors for 40 commands, including two
                          162 | ;   reserved spaces for future commands, and two
                          163 | ;   undocumented commands. Commands marked '*' are
                          164 | ;   different from the similarly numbered commands
                          165 | ;   in CP/M 1.4
                          166 | ;
EC47: 03 FA               167 | COMTAB: DW  WBOOT   ;   BIOS CALL/WARM BOOT
EC49: C8 EE               168 |     DW  COM01   ;   CONSOLE INPUT
EC4B: 90 ED               169 |     DW  COM02   ;   CONSOLE OUTPUT
EC4D: CE EE               170 |     DW  COM03   ;   TAPE READER INPUT
EC4F: 12 FA               171 |     DW  PUNCH   ;   BIOS CALL/PUNCH DEVICE OUTPUT
EC51: 0F FA               172 |     DW  LIST    ;   BIOS CALL/LIST DEVICE OUTPUT
EC53: D4 EE               173 |     DW  COM06   ;*  DIRECT CONSOLE I/O
EC55: ED EE               174 |     DW  COM07   ;   GET I/O BYTE
EC57: F3 EE               175 |     DW  COM08   ;   SET I/O BYTE
EC59: F8 EE               176 |     DW  COM09   ;   PRINT STRING
EC5B: E1 ED               177 |     DW  COM10   ;*  READ CONSOLE BUFFER
EC5D: FE EE               178 |     DW  COM11   ;   GET CONSOLE STATUS
EC5F: 7E F8               179 |     DW  COM12   ;*  RETURN VERSION NUMBER
EC61: 83 F8               180 |     DW  COM13   ;   RESET DISK SYSTEM
EC63: 45 F8               181 |     DW  COM14   ;   SELECT DISK DRIVE
EC65: 9C F8               182 |     DW  COM15   ;*  OPEN FILE
EC67: A5 F8               183 |     DW  COM16   ;   CLOSE FILE
EC69: AB F8               184 |     DW  COM17   ;*  SEARCH FOR FIRST OCCURENCE
EC6B: C8 F8               185 |     DW  COM18   ;   SEARCH FOR NEXT OCCURENCE
EC6D: D7 F8               186 |     DW  COM19   ;*  DELETE FILE
EC6F: E0 F8               187 |     DW  COM20   ;   READ SEQUENTIAL FILE
EC71: E6 F8               188 |     DW  COM21   ;   WRITE SEQUENTIAL FILE
EC73: EC F8               189 |     DW  COM22   ;*  MAKE FILE
EC75: F5 F8               190 |     DW  COM23   ;*  RENAME FILE
EC77: FE F8               191 |     DW  COM24   ;   RETURN LOG-IN VECTOR
EC79: 04 F9               192 |     DW  COM25   ;   RETURN CURRENT DISK NUMBER
EC7B: 0A F9               193 |     DW  COM26   ;   GET DMA ADDRESS
EC7D: 11 F9               194 |     DW  COM27   ;   INTEROGATE DISK ALLOCATION
EC7F: 2C F1               195 |     DW  COM28   ;*  WRITE PROTECT DISK
EC81: 17 F9               196 |     DW  COM29   ;*  GET R/O VECTOR ADDRESS
EC83: 1D F9               197 |     DW  COM30   ;*  SET FILE ATTRIBUTES
EC85: 26 F9               198 |     DW  COM31   ;*  GET DISK PARAMETER ADDRESS
EC87: 2D F9               199 |     DW  COM32   ;*  SET USER/GET USER NUMBER
EC89: 41 F9               200 |     DW  COM33   ;*  READ RANDOM FILE
EC8B: 47 F9               201 |     DW  COM34   ;*  WRITE RANDOM FILE
EC8D: 4D F9               202 |     DW  COM35   ;*  COMPUTE FILE SIZE
EC8F: 0E F8               203 |     DW  COM36   ;*  SET RAMDOM RECORD LENGTH
EC91: 53 F9               204 |     DW  COM37   ;** UNDOCUMENTED COMMAND
EC93: 04 EF               205 |     DW  DUMMY   ;** RESERVED FOR FUTURE USE
EC95: 04 EF               206 |     DW  DUMMY   ;** RESERVED FOR FUTURE USE
EC97: 9B F9               207 |     DW  COM40   ;** UNDOCUMENTED COMMAND
                          208 | ;
                          209 | ;   BDOS ERROR HANDLING ROUTINES
                          210 | ;
EC99: 21 CA EC            211 | BSERR:  LXI H,ERMSG2    ;<BAD SECTOR ERROR>
EC9C: CD E5 EC            212 |     CALL    ERRMSG  ;
EC9F: FE 03               213 |     CPI 03H ;CHECK FOR A CONTROL C


Assembly Listing                                                                                                 Page: 5
