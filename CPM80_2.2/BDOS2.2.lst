                           38 | ;
                           39 | ;   NOTE:
                           40 | ;
                           41 | ;   This is just a preliminary cut at the disassembly
                           42 | ;   of the main portion of CP/M. The non-disk portions
                           43 | ;   are fairly well commented, but the disk portions
                           44 | ;   are still being worked on. Further work is planned
                           45 | ;   and will be released when ready.
                           46 | ;
                           47 | ;   The points still being puzzled out are:
                           48 | ;
                           49 | ;   1.  The use of the null block mask for non 8" s.d.
                           50 | ;   disk systems.
                           51 | ;
                           52 | ;   2.  The use of the upper 3 bits of FILE CONTROL
                           53 | ;   BLOCK Byte 12 (extent byte). This is tied in with
                           54 | ;   the null block mask mentioned in #1 above.
                           55 | ;
                           56 | ;   3.  The full use of the 3- 16 bit parameters in each


Assembly Listing                                                                                                 Page: 2
------------------------------------------------------------------------------------------------------------------------

                           57 | ;   disk parameter block. The vectors to these 3 items are
                           58 | ;   DWORD1, DWORD2 & DWORD3. These are set to 0000H when
                           59 | ;   BIOS is first loaded. ((DWORD1)) is set to 0003H by 
                           60 | ;   LOGIN, and ((DWORD2)) & ((DWORD3)) are set to 0000H by
                           61 | ;   SETDIR which in in turn is called by LOGIN and SERCHF.
                           62 | ;   No explanation for these parameters is given in the
                           63 | ;   Digital Research documentation.
                           64 | ;
                           65 | ;   4.  The setting and resetting of the MSB of FCB byte
                           66 | ;   14. The bit is set when the file is opened, and when
                           67 | ;   each extent is opened. It is reset when a sector is
                           68 | ;   is written, or when the random read/write parameters
                           69 | ;   are set up. This may be some sort of flag to prevent
                           70 | ;   trying to read a write file. More digging into this
                           71 | ;   is required.
                           72 | ;
                           73 | ;   5.  The reason for FCB Byte 13 being skipped during
                           74 | ;   a directory file name search. The Digital Reasearch
                           75 | ;   documentation merely says that the byte is for int-
                           76 | ;   ernal use only, and that it is always set to 00H.
                           77 | ;   Does  the skipping of this byte mean that it is used
                           78 | ;   for some purpose in MP/M, or is this something reser-
                           79 | ;   ved for future use in a subsequent release?
                           80 | ;
                           81 | ;   EQUATES
                           82 | ;
                           83 | REBOOT: EQU 0000H   ;REBOOT CP/M VIA VECTOR @ 0000H
                           84 | IOBYTE: EQU 0003H   ;I/O ALLOCATION BYTE
                           85 | DDMA:   EQU 0080H   ;DEFAULT DMA ADDRESS
                           86 | SECLEN: EQU 0080H   ;STANDARD CP/M SECTOR LENGTH= 128
                           87 | ;
                           88 | CR: EQU 0DH ;CARRIAGE RETURN
                           89 | LF: EQU 0AH ;LINE FEED
                           90 | TAB:    EQU 09H ;TAB
                           91 | BCKSPA: EQU 08H ;BACKSPACE
                           92 | RUBOUT: EQU 7FH ;DELETE
                           93 | ;
                           94 | VER:    EQU 2   ;CP/M VERSION
                           95 | REL:    EQU 2   ;CP/M RELEASE
                           96 | REV:    EQU 0   ;REVISION
                           97 | SNH:    EQU 00  ;SERIAL NUMBER, HIGH. 2 DIGITS
                           98 | SNL:    EQU 0000    ;SERIAL  NUMBER, LOW. 4 DIGITS
                           99 | ;
                          100 | ;
                          101 |     .INCLUDE    "MEMCONF.DEF"
                            1 | MSIZE   EQU     64     ;SIZE OF CP/M SYSTEM IN KB
                            2 | BIAS    EQU (MSIZE-20)*1024
                            3 | CCP EQU 3400H+BIAS
                            4 | BDOS    EQU CCP+0806H
                            5 | BIOS    EQU CCP+1600H
                          102 | ;
                          103 |     ORG BDOS-6  ;BDOS BASE. FIRST 5 BYTES CONTAIN SERIAL NUMBER AND VERSION
                          104 | ;
                          105 | ;
EC00: 00                  106 | SERNO:  DB  SNH ;HIGH DIGITS OF SERIAL NUMBER
EC01: 16                  107 |     DB  VER*10+REL  ;


Assembly Listing                                                                                                 Page: 3
------------------------------------------------------------------------------------------------------------------------

EC02: 00 00               108 |     DW  REV ;
EC04: 00 00               109 |     DB  SNL/256,SNL MOD 256 ;
                          110 | ;
                          111 | ;   NOTE:
                          112 | ;       The user must insert the proper serial numbers
                          113 | ;       into BDOS since these numbers are checked by
                          114 | ;       MOVECPM when creating a new system, and by
                          115 | ;       CCP every time a transient program is loaded.
                          116 | ;       Failure to have matching serial numbers will
                          117 | ;       cause an error condition.
                          118 | ;
                          119 | ;   MAIN BDOS ENTRY POINT.
                          120 | ;   ALL CALL ARE ROUTED THROUGH HERE BY
                          121 | ;   VECTOR LOCATED AT 0005H
                          122 | ;
                          123 |     ORG BDOS    ;THIS IS WHERE BDOS FUNCTIONS ARE CALLED
EC06: C3 11 EC            124 |     JMP BDOS1   ;JUMP OVER ERROR VECTORS TO START
                          125 | ;
                          126 | ;   ERROR HANDLER VECTORS
                          127 | ;
EC09: 99 EC               128 | ERR1:   DW  BSERR   ;<BAD   SECTOR   ERROR>
EC0B: A5 EC               129 | ERR2:   DW  SELER1  ;<DISK  SELECT   ERROR>
EC0D: AB EC               130 | ERR3:   DW  ROERR   ;<DISK READ ONLY ERROR>
EC0F: B1 EC               131 | ERR4:   DW  ROERR1  ;<FILE READ ONLY ERROR>
                          132 | ;
                          133 | ;   STARTING POINT OF BASIC DISK OPERATING SYSTEM
                          134 | ;
EC11: EB                  135 | BDOS1:  XCHG        ;
EC12: 22 43 EF            136 |     SHLD    ENTPAR  ;SAVE ENTRY PARAMETER FROM (DE)
EC15: EB                  137 |     XCHG        ;
EC16: 7B                  138 |     MOV A,E ;
EC17: 32 D6 F9            139 |     STA PARAM1  ;ALSO SAVE CONTENTS OF (E)
EC1A: 21 00 00            140 |     LXI H,0000  ;
EC1D: 22 45 EF            141 |     SHLD    RETPAR  ;ZERO OUT RETURN PARAMETER
EC20: 39                  142 |     DAD SP  ;
EC21: 22 0F EF            143 |     SHLD    PSTACK  ;SAVE CALLING PROGRAM STACK POINTER
EC24: 31 00 00            144 |     LXI SP,BSTACK   ;SET UP BDOS STACK
EC27: AF                  145 |     XRA A   ;
EC28: 32 E0 F9            146 |     STA DISKNO  ;ZERO OUT DISK NUMBER
EC2B: 32 DE F9            147 |     STA SETUPF  ; & DISK SETUP FLAG
EC2E: 21 74 F9            148 |     LXI H,BDOS2 ;PUT EXIT POINT ADDRESS UP FOR
EC31: E5                  149 |     PUSH    H   ; USE WHEN COMMAND IS COMPLETED
EC32: 79                  150 |     MOV A,C ;MOVE COMMAND NUMBER INTO (A)
EC33: FE 29               151 |     CPI 29H ;CHECK FOR VALID COMMAND NUMBER
EC35: D0                  152 |     RNC     ;NO GOOD- THERE ARE ONLY 40 COMMANDS
EC36: 4B                  153 |     MOV C,E ;
EC37: 21 47 EC            154 |     LXI H,COMTAB    ;POINT TO START OF COMMAND TABLE
EC3A: 5F                  155 |     MOV E,A ;
EC3B: 16 00               156 |     MVI D,00H   ;
EC3D: 19                  157 |     DAD D   ;
EC3E: 19                  158 |     DAD D   ;POINT TO COMMAND VECTOR
EC3F: 5E                  159 |     MOV E,M ;
EC40: 23                  160 |     INX H   ;
EC41: 56                  161 |     MOV D,M ;MOVE COMMAND VECTOR INTO (DE)
EC42: 2A 43 EF            162 |     LHLD    ENTPAR  ;GET BACK ORIGINAL ENTRY CONTENTS OF (DE)
EC45: EB                  163 |     XCHG        ;SWAP 'EM


Assembly Listing                                                                                                 Page: 4
------------------------------------------------------------------------------------------------------------------------

EC46: E9                  164 |     PCHL        ;THEN GO OFF TO DO THE COMMAND
                          165 | ;
                          166 | ;   BDOS COMMAND VECTOR TABLE
                          167 | ;
                          168 | ;   Contains vectors for 40 commands, including two
                          169 | ;   reserved spaces for future commands, and two
                          170 | ;   undocumented commands. Commands marked '*' are
                          171 | ;   different from the similarly numbered commands
                          172 | ;   in CP/M 1.4
                          173 | ;
EC47: 03 FA               174 | COMTAB: DW  WBOOT   ;   BIOS CALL/WARM BOOT
EC49: C8 EE               175 |     DW  COM01   ;   CONSOLE INPUT
EC4B: 90 ED               176 |     DW  COM02   ;   CONSOLE OUTPUT
EC4D: CE EE               177 |     DW  COM03   ;   TAPE READER INPUT
EC4F: 12 FA               178 |     DW  PUNCH   ;   BIOS CALL/PUNCH DEVICE OUTPUT
EC51: 0F FA               179 |     DW  LIST    ;   BIOS CALL/LIST DEVICE OUTPUT
EC53: D4 EE               180 |     DW  COM06   ;*  DIRECT CONSOLE I/O
EC55: ED EE               181 |     DW  COM07   ;   GET I/O BYTE
EC57: F3 EE               182 |     DW  COM08   ;   SET I/O BYTE
EC59: F8 EE               183 |     DW  COM09   ;   PRINT STRING
EC5B: E1 ED               184 |     DW  COM10   ;*  READ CONSOLE BUFFER
EC5D: FE EE               185 |     DW  COM11   ;   GET CONSOLE STATUS
EC5F: 7E F8               186 |     DW  COM12   ;*  RETURN VERSION NUMBER
EC61: 83 F8               187 |     DW  COM13   ;   RESET DISK SYSTEM
EC63: 45 F8               188 |     DW  COM14   ;   SELECT DISK DRIVE
EC65: 9C F8               189 |     DW  COM15   ;*  OPEN FILE
EC67: A5 F8               190 |     DW  COM16   ;   CLOSE FILE
EC69: AB F8               191 |     DW  COM17   ;*  SEARCH FOR FIRST OCCURENCE
EC6B: C8 F8               192 |     DW  COM18   ;   SEARCH FOR NEXT OCCURENCE
EC6D: D7 F8               193 |     DW  COM19   ;*  DELETE FILE
EC6F: E0 F8               194 |     DW  COM20   ;   READ SEQUENTIAL FILE
EC71: E6 F8               195 |     DW  COM21   ;   WRITE SEQUENTIAL FILE
EC73: EC F8               196 |     DW  COM22   ;*  MAKE FILE
EC75: F5 F8               197 |     DW  COM23   ;*  RENAME FILE
EC77: FE F8               198 |     DW  COM24   ;   RETURN LOG-IN VECTOR
EC79: 04 F9               199 |     DW  COM25   ;   RETURN CURRENT DISK NUMBER
EC7B: 0A F9               200 |     DW  COM26   ;   GET DMA ADDRESS
EC7D: 11 F9               201 |     DW  COM27   ;   INTEROGATE DISK ALLOCATION
EC7F: 2C F1               202 |     DW  COM28   ;*  WRITE PROTECT DISK
EC81: 17 F9               203 |     DW  COM29   ;*  GET R/O VECTOR ADDRESS
EC83: 1D F9               204 |     DW  COM30   ;*  SET FILE ATTRIBUTES
EC85: 26 F9               205 |     DW  COM31   ;*  GET DISK PARAMETER ADDRESS
EC87: 2D F9               206 |     DW  COM32   ;*  SET USER/GET USER NUMBER
EC89: 41 F9               207 |     DW  COM33   ;*  READ RANDOM FILE
EC8B: 47 F9               208 |     DW  COM34   ;*  WRITE RANDOM FILE
EC8D: 4D F9               209 |     DW  COM35   ;*  COMPUTE FILE SIZE
EC8F: 0E F8               210 |     DW  COM36   ;*  SET RAMDOM RECORD LENGTH
EC91: 53 F9               211 |     DW  COM37   ;** UNDOCUMENTED COMMAND
EC93: 04 EF               212 |     DW  DUMMY   ;** RESERVED FOR FUTURE USE
EC95: 04 EF               213 |     DW  DUMMY   ;** RESERVED FOR FUTURE USE
EC97: 9B F9               214 |     DW  COM40   ;** UNDOCUMENTED COMMAND
                          215 | ;
                          216 | ;   BDOS ERROR HANDLING ROUTINES
                          217 | ;
EC99: 21 CA EC            218 | BSERR:  LXI H,ERMSG2    ;<BAD SECTOR ERROR>
EC9C: CD E5 EC            219 |     CALL    ERRMSG  ;


Assembly Listing                                                                                                 Page: 5
------------------------------------------------------------------------------------------------------------------------

EC9F: FE 03               220 |     CPI 03H ;CHECK FOR A CONTROL C
ECA1: CA 00 00            221 |     JZ  REBOOT  ;
ECA4: C9                  222 |     RET     ;
                          223 | ;
                          224 | ;   NOTE:
                          225 | ;       There should be some change made to this
                          226 | ;       piece of code because when you have tried
                          227 | ;       to select a non-existent drive, you will
                          228 | ;       reboot and immediately try to select that
                          229 | ;       drive. This gives an error message and a
                          230 | ;       reboot which reselects the drive........
                          231 | ;
ECA5: 21 D5 EC            232 | SELER1: LXI H,ERMSG3    ;<DISK SELECT ERROR>
ECA8: C3 B4 EC            233 |     JMP ROERR2  ;
                          234 | ;
ECAB: 21 00 00            235 | ROERR:  LXI H,ERMSG5    ;<DISK READ ONLY ERROR>
ECAE: C3 B4 EC            236 |     JMP ROERR2  ;
                          237 | ;
ECB1: 21 DC EC            238 | ROERR1: LXI H,ERMSG4    ;<FILE READ ONLY ERROR>
ECB4: CD E5 EC            239 | ROERR2: CALL    ERRMSG  ;
ECB7: C3 00 00            240 |     JMP REBOOT  ;
                          241 | ;
                          242 | ;   ERROR MESSAGE STRINGS
                          243 | ;
ECBA: 42 64 6F 73 20...   244 | ERMSG0: DB  'Bdos Err On  : $'
                          245 | ERMSG1: EQU ERMSG0+12   ;
                          246 | ;
ECCA: 42 61 64 20 53...   247 | ERMSG2: DB  'Bad Sector$'   ;
                          248 | ;
ECD5: 53 65 6C 65 63...   249 | ERMSG3: DB  'Select$'   ;
                          250 | ;
ECDC: 46 69 6C 65 20...   251 | ERMSG4: DB  'File R/O$' ;
                          252 | ERMSG5: EQU ERMSG4+5    ;
                          253 | ;
                          254 | ;   PRINT OUT THE ERROR MESSAGE
                          255 | ;
ECE5: E5                  256 | ERRMSG: PUSH    H   ;SAVE THE POINTER
ECE6: CD C9 ED            257 |     CALL    PCRLF   ;START A NEW LINE
ECE9: 3A 42 EF            258 |     LDA CURDSK  ;GET THE CURRENT DISK NUMBER
ECEC: C6 41               259 |     ADI 'A' ;ADD THE ASCII BIAS+1
ECEE: 32 C6 EC            260 |     STA ERMSG1  ;POKE INTO ERROR MESSAGE
ECF1: 01 BA EC            261 |     LXI B,ERMSG0    ;POINT TO ERROR MESSAGE
ECF4: CD D3 ED            262 |     CALL    PRNSTR  ;PRINT ERROR MESSAGE STRING
ECF7: C1                  263 |     POP B   ;GET BACK ORIGINAL POINTER
ECF8: CD D3 ED            264 |     CALL    PRNSTR  ;  AND PRINT THAT STRING TOO.
                          265 | ;
                          266 | ;   CONSOLE KEYBOARD INPUT
                          267 | ;
ECFB: 21 0E EF            268 | INPUT:  LXI H,KYBDFL    ;SWAP THE CONTENTS OF THE KEYBOARD FLAG BYTE
ECFE: 7E                  269 |     MOV A,M ;WITH A 00
ECFF: 36 00               270 |     MVI M,00H   ;
ED01: B7                  271 |     ORA A   ;
ED02: C0                  272 |     RNZ     ;RETURN IF SOMETHING ALREADY THERE
ED03: C3 09 FA            273 |     JMP CONIN   ;ELSE GET SOMETHING VIA A BIOS CALL  TO CONSOLE INPUT
                          274 | ;
ED06: CD FB EC            275 | INCHR:  CALL    INPUT   ;GET A CHARACTER FROM KEYBOARD


Assembly Listing                                                                                                 Page: 6
------------------------------------------------------------------------------------------------------------------------

ED09: CD 14 ED            276 |     CALL    SETFLG  ;CHECK TO SEE IF IS A COTROL CHARACTER
ED0C: D8                  277 |     RC      ;RETURN IF IT IS
ED0D: F5                  278 |     PUSH    PSW ;ELSE ECHO IT TO THE CONSOLE
ED0E: 4F                  279 |     MOV C,A ; (AND PERHAPS THE LIST DEVICE)
ED0F: CD 90 ED            280 |     CALL    COM02   ;CONSOLE OUTPUT
ED12: F1                  281 |     POP PSW ;
ED13: C9                  282 |     RET     ;
                          283 | ;
                          284 | ;   SET THE CARRY FLAG IF A CONTROL CHARACTER OTHER THAN
                          285 | ;   CR, LF, TAB OR BACKSPACE IS ENCOUNTERED
                          286 | ;
ED14: FE 0D               287 | SETFLG: CPI CR  ;
ED16: C8                  288 |     RZ      ;
ED17: FE 0A               289 |     CPI LF  ;
ED19: C8                  290 |     RZ      ;
ED1A: FE 09               291 |     CPI TAB ;
ED1C: C8                  292 |     RZ      ;
ED1D: FE 08               293 |     CPI BCKSPA  ;
ED1F: C8                  294 |     RZ      ;
ED20: FE 20               295 |     CPI ' ' ;
ED22: C9                  296 |     RET     ;
                          297 | ;
                          298 | ;   CHECK TO KEYBOARD STATUS TO SEE IF THERE IS
                          299 | ;   SOMETHING TO REPORT
                          300 | ;
ED23: 3A 0E EF            301 | KBSTAT: LDA KYBDFL  ;CHECK THE FLAG
ED26: B7                  302 |     ORA A   ;
ED27: C2 45 ED            303 |     JNZ KBSTA2  ;SOMETHING ALREADY ON HAND
                          304 | ;
ED2A: CD 06 FA            305 |     CALL    CONST   ;BIOS CALL/CONSOLE STATUS
ED2D: E6 01               306 |     ANI 01H ;CHECK LSB ONLY
ED2F: C8                  307 |     RZ      ;NOTHING, SO JUST RETURN
                          308 | ;
ED30: CD 09 FA            309 |     CALL    CONIN   ;BIOS CALL/CONSOLE INPUT
ED33: FE 13               310 |     CPI 13H ;CHECK FOR A CONTROL S
ED35: C2 42 ED            311 |     JNZ KBSTA1  ;EXIT ON CONTROL S
ED38: CD 09 FA            312 |     CALL    CONIN   ;BIOS CALL/CONSOLE INPUT
ED3B: FE 03               313 |     CPI 03H ;CHECK AGAIN FOR A CONTROL C
ED3D: CA 00 00            314 |     JZ  REBOOT  ;REBOOT IF THE IS ^C
ED40: AF                  315 |     XRA A   ; ELSE CLEAR THE EVIDENCE
ED41: C9                  316 |     RET     ;  AND EXIT
                          317 | ;
ED42: 32 0E EF            318 | KBSTA1: STA KYBDFL  ;MARK THE FLAG 'IN USE'
ED45: 3E 01               319 | KBSTA2: MVI A,01H   ; SET RETURN BYTE
ED47: C9                  320 |     RET     ;
                          321 | ;
                          322 | ;   OUTPUT ONE CHARACTER TO THE CONSOLE OUTPUT DEVICE
                          323 | ;   (AND TO THE LIST DEVICE IF THE ^P FLAG IS SET)
                          324 | ;
                          325 | ;   CHARACTER TO BE OUTPUT IS RECEIVED IN (C)
                          326 | ;
ED48: 3A 0A EF            327 | OUTPUT: LDA CHCTR1  ;
ED4B: B7                  328 |     ORA A   ;
ED4C: C2 62 ED            329 |     JNZ OUTPT1  ;
ED4F: C5                  330 |     PUSH    B   ;
ED50: CD 23 ED            331 |     CALL    KBSTAT  ;


Assembly Listing                                                                                                 Page: 7
------------------------------------------------------------------------------------------------------------------------

ED53: C1                  332 |     POP B   ;
ED54: C5                  333 |     PUSH    B   ;
ED55: CD 0C FA            334 |     CALL    CONOUT  ;BIOS CALL/CONSOLE OUTPUT
ED58: C1                  335 |     POP B   ;
ED59: C5                  336 |     PUSH    B   ;
ED5A: 3A 0D EF            337 |     LDA LISTFL  ;CHECK TO SEE IF LIST DEVICE IS SET
ED5D: B7                  338 |     ORA A   ;
ED5E: C4 0F FA            339 |     CNZ LIST    ; IT IS SO DO A BIOS CALL TO LIST DEVICE OUTPUT
ED61: C1                  340 |     POP B   ;
ED62: 79                  341 | OUTPT1: MOV A,C ;
ED63: 21 0C EF            342 |     LXI H,CHRCTR    ;
ED66: FE 7F               343 |     CPI RUBOUT  ;DON'T COUNT RUBOUTS
ED68: C8                  344 |     RZ      ;
ED69: 34                  345 |     INR M   ;BUMP CHARACTER COUNTER
ED6A: FE 20               346 |     CPI ' ' ;
ED6C: D0                  347 |     RNC     ;OK- IT WAS A PRINTABLE CHARACTER
ED6D: 35                  348 |     DCR M   ;UNDO WHAT YOU JUST DID
ED6E: 7E                  349 |     MOV A,M ;** SUPERFLOUS CODE!
ED6F: B7                  350 |     ORA A   ;** SET FLAG LIKE IT WAS SET BY DCR M
ED70: C8                  351 |     RZ      ;
ED71: 79                  352 |     MOV A,C ;
ED72: FE 08               353 |     CPI BCKSPA  ;CHECK FOR A BACKSPACE
ED74: C2 79 ED            354 |     JNZ OUTPT2  ;
ED77: 35                  355 |     DCR M   ;DECREASE COUNTER IF BACKSPACE
ED78: C9                  356 |     RET     ;
                          357 | ;
ED79: FE 0A               358 | OUTPT2: CPI LF  ;ZERO OUT CHARACTER COUNTER IF
ED7B: C0                  359 |     RNZ     ;A LINE FEED IS FOUND, ELSE JUST
ED7C: 36 00               360 |     MVI M,00H   ;RETURN TO CALLER
ED7E: C9                  361 |     RET     ;
                          362 | ;
                          363 | ;   CHARACTER OUTPUT
                          364 | ;
                          365 | ;   CHARACTER TO BE PRINTED RECEIVED IN (C)
                          366 | ;
                          367 | ;   PRINTS CONTROL CHARACTERS AS ^[LETTER]
                          368 | ;   EXPANDS TABS TO 8 BYTE BOUNDARIES
                          369 | ;
ED7F: 79                  370 | OUTCHR: MOV A,C ;
ED80: CD 14 ED            371 |     CALL    SETFLG  ;
ED83: D2 90 ED            372 |     JNC COM02   ; NOT A CONTROL CHAR SO JUST DO CONSOLE OUTPUT
ED86: F5                  373 |     PUSH    PSW ;STASH THE CHARACTER
ED87: 0E 5E               374 |     MVI C,'^'   ;PRINT AN UP-ARROW
ED89: CD 48 ED            375 |     CALL    OUTPUT  ;
ED8C: F1                  376 |     POP PSW ;GET CHARACTER BACK
ED8D: F6 40               377 |     ORI 40H ;REPLACE ASCII BIAS
ED8F: 4F                  378 |     MOV C,A ;
ED90: 79                  379 | COM02:  MOV A,C ;CONSOLE OUTPUT
ED91: FE 09               380 |     CPI TAB ;
ED93: C2 48 ED            381 |     JNZ OUTPUT  ;NOT A TAB, JUST OUTPUT
ED96: 0E 20               382 | OUTCH2: MVI C,' '   ; IT WAS A TAB, SPACE TO NEXT 8 BYTE STOP.
ED98: CD 48 ED            383 |     CALL    OUTPUT  ;
ED9B: 3A 0C EF            384 |     LDA CHRCTR  ;CHECK THE COUNTER
ED9E: E6 07               385 |     ANI 07H ;
EDA0: C2 96 ED            386 |     JNZ OUTCH2  ;NOT AT EVEN LOCATION, DO ANOTHER
EDA3: C9                  387 |     RET     ;


