                         2819 | ;   HERE WE HAVE THE WAY THAT DISKS ARE LOGGED,
                         2820 | ;   AND A MISERABLE AND TANGLED BIT OF CODE IT IS.
                         2821 | ;   WE START HERE,  THEN JUMP TO LOGIN1 WHICH THEN
                         2822 | ;   FINISHES UP THE REST OF THE JOB.
                         2823 | ;   WHY THE HECK ISN'T THIS THING WRITTEN IN A
                         2824 | ;   STRAIGHT LINE? ANYBODY FOR STRUCTURED CODE??
                         2825 | ;
F821: 2A AF F9           2826 | LOGIN:  LHLD    LOGVEC  ;LOG IN VECTOR
F824: 3A 42 EF           2827 |     LDA CURDSK  ;
F827: 4F                 2828 |     MOV C,A ;
F828: CD EA F0           2829 |     CALL    SHRHLC  ;SHIFT (HL) RIGHT PER COUNT IN (C)
F82B: E5                 2830 |     PUSH    H   ;
F82C: EB                 2831 |     XCHG        ;
F82D: CD 59 EF           2832 |     CALL    SETDSK  ;SET UP DISK PARAMETERS
F830: E1                 2833 |     POP H   ;
F831: CC 47 EF           2834 |     CZ  SELERR  ;DISK SELECT ERROR
F834: 7D                 2835 |     MOV A,L ;LOG IN BIT IN LSB(A)
F835: 1F                 2836 |     RAR     ;CHECK TO SEE IF ON MAP
F836: D8                 2837 |     RC      ;OK- DISK ALREADY LOGGED IN
F837: 2A AF F9           2838 |     LHLD    LOGVEC  ;LOG IN VECTOR
F83A: 4D                 2839 |     MOV C,L ;
F83B: 44                 2840 |     MOV B,H ;
F83C: CD 0B F1           2841 |     CALL    SETVEC  ;NEW DISK- PUT ON THE MAP
F83F: 22 AF F9           2842 |     SHLD    LOGVEC  ;LOG IN VECTOR
F842: C3 A3 F2           2843 |     JMP LOG1N1  ;--SEE COMMENTS AT START--
                         2844 | ;
                         2845 | ;   BDOS COMMAND #14....SELECT DISK DRIVE
                         2846 | ;
                         2847 | ;   NOW IF THIS BLOCK OF CODE WERE TO BE MOVED
                         2848 | ;   AHEAD OF LOGIN, IT COULD JUST DROP IN WITHOUT
                         2849 | ;   A JUMP. COUPLED WITH THE COMMENTS ON LOGIN,
                         2850 | ;   WE CAN SEE WHY THIS CODE IS SO HARD TO FOLLOW.
                         2851 | ;


