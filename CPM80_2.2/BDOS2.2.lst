                         2691 | ;
                         2692 | ;   COMPUTE ABSOLUTE SECTOR NUMBER FOR FSIZE & COM36
                         2693 | ;
                         2694 | ;ENTRY PARAMETERS:
                         2695 | ;       WHEN CALLED  BY FSIZE
                         2696 | ;       (HL)= POINTER TO CURRENT ENTRY IN DIRECTORY
                         2697 | ;             BUFFER.
                         2698 | ;       (DE)= 15. OFFSET TO DIRECTORY RECORD COUNTER
                         2699 | ;
                         2700 | ;       WHEN CALLED BY COM36
                         2701 | ;       (HL)= POINTER TO  FCB, I.E. (ENTPAR)
                         2702 | ;       (DE)= 32. OFFSET TO RANDOM READ/WRITE COUNTER
                         2703 | ;
                         2704 | ;ON EXIT:
                         2705 | ;       REGISTERS A,B & C HOLD TRIPLE PRECISION SECTOR
                         2706 | ;       NUMBER IN THE FOLLOWING FORMAT:
                         2707 | ;           (C) LOW ORDER BYTE
                         2708 | ;           (B) HIGH ORDER BYTE
                         2709 | ;           (A) OVERFLOW
                         2710 | ;
                         2711 | ;   (A) (B) (C) <-- (BYTE14).AND.0FH*2^12+(BYTE12).AND.1FH*2^7+(BYTE32)or(BYTE15)
                         2712 | ;
