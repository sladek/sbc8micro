                         2846 | ;   AHEAD OF LOGIN, IT COULD JUST DROP IN WITHOUT
                         2847 | ;   A JUMP. COUPLED WITH THE COMMENTS ON LOGIN,
                         2848 | ;   WE CAN SEE WHY THIS CODE IS SO HARD TO FOLLOW.
                         2849 | ;
F850: 3A E1 F9           2850 | COM14:  LDA PARAM1  ;GET THE SELECTED DISK DRIVE NUMBER
F853: 21 42 EF           2851 |     LXI H,CURDSK ;
F856: BE                 2852 |     CMP M   ;COMPARE TO CURRENT DISK NUMBER
F857: C8                 2853 |     RZ      ;RETURN IF NO CHANGE NEEDED
F858: 77                 2854 |     MOV M,A ;ELSE SET (CURDSK) TO NEW DRIVE
F859: C3 2C F8           2855 |     JMP LOGIN   ; AND GO LOG IT IN
                         2856 | ;
                         2857 | ;   SET UP THE DISK PARAMETERS
                         2858 | ;
                         2859 | ;   ALL BDOS COMMANDS THAT USE THE DISKS MUST
                         2860 | ;   MAKE A PASS THROUGH THIS SUBROUTINE
                         2861 | ;
                         2862 | ;   NOTE:
                         2863 | ;       THE DIGITAL RESEARCH DOCUMENTATION DOES
                         2864 | ;       NOT MENTION WHAT IS DONE WITH THE USER
                         2865 | ;       NUMBER. WELL HERE IT IS.....
                         2866 | ;       THE USER NUMBER IS PUT INTO THE FIRST
                         2867 | ;       BYTE OF THE DIRECTORY ENTRY. USER 0
                         2868 | ;       IS THEREFORE COMPATIBLE WITH CP/M 1.4
                         2869 | ;       BUT HIGHER USER NUMBERS ARE NOT.
                         2870 | ;       TRY CREATING A DUMMY FILE WITH VARIOUS
                         2871 | ;       USER NUMBERS, THEN INSPECTING THE
                         2872 | ;       DIRECTORY TRACK WITH SPAT.
                         2873 | ;       THIS PIECE OF CODE PUTS THE CURRENT
                         2874 | ;       USER NUMBER INTO THE START OF THE
                         2875 | ;       FILE CONTROL BLOCK SO THAT A MATCH CAN
                         2876 | ;       BE MADE DURING DIRECTORY SEARCHES.
                         2877 | ;
F85C: 3E FF              2878 | SETUP:  MVI A,0FFH  ;SET FLAG TO TELL BDOS2 THAT
F85E: 32 E9 F9           2879 |     STA SETUPF  ;  THE DISKS HAVE BEEN USED
F861: 2A 43 EF           2880 |     LHLD    ENTPAR  ;(HL) <-- ENTRY PARAMETER
F864: 7E                 2881 |     MOV A,M ;GET THE DISK NUMBER FROM FCB
F865: E6 1F              2882 |     ANI 1FH ;DISK NUMBER TO BE IN RANGE OF
                         2883 |             ;0 TO 1FH. I.E. DRIVES A THROUGH P
F867: 3D                 2884 |     DCR A   ;
F868: 32 E1 F9           2885 |     STA PARAM1  ;STORE IT FOR SELDSK
F86B: FE 1E              2886 |     CPI 1EH ;
F86D: D2 80 F8           2887 |     JNC SETUP1  ;SKIP OVER- ACCESSING LOGGED IN DISK
                         2888 | ;
F870: 3A 42 EF           2889 |     LDA CURDSK  ;SAVE CURRENT DISK NUMBER IN
F873: 32 EA F9           2890 |     STA LOGDSK  ;LOGDSK FOR RESTORING ON EXIT
F876: 7E                 2891 |     MOV A,M ;GET DISK NUMBER FROM FCB AGAIN
F877: 32 EB F9           2892 |     STA DISKNO  ;SAVE IT
                         2893 | ;
                         2894 | ;   THE REASON FOR SETTING THE UPPER 3 BITS OF
                         2895 | ;   (FCB+12) WITH THE UPPER 3 BITS OF THE DRIVE
                         2896 | ;   NUMBER BROUGHT IN IN THE ENTRY PARAMETER IS
                         2897 | ;   NOT DOCUMENTED. THIS MAY BE SOME SORT OF
                         2898 | ;   PASSWORD SECURITY SYSTEM
                         2899 | ;
F87A: E6 E0              2900 |     ANI 0E0H    ;KEEP UPPER 3 BITS
F87C: 77                 2901 |     MOV M,A ; AND PUT THEM BACK IN FCB


