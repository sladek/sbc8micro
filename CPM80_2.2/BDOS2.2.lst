                         1956 | ;   SEARCHES FOR FIRST UNUSED 1K BLOCK IN THE ALLOCATION
                         1957 | ;   ALLOCATION MAP
                         1958 | ;
                         1959 | ;   ENTRY PARAMETERS:(BC)   CURRENT BLOCK NUMBER OR 0000H
                         1960 | ;               (SEE NOTE BELOW)
                         1961 | ;   EXIT PARAMETERS: (HL)   NUMBER OF NEXT FREE BLOCK OR
                         1962 | ;               0000H IF NO BLOCK AVAILABLE
                         1963 | ;
                         1964 | ;   NOTE:
                         1965 | ;       SEARCH STARTS AT BLOCK 0000H FOR FIRST ALLOC-
                         1966 | ;       ATION FOR A NEW DIRECTORY EXTENT, OR FROM THE
                         1967 | ;       CURRENT BLOCK NUMBER FOR SUBSEQUENT ALLOCATIONS
                         1968 | ;       THIS SAVES TIME SINCE IT ASSUMES THAT ALL
                         1969 | ;       BLOCKS UP TO THE CURRENT ONE HAVE BEEN USED.
                         1970 | ;       THIS MAY CAUSE AN 'OUT OF DISK SPACE' ERROR
                         1971 | ;       IF OTHER FILES ARE BEING DELETED WHILE THIS
                         1972 | ;       ONE IS BEING WRITTEN. A REMOTE, BUT REAL,
                         1973 | ;       POSSIBILITY.
                         1974 | ;
F3BE: 50                 1975 | WRSUB:  MOV D,B ;
F3BF: 59                 1976 |     MOV E,C ;(DE) <-- (BC)
F3C0: 79                 1977 | WRSUB1: MOV A,C ;
