# Set cpu to Intel 8080
cpu 8080
# Set serial port to COM3 and default setting 9600,8,n,1
ser 0xf4 com3
# Instantiate User Defined Device
rdr_pun 0xf0
# Instantiate disk controller and mount disks.
# If disk images don't exist they are created and formated
# Don't mark nonexisting disk you want to mount as [RO].
# Make sure that Read Only [ro] disks already exists and they are formated
# or it wil be created, but cannot be formated as it is labeled [ro] 
# fdhdc disk controller supports 2 floppy disks and 2 hard disks
fdhdc 0x78  disks/disk_cpm_hdd.dsk[ro] disks/disk_b.dsk disks/hdd_c.dsk disks/hdd_d.dsk
# fdc disk controller supports only 4 floppy disks
# and it is suitable for small projects where project data can be isolated on smaller disks
# fdc 0x78  disks/disk_cpm_hdd.dsk[ro] disk_b.dsk disk_c.dsk disk_tmp.dsk
# Load BIOS
lh CPM80_2.2/CBIOS.hex
# Load CCP and BDOS loader
lh CPM80_2.2/GETSYS.hex
# Insert some empty cycles. Normally it runs faster than original cpu
# so adding some 'empty cycles' can slow it down. 
# This is basically desirable when playing some original game like LADDER 
# so the LAD is not moving fast.
#ec 0x03
# Start loader and go to CPM
# g command will react to CTRL-C in GUI, but the execution is slower
# as it checks the GUI events during the execution of every instruction.
# But it can be very usefull mainly when troubleshooting 
g 0x100
# Run 
#run 0x100
